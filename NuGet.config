<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for Gadfly (GAD-T63).

    1. lib/local-packages/ (relative to this file): git-tracked copies of the private MindAttic.* packages
       Gadfly references (Legion, Vault, Log, Authentication). A GitHub runner has no C:\LocalNuGet, so the
       Azure deploy restores them from here.
    2. C:\LocalNuGet: the dev-box feed (missing in CI; the workflow restores with ignore-failed-sources).
    3. nuget.org: everything else.

  When you bump a MindAttic package, copy the new .nupkg from C:\LocalNuGet into lib/local-packages/ and update
  the PackageReference.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="./lib/local-packages" />
    <add key="local" value="C:\LocalNuGet" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gadfly.Tour (GAD-T105): the end-to-end demo tour. Starts (or targets) a real Gadfly.Server, seeds the demo
       institution, then drives the whole workflow over HTTP and the SessionHub as real users and asserts each
       stage against the API and the database. See docs/TOUR.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gadfly.Tour</RootNamespace>
    <AssemblyName>Gadfly.Tour</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- Lift the transitive System.Security.Cryptography.Pkcs past GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx (as Gadfly.Server does). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>

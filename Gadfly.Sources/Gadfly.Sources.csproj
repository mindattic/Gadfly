<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gadfly.Sources: instructor source material for the Socratic engine (docs/SOCRATIC_PLATFORM.md):
       ingest documents into chunks, build the concept map and rubric, retrieve grounding. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gadfly.Sources</RootNamespace>
    <AssemblyName>Gadfly.Sources</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <PackageId>Gadfly.Sources</PackageId>
    <Title>Gadfly.Sources</Title>
    <Authors>MindAttic</Authors>
    <Company>MindAttic</Company>
    <Description>Source material for the Gadfly Socratic engine: document ingestion and chunking, Legion-built concept maps and rubrics, and hybrid grounding retrieval.</Description>
    <PackageTags>mindattic;gadfly;socratic;rag;rubric</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 MindAttic</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/mindattic/Gadfly</RepositoryUrl>
    <PackageProjectUrl>https://github.com/mindattic/Gadfly</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gadfly\Gadfly.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDF, DOCX, EPUB and HTML parsers (GAD-T155); the feed copy is in lib/local-packages for CI. -->
    <PackageReference Include="Tutor.Ingestion" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gadfly.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Tutor.Ingestion's OCR data arrives as a content file of the reference; consumers get it from Tutor.Ingestion itself,
       so it must not be repacked into this package (4 MB). -->
  <Target Name="DropRepackedOcrData" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <Content Remove="@(Content)" Condition="'%(Filename)%(Extension)' == 'eng.traineddata'" />
    </ItemGroup>
  </Target>

</Project>

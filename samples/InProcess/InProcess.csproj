<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gadfly sample (GAD-T168): an outside application using the Socratic engine IN PROCESS.
       Gadfly.Core and Gadfly.Sources are referenced as PACKAGES (PackageReference), exactly as a third-party app
       would, not as ProjectReferences. They restore from lib/local-packages (git-tracked copies, see the root
       NuGet.config) or C:\LocalNuGet. After changing the engine, bump the version, `dotnet pack` both projects and
       copy the .nupkg files there. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Gadfly.Core" Version="1.0.0" />
    <PackageReference Include="Gadfly.Sources" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="multiplication.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Gadfly.Server: the hosted Socratic platform (docs/SOCRATIC_PLATFORM.md). One deployable that
       will carry the SQL data layer, the SessionHub, the platform API and (from GAD-T48) the
       Blazor Server exam app. EF Core on SQL Server: LocalDB in development, Azure SQL later. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Gadfly.Server</RootNamespace>
    <AssemblyName>Gadfly.Server</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UserSecretsId>gadfly-server-6f1d2c3a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gadfly\Gadfly.csproj" />
    <ProjectReference Include="..\Gadfly.Sources\Gadfly.Sources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MindAttic.Vault" Version="7.0.0" />
    <PackageReference Include="MindAttic.Log" Version="3.0.0" />
    <PackageReference Include="MindAttic.Authentication" Version="9.0.0" />
    <!-- Voice exam room (GAD-T53): streaming speech-to-text relay and the talking-head avatar's TTS hub. -->
    <PackageReference Include="MindAttic.SpeechRecognition.AspNetCore" Version="1.0.0" />
    <PackageReference Include="MindAttic.Avatar.AspNetCore" Version="1.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.AzureAppServices" Version="10.0.15" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.3" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.8" />
    <!-- Lift the transitive System.Security.Cryptography.Pkcs 9.0.4 (from the SqlClient chain) past
         GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Demo and classroom source notes, used by the demo and classroom seeders (GAD-T103, GAD-T151). -->
    <None Include="Demo\Material\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The in-app help center (GAD-T292): every file under docs/guides is embedded in the app as "Gadfly.Help/<path>", so the
       published app (tools/deploy-azure.ps1 publishes a git-archive export of the repository) always carries the guides of the
       commit it was built from. HelpLibrary reads, renders and indexes them at startup. -->
  <ItemGroup>
    <EmbeddedResource Include="..\docs\guides\**\*" LogicalName="Gadfly.Help/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" Visible="false" />
  </ItemGroup>

  <!-- The default examiner avatar (mpfb.glb, CC0, 36.8 MB) is not committed: it is copied from the MindAttic.Avatar checkout next to
       this repo when present (a dev box). Without it (CI) the exam room shows the 2D portrait; in production host the model on
       blob storage or a CDN and set Gadfly:Voice:AvatarModelUrl. See tools/sync-voice-assets.ps1 (GAD-T53). -->
  <PropertyGroup>
    <MindAtticAvatarRoot Condition="'$(MindAtticAvatarRoot)' == ''">$(MSBuildThisFileDirectory)..\..\MindAttic.Avatar</MindAtticAvatarRoot>
  </PropertyGroup>
  <Target Name="CopyAvatarModel" BeforeTargets="BeforeBuild;BeforePublish"
          Condition="Exists('$(MindAtticAvatarRoot)\web\assets\avatars\mpfb.glb') And !Exists('$(MSBuildThisFileDirectory)wwwroot\assets\avatars\mpfb.glb')">
    <Copy SourceFiles="$(MindAtticAvatarRoot)\web\assets\avatars\mpfb.glb" DestinationFolder="$(MSBuildThisFileDirectory)wwwroot\assets\avatars" />
  </Target>

</Project>

@using Microsoft.AspNetCore.Components.Endpoints
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Gadfly Exams · @AppVersion.Label</title>
    <link rel="stylesheet" href="app.css" />
    @* The mock-mode banner's styles (GAD-T507): linked here, not from the banner's own HeadContent, because Blazor keeps only
       one HeadContent per page and a page's stylesheet link replaced the banner's, leaving it unstyled in the app shell. *@
    <link rel="stylesheet" href="demo.css" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    @* Import map for the voice exam room's talking head (three.js, TalkingHead, MindAttic.Avatar), GAD-T53. Always present because
       Blazor navigates between pages without reloading the head. Carries the CSP nonce on the sign-in pages that send one. *@
    <script type="importmap" nonce="@CspNonce">{"imports":{"three":"/lib/voice/three/build/three.module.js","three/addons/":"/lib/voice/three/examples/jsm/","@@met4citizen/talkinghead":"/lib/voice/talkinghead/modules/talkinghead.mjs","@@mindattic/avatar":"/lib/voice/avatar/index.js"}}</script>
    <HeadOutlet @rendermode="PageRenderMode" />
    @* The version ends every tab title (GAD-T291): each page's own <PageTitle> gets " · V<N>" appended here, also after
       Blazor or an enhanced navigation sets a new title, so no page has to remember it. *@
    <script nonce="@CspNonce">(function(){var s=" · @AppVersion.Label";function f(){var t=document.title;if(t&&t.slice(-s.length)!==s)document.title=t+s;}f();new MutationObserver(f).observe(document.head,{subtree:true,childList:true,characterData:true});})();</script>
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    @* A dropped connection shows a clear status instead of a frozen or blank page (GAD-T306): Blazor toggles this
       element's class as the connection is lost, retries and comes back (app.css styles each state). The button
       retries once; if that fails, or the circuit is gone for good (the server restarted), it reloads the page,
       which every live page recovers from by re-syncing to the server's current state. *@
    <div id="components-reconnect-modal" class="components-reconnect-hide">
        <div class="reconnect-box" role="alert">
            <p class="reconnect-message"></p>
            <button type="button" class="reconnect-retry">Try again</button>
        </div>
    </div>
    <script nonce="@CspNonce">(function(){var m=document.getElementById("components-reconnect-modal");if(!m)return;var b=m.querySelector(".reconnect-retry");if(b)b.addEventListener("click",function(){if(window.Blazor&&typeof window.Blazor.reconnect==="function")window.Blazor.reconnect().then(function(ok){if(!ok)location.reload();});else location.reload();});new MutationObserver(function(){if(m.classList.contains("components-reconnect-rejected"))setTimeout(function(){location.reload();},1500);}).observe(m,{attributes:true,attributeFilter:["class"]});})();</script>
    <script src="js/scroll-regions.js" nonce="@CspNonce" defer></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // Interactive Server everywhere EXCEPT pages marked [ExcludeFromInteractiveRouting] (the sign-in
    // pages), which render static SSR so the library's antiforgery form POSTs validate.
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private string? CspNonce => HttpContext.Items[MindAttic.Authentication.Web.MindAtticAuthAppExtensions.CspNonceItem] as string;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}

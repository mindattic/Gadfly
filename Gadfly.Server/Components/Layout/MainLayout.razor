@inherits LayoutComponentBase
@inject ITenantContext Tenant
@inject IServiceScopeFactory Scopes
@inject IConfiguration Config
@inject NavigationManager Nav
@inject Gadfly.Server.Localization.UiText T
@implements IDisposable

<div class="shell">
    @* Keyboard reach (GAD-T365): the first focusable thing in the app, so Tab from the address bar reaches the page
       content without walking through the whole top bar and admin sub-nav first. Mirrors the public site's (GAD-T308). *@
    <a class="skip" href="#content">@T["layout.skip"]</a>
    <Gadfly.Server.Components.Shared.MockBanner />
    <header class="topbar">
        <a class="brand" href="/">Gadfly <span>Exams</span></a>
        <span class="app-version" title="Deployed version (GAD-T291)">@AppVersion.Label</span>
        <AuthorizeView>
            <Authorized>
                <nav class="nav">
                    @{ var desk = Gadfly.Server.Desk.DeskAccess.IsDeskAdmin(context.User, Tenant, Config); }
                    @if (OrgAdmin)
                    {
                        @* Owners and admins get one Admin entry; every admin page is in the admin navigation below the top bar (GAD-T300). *@
                        <a href="admin" class="@(InAdminArea ? "active" : null)" aria-current="@(InAdminArea ? "page" : null)">Admin</a>
                    }
                    else
                    {
                        @if (desk)
                        {
                            <NavLink href="admin/desk">Admin desk</NavLink>
                        }
                        @StaffLinks
                    }
                    @if (Tenant.Role == OrgRoles.Student)
                    {
                        <NavLink href="my-exams">@T["layout.myExams"]</NavLink>
                    }
                    @if (Tenant.IsSuperAdmin)
                    {
                        <NavLink href="platform/organizations">Organizations</NavLink>
                    }
                </nav>
                <div class="who">
                    @if (Tenant.Memberships.Count > 1)
                    {
                        <form method="post" action="/org/switch" class="org-switch" data-enhance="false">
                            <AntiforgeryToken />
                            <select name="organizationId" onchange="this.form.submit()" aria-label="Organization">
                                @foreach (var m in orgNames)
                                {
                                    <option value="@m.Id" selected="@(m.Id == Tenant.OrganizationId)">@m.Name (@m.Role)</option>
                                }
                            </select>
                        </form>
                    }
                    else if (orgNames.Count == 1)
                    {
                        <span class="org">@orgNames[0].Name · @orgNames[0].Role</span>
                    }
                    <span class="user">@context.User.Identity?.Name</span>
                    <form method="post" action="/_ma-auth/logout" data-enhance="false">
                        <AntiforgeryToken />
                        <button type="submit" class="link">@T["layout.signOut"]</button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
        @* Help is open to everyone, signed in or not (GAD-T292). *@
        @if (Tenant.Role == OrgRoles.Student && !InExamRoom)
        {
            @* Students choose their UI language (GAD-T543); in the exam room the attempt's own language rules, so it isn't offered there. *@
            <LanguageSwitch />
        }
        <a class="nav-help" href="help">@T["layout.help"]</a>
    </header>
    <main id="content" tabindex="-1">
        @if (OrgAdmin && InAdminArea)
        {
            <Gadfly.Server.Components.Pages.Admin.AdminNav FromLayout="true" />
        }
        @Body
    </main>
</div>

@code {
    private List<(Guid Id, string Name, string Role)> orgNames = [];

    private bool InExamRoom => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("exam/", StringComparison.OrdinalIgnoreCase);

    // A page that switches the UI language live (get-ready, GAD-T546) re-renders the top bar with it.
    protected override void OnInitialized() => T.Changed += OnLanguageChanged;
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => T.Changed -= OnLanguageChanged;

    private bool OrgAdmin => Gadfly.Server.Admin.AdminArea.IsOrgAdmin(Tenant.Role);
    private bool InAdminArea => Gadfly.Server.Admin.AdminArea.Contains(Nav.ToBaseRelativePath(Nav.Uri));

    /// <summary>The staff screens (sources, assessments, review, analytics, grading, members) by role.</summary>
    private RenderFragment StaffLinks => @<text>
        @if (Tenant.Role is OrgRoles.Owner or OrgRoles.Admin or OrgRoles.Instructor)
        {
            <NavLink href="sources">Source material</NavLink>
            <NavLink href="assessments">Assessments</NavLink>
            <NavLink href="review">Review</NavLink>
            <NavLink href="analytics">Analytics</NavLink>
        }
        @if (Tenant.Role is OrgRoles.Owner or OrgRoles.Admin or OrgRoles.Instructor or OrgRoles.Examiner or OrgRoles.SecondReviewer)
        {
            <NavLink href="grading">Grading</NavLink>
        }
        @if (Tenant.Role is OrgRoles.Owner or OrgRoles.Admin)
        {
            <NavLink href="org/members">Members</NavLink>
        }
    </text>;

    protected override async Task OnInitializedAsync()
    {
        // Its own scope: the page below shares the circuit's DbContext and may be querying it right now.
        if (Tenant.UserId is { } uid)
        {
            using var scope = Scopes.CreateScopeFor(TenantSnapshot.Of(Tenant));
            var directory = scope.ServiceProvider.GetRequiredService<IOrganizationDirectory>();
            orgNames = (await directory.MembershipsOfAsync(uid)).Select(m => (m.Org.Id, m.Org.Name, m.Role)).ToList();
        }
    }
}

@inject IJSRuntime JS

@* The students who have opened a published exam, with their terms and accommodations (GAD-T50). Every published exam is open
   to every student (GAD-T845), so there is nothing to assign here. Hosted by ExamBuilder. *@

<h2>Students</h2>
<p class="hint">Every published exam is open to every student; a student appears here once they open it. To set a closing date, attempts, extra time or another accommodation before a student starts, use <a href="admin/assignments">Student terms</a>.</p>
@if (rows is null)
{
    <p class="hint" role="status">Loading…</p>
}
else if (rows.Count == 0)
{
    <p class="hint">No student has opened this exam yet.</p>
}
else
{
    <p class="hint"><a href="@($"grading/exam/{ExamId:D}/class-summary.pdf")" download data-enhance-nav="false">Download class summary (PDF)</a>: score distribution, per-objective average and who hasn't completed, over this exam's released results.</p>
    <div class="table-scroll">
    <table class="grid">
        <thead><tr><th scope="col">Student</th><th scope="col">Window</th><th scope="col">Attempts</th><th scope="col">Extra time</th><th scope="col">Answers</th><th scope="col">Eye contact</th><th scope="col">Leaving the window</th><th scope="col">Lives in EU/EEA</th><th scope="col">Latest session</th><th scope="col">Results</th></tr></thead>
        <tbody>
            @foreach (var r in rows)
            {
                <tr>
                    <td>@r.StudentName</td>
                    <td>@Window(r)</td>
                    <td>@r.AttemptsUsed / @r.AttemptsAllowed</td>
                    <td>@MultiplierLabel(r.TimeMultiplier)</td>
                    <td>
                        @(r.TypedAnswerAccommodation ? "typed (accommodation)" : "spoken")
                        @if (CanAdjust)
                        {
                            <button type="button" class="link" disabled="@busy" @onclick="() => TypedAnswersAsync(r, !r.TypedAnswerAccommodation)">@(r.TypedAnswerAccommodation ? "Withdraw" : "Grant typed answers")</button>
                        }
                    </td>
                    <td>
                        @(r.GazeAccommodation ? "not expected (accommodation)" : "expected")
                        @if (CanAdjust)
                        {
                            <button type="button" class="link" disabled="@busy" @onclick="() => GazeAccommodationAsync(r, !r.GazeAccommodation)">@(r.GazeAccommodation ? "Withdraw" : "Declare accommodation")</button>
                        }
                    </td>
                    <td>
                        @{ var wa = r.WindowAbsence ?? Gadfly.Server.Integrity.WindowAbsenceRule.Standard; }
                        @if (CanAdjust)
                        {
                            <select aria-label="When leaving the exam window marks @r.StudentName's attempt for review" disabled="@busy" value="@WindowPreset(wa)"
                                    @onchange="e => WindowAbsenceAsync(r, e.Value?.ToString())">
                                @foreach (var (key, label, _, _, _) in WindowPresets)
                                {
                                    <option value="@key">@label</option>
                                }
                                @if (WindowPreset(wa) == "custom") { <option value="custom">@wa.Describe()</option> }
                            </select>
                        }
                        else
                        {
                            <span>@(wa.IsStandard ? "standard" : wa.Describe())</span>
                        }
                    </td>
                    <td title="GAD-T259: by default a student living in the EU/EEA gets no voice measurements in voice exams (EU AI Act Art. 5(1)(f)).">
                        @(r.StudentInEuropeanUnion ? "yes (voice not measured by default)" : "no")
                        @if (CanAdjust)
                        {
                            <button type="button" class="link" disabled="@busy" @onclick="() => StudentInEuAsync(r, !r.StudentInEuropeanUnion)">@(r.StudentInEuropeanUnion ? "Unmark" : "Mark as EU/EEA")</button>
                        }
                    </td>
                    <td>@(r.LatestState is { } st ? StateLabel(st) + (r.LatestEndedAt is { } end ? $" {Local(end)}" : "") : "not started")</td>
                    <td>
                        @if (r.ResultsReleasedAt is { } rel)
                        {
                            <span class="hint">released @Local(rel) (before grading moved to Grading)</span>
                        }
                        else if (r.LatestEndedAt is not null)
                        {
                            <a href="grading">Grade and publish in Grading</a>
                        }
                        else
                        {
                            <span class="hint">No finished attempt yet</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <p class="hint">Answers: exams are spoken. Grant typed answers only to a student with a documented speech, hearing or anxiety need: they then type each answer instead of speaking it. Their camera stays on, the examiner still speaks the questions and the eye-contact check still applies (unless you also declare the eye-contact accommodation). Their typed answers are marked as typed for reviewers, and pasting into the answer box is noted for review. Students can't turn this on themselves; every grant and withdrawal is recorded in the audit log. It applies the next time the student opens the exam.</p>
    <p class="hint">Eye contact: in the voice interview, a long look away from the examiner while answering brings gentle reminders: her head tilt, a slight dim around her that clears at once, then at most one warm line at a pause. Declare the accommodation for a student who should not be held to eye contact (for example autism, low vision, nystagmus or a cultural norm): none of these happen. It applies from their next answer.</p>
    <p class="hint">Leaving the window: the exam pauses whenever a student leaves the exam window, and three absences or one of a minute mark the attempt for your review (nothing is cancelled). For a student whose assistive technology takes the focus, or who has a documented need to step away, raise the thresholds or turn the review mark off. Absences are still noted and the exam still pauses. Every change is recorded in the audit log and applies from the next absence.</p>
    <p class="hint">Results reach a student only through Grading: AI and human grades, reconciliation when they disagree, then an authorized approval and publication.</p>
    @if (!CanAdjust && message is not null)
    {
        <p role="status" class="@(ok ? "ok" : "error")">@message</p>
    }
}

@code {
    [Parameter, EditorRequired] public ExamService Service { get; set; } = default!;
    [Parameter, EditorRequired] public Guid ExamId { get; set; }
    [Parameter] public bool CanAdjust { get; set; }
    /// <summary>The builder's gate over the circuit's DbContext (one operation at a time); loads and assigns wait on it (GAD-T189).</summary>
    [Parameter] public SemaphoreSlim? Gate { get; set; }

    private Guid loadedFor;
    private bool loadedCanAdjust;

    private IReadOnlyList<AssignmentRow>? rows;
    private TimeSpan offset = TimeSpan.Zero;
    /// <summary>The browser's own time zone; null until known (then <see cref="offset"/>, today's UTC offset, stands in).</summary>
    private TimeZoneInfo? zone;
    private string? message;
    private bool ok, busy;

    protected override async Task OnParametersSetAsync()
    {
        // Every parent re-render sets the parameters again: reload only for a different exam or when changes become possible,
        // never on each render (that overlapped the parent's own saves on the shared DbContext).
        if (loadedFor == ExamId && (loadedCanAdjust || !CanAdjust)) return;
        loadedFor = ExamId;
        loadedCanAdjust = CanAdjust;
        await LoadLockedAsync();
    }

    private async Task LoadLockedAsync()
    {
        if (Gate is { } g) await g.WaitAsync();
        try { await LoadAsync(); }
        finally { Gate?.Release(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            // getTimezoneOffset is minutes behind UTC (positive west of Greenwich).
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/exams.js");
            var minutes = await module.InvokeAsync<int>("timezoneOffsetMinutes");
            offset = TimeSpan.FromMinutes(-minutes);
            zone = AssignmentTime.Find(await module.InvokeAsync<string?>("timeZoneId"));
            if (zone is not null) offset = zone.GetUtcOffset(DateTimeOffset.UtcNow);
            StateHasChanged();
        }
        catch (JSException)
        {
            // Keep UTC.
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone.
        }
    }

    private async Task LoadAsync()
    {
        rows = await Service.AssignmentsAsync(ExamId);
    }

    private async Task TypedAnswersAsync(AssignmentRow row, bool on)
    {
        if (busy) return;   // one operation at a time on the shared DbContext (GAD-T189)
        if (on && !await JS.InvokeAsync<bool>("confirm",
                $"Let {row.StudentName} type their answers instead of speaking them? Only for a documented speech, hearing or anxiety need. The camera, the spoken questions and the eye-contact check stay on. This is recorded in the audit log.")) return;
        busy = true;
        try
        {
            ExamResult r;
            if (Gate is { } g) await g.WaitAsync();
            try { r = await Service.SetTypedAnswerAccommodationAsync(row.Id, on); }
            finally { Gate?.Release(); }
            ok = r.Ok;
            message = r.Ok ? $"{row.StudentName}: {r.Message}" : r.Message;
            await LoadLockedAsync();
        }
        finally { busy = false; }
    }

    /// <summary>The window-absence accommodation's choices (GAD-T604): key, label, off, absences, seconds.</summary>
    private static readonly (string Key, string Label, bool Off, int? Count, int? Seconds)[] WindowPresets =
    [
        ("standard", "standard (3 absences or 1 min)", false, null, null),
        ("raised", "raised (6 absences or 5 min)", false, 6, 300),
        ("high", "raised (10 absences or 15 min)", false, 10, 900),
        ("off", "never marks for review", true, null, null),
    ];

    private static string WindowPreset(Gadfly.Server.Integrity.WindowAbsenceRule rule)
    {
        if (rule.Off) return "off";
        foreach (var p in WindowPresets)
            if (!p.Off && rule == Gadfly.Server.Integrity.WindowAbsenceRule.For(false, p.Count, p.Seconds)) return p.Key;
        return "custom";
    }

    private async Task WindowAbsenceAsync(AssignmentRow row, string? key)
    {
        if (busy) return;   // one operation at a time on the shared DbContext (GAD-T189)
        var preset = WindowPresets.FirstOrDefault(p => p.Key == key);
        if (preset.Key is null) return;
        if (preset.Key != "standard" && !await JS.InvokeAsync<bool>("confirm",
                $"Change when leaving the exam window marks {row.StudentName}'s attempt for review to: {preset.Label}? Use this for assistive technology or a documented need. Absences are still noted, and this is recorded in the audit log.")) { await LoadLockedAsync(); return; }
        busy = true;
        try
        {
            ExamResult r;
            if (Gate is { } g) await g.WaitAsync();
            try { r = await Service.SetWindowAbsenceAccommodationAsync(row.Id, preset.Off, preset.Count, preset.Seconds); }
            finally { Gate?.Release(); }
            ok = r.Ok;
            message = r.Ok ? $"{row.StudentName}: {r.Message}" : r.Message;
            await LoadLockedAsync();
        }
        finally { busy = false; }
    }

    private async Task GazeAccommodationAsync(AssignmentRow row, bool on)
    {
        if (busy) return;   // one operation at a time on the shared DbContext (GAD-T189)
        busy = true;
        try
        {
            ExamResult r;
            if (Gate is { } g) await g.WaitAsync();
            try { r = await Service.SetGazeAccommodationAsync(row.Id, on); }
            finally { Gate?.Release(); }
            ok = r.Ok;
            message = r.Ok ? $"{row.StudentName}: {r.Message}" : r.Message;
            await LoadLockedAsync();
        }
        finally { busy = false; }
    }

    private async Task StudentInEuAsync(AssignmentRow row, bool on)
    {
        if (busy) return;   // one operation at a time on the shared DbContext (GAD-T189)
        busy = true;
        try
        {
            ExamResult r;
            if (Gate is { } g) await g.WaitAsync();
            try { r = await Service.SetStudentInEuropeanUnionAsync(row.Id, on); }
            finally { Gate?.Release(); }
            ok = r.Ok;
            message = r.Ok ? $"{row.StudentName}: {r.Message}" : r.Message;
            await LoadLockedAsync();
        }
        finally { busy = false; }
    }


    private string Local(DateTimeOffset t) => AssignmentTime.ToLocal(t, zone, offset).ToString("yyyy-MM-dd HH:mm");

    private string Window(AssignmentRow r) => (r.OpensAt, r.ClosesAt) switch
    {
        (null, null) => "any time",
        ({ } o, null) => $"from {Local(o)}",
        (null, { } c) => $"until {Local(c)}",
        ({ } o, { } c) => $"{Local(o)} – {Local(c)}",
    };

    private static string MultiplierLabel(decimal m) =>
        m == 1m ? "none" : m.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "x";

    private static string StateLabel(SessionState s) => s switch
    {
        SessionState.Created => "opened",
        SessionState.ConsentGiven => "consented",
        SessionState.Running => "in progress",
        SessionState.Paused => "paused",
        SessionState.Ended => "ended",
        _ => "failed",
    };
}

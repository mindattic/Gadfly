@page "/forgot-password"
@page "/account/reset"
@using MindAttic.Authentication.Components
@inject NavigationManager Nav
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout

@* Password reset (GAD-T70), rendered static SSR so the library's antiforgery POSTs validate.
   /forgot-password asks for a reset link (posts to /_ma-auth/reset/request, which always answers the
   same way and redirects to /login?reset=sent). /account/reset is the library's default ResetPath:
   the emailed link lands here with ?token=, and a rejected token or password comes back with ?error=1. *@
<PageTitle>Reset your password · Gadfly Exams</PageTitle>
<section class="auth-card" aria-labelledby="reset-heading">
    @if (Path == "forgot-password")
    {
        <h1 id="reset-heading">Forgot your password?</h1>
        <p class="subtitle">Enter your username or email. If an account matches, we'll email you a link to choose a new password.</p>
        <MaForgotPassword />
    }
    else if (string.IsNullOrWhiteSpace(Token))
    {
        <h1 id="reset-heading">Reset your password</h1>
        <p role="alert">This reset link is incomplete. Open the link from your email again, or <a href="forgot-password">ask for a new one</a>.</p>
    }
    else
    {
        <h1 id="reset-heading">Choose a new password</h1>
        <p class="subtitle">Use at least 12 characters. You'll sign in with it afterwards.</p>
        <MaResetPassword Token="@Token" Error="@(Error == 1)" />
        @if (Error == 1)
        {
            <p>If the link has expired, <a href="forgot-password">ask for a new one</a>.</p>
        }
    }
    <p><a href="login">Back to sign in</a></p>
</section>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public int Error { get; set; }

    private string Path => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
}

@page "/"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout Gadfly.Server.Components.Pages.Site.HomeLayout
@* Signed out: the public landing page in the site layout; signed in: the dashboard in the app shell (GAD-T308). Static
   rendering, so a visitor at "/" never opens a Blazor circuit. *@
@inject ITenantContext Tenant
@inject NavigationManager Nav
@inject IAuthorizationService Authz

<PageTitle>Gadfly Exams</PageTitle>

@if (!signedIn)
{
    <Gadfly.Server.Components.Pages.Site.Landing />
}
else if (toDashboard)
{
    <p class="hint">Opening your dashboard…</p>
}
else if (Tenant.OrganizationId is null && !Tenant.IsSuperAdmin)
{
    <h1>Welcome</h1>
    <p class="notice">Your account isn't a member of any organization yet. Ask your organization's administrator to add you.</p>
}
else
{
    <h1>@Greeting</h1>
    <div class="cards">
        <AuthorizeView Policy="@Gadfly.Server.Desk.DeskAccess.Policy">
            <a class="card" href="admin/desk"><h2>Admin desk</h2><p>Exams, students and who sits what: create, assign, and reset an attempt in one click.</p></a>
        </AuthorizeView>
        @if (Tenant.Role is OrgRoles.Owner or OrgRoles.Admin or OrgRoles.Instructor)
        {
            <a class="card" href="sources"><h2>Source material</h2><p>Upload what students learn from; review the concepts and rubrics built from it.</p></a>
            <a class="card" href="exams"><h2>Exams</h2><p>Build an oral exam from your concepts and assign it.</p></a>
            <a class="card" href="review"><h2>Review</h2><p>Read each session, its evidence and integrity notes, and decide the grade.</p></a>
        }
        @if (Tenant.Role is OrgRoles.Owner or OrgRoles.Admin)
        {
            <a class="card" href="admin"><h2>Dashboard</h2><p>What needs attention today, and the last 7 and 30 days in numbers.</p></a>
            <a class="card" href="org/members"><h2>Members</h2><p>Add instructors and students.</p></a>
        }
        @if (Tenant.Role == OrgRoles.Student)
        {
            <a class="card" href="my-exams"><h2>My exams</h2><p>Take an assigned exam and see released results.</p></a>
        }
        @if (Tenant.IsSuperAdmin)
        {
            <a class="card" href="platform/organizations"><h2>Organizations</h2><p>MindAttic: create customer organizations and their owners.</p></a>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool toDashboard, signedIn;

    private string Greeting => Tenant.Role switch
    {
        OrgRoles.Student => "Your exams",
        null => "MindAttic platform",
        _ => "Your organization",
    };

    /// <summary>
    /// Owners and admins land on the dashboard (GAD-T300). Only when they may actually open it: an owner whose sign-in
    /// lacks the second step stays here with the cards rather than being sent to a page that refuses them.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        signedIn = user.Identity?.IsAuthenticated == true;
        if (!signedIn || !Gadfly.Server.Admin.AdminArea.IsOrgAdmin(Tenant.Role)) return;
        if (!(await Authz.AuthorizeAsync(user, GadflyPolicies.OrgAdmin)).Succeeded) return;
        toDashboard = true;
        Nav.NavigateTo("admin", replace: true);
    }
}

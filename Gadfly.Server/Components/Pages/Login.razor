@page "/login"
@using MindAttic.Authentication.Components
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout

<PageTitle>Sign in · Gadfly Exams</PageTitle>

<section class="auth-card" aria-labelledby="login-heading">
    <h1 id="login-heading">Gadfly <span>Exams</span></h1>
    <p class="subtitle">Show what you understand, in your own words.</p>
    @if (Reset == "sent")
    {
        <p role="status">If an account matches, we've emailed a password-reset link.</p>
    }
    else if (Reset == "ok")
    {
        <p role="status">Your password was reset. Sign in with the new password.</p>
    }
    else if (Invite == "ok")
    {
        <p role="status">Your invitation was accepted. Sign in to continue.</p>
    }
    <MaLogin ReturnUrl="@ReturnUrl" Error="@(Error == 1)" />
    <p><a href="forgot-password">Forgot password?</a></p>
    <p class="hint">Trouble with your microphone, camera or browser, or want to know how the exam works? <a href="help">Help</a> is open without signing in.</p>
</section>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public int Error { get; set; }
    [SupplyParameterFromQuery] public string? Reset { get; set; }
    [SupplyParameterFromQuery] public string? Invite { get; set; }
}

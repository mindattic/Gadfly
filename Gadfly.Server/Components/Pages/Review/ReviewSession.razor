@page "/review/{SessionId:guid}"
@attribute [Authorize(Policy = GadflyPolicies.Instructor)]
@using Gadfly.Server.Data
@using Gadfly.Server.Review
@inject GadflyDbContext Db
@inject ITenantContext Tenant

<PageTitle>Session review · Gadfly Exams</PageTitle>
<HeadContent><link rel="stylesheet" href="review.css" /></HeadContent>
<p class="hint"><a href="review">← All sessions</a></p>

@if (loading)
{
    <p class="hint">Loading…</p>
}
else if (view is null)
{
    <h1>Session not found</h1>
    <p class="notice">This session doesn't exist in the current organization.</p>
}
else
{
    var s = view.Session;
    <h1>@view.StudentName <span>· @view.ExamTitle · attempt @s.Attempt</span></h1>

    <div class="review-summary">
        <div><span class="hint">State</span> @s.State@(s.EndReason is { } er ? $" ({er})" : "")</div>
        <div><span class="hint">Started</span> @(s.StartedAt?.ToLocalTime().ToString("g") ?? "—")</div>
        <div><span class="hint">Ended</span> @(s.EndedAt?.ToLocalTime().ToString("g") ?? "—")</div>
        <div><span class="hint">AI recommendation</span>
            @if (view.Report is { } rep) { <span class="tag rec-@rep.Recommendation">@rep.Recommendation</span> @Pct(rep.OverallScore) }
            else { <span>none yet</span> }
        </div>
        <div><span class="hint">Grading</span> <a href="grading/@s.Id">open the grading workspace</a></div>
        <div><span class="hint">Exports</span>
            <a href="@ReviewExportEndpoints.CsvPath(s.Id)" download target="_blank" data-enhance-nav="false">turns (CSV)</a> ·
            <a href="@ReviewExportEndpoints.MarkdownPath(s.Id)" download target="_blank" data-enhance-nav="false">report (Markdown)</a>
            <span class="hint">· PDF export comes later</span>
        </div>
    </div>

    @if (view.JudgesDisagreed > 0)
    {
        <p class="notice warn">The judging panel disagreed on @view.JudgesDisagreed answer@(view.JudgesDisagreed == 1 ? "" : "s"). Those answers are marked below; please read them before grading.</p>
    }

    var integrity = IntegritySummary.From(view.Integrity, view.Turns);
    <section class="integrity-summary level-@integrity.Level" aria-labelledby="integrity-heading">
        <h2 id="integrity-heading" class="section">Integrity summary</h2>
        <p>@integrity.Headline</p>
        @if (integrity.Lines.Count > 0)
        {
            <table class="grid">
                <thead><tr><th>Signal</th><th>Source</th><th>Times</th><th>Total time</th><th>Turns</th><th>What it means</th></tr></thead>
                <tbody>
                    @foreach (var l in integrity.Lines)
                    {
                        <tr>
                            <td>@l.Label</td>
                            <td>@l.Source</td>
                            <td>@l.Count</td>
                            <td>@IntegritySummary.Duration(l.TotalDuration)</td>
                            <td>@(l.Turns.Count == 0 ? "—" : string.Join(", ", l.Turns))</td>
                            <td>@l.Explanation</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (integrity.Normal.Count > 0)
        {
            <p class="hint">Normal behavior, not counted: @string.Join("; ", integrity.Normal.Select(n => $"{n.Label} ({n.Count}×)")). Looking away while thinking is expected.</p>
        }
        <p class="hint">Each signal also appears on the timeline below, next to the answer it happened during. The grade is your decision; no signal fails a student automatically.</p>
    </section>

    <h2 class="section">Timeline</h2>
    @if (view.Timeline.Count == 0)
    {
        <p class="notice">No questions were asked in this session yet.</p>
    }
    <ol class="timeline">
        @foreach (var item in view.Timeline)
        {
            if (item.Turn is { } t)
            {
                <li class="turn @(t.Judgment?.NeedsHumanReview == true ? "disputed" : "")" id="turn-@t.Index">
                    <div class="turn-head">
                        <strong>Q@(t.Index + 1)</strong>
                        <span class="tag">@t.Move</span>
                        <span>@t.ConceptTitle</span>
                        <span class="hint">@t.AskedAt.ToLocalTime().ToString("T")</span>
                    </div>
                    @if (t.Judgment?.NeedsHumanReview == true)
                    {
                        <p class="banner">Judges disagreed — review this answer.</p>
                    }
                    <p class="question">@t.Question</p>
                    @if (!string.IsNullOrWhiteSpace(t.PlannerReason))
                    {
                        <p class="hint">Why this question: @t.PlannerReason</p>
                    }
                    @if (t.AnswerText is { } answer)
                    {
                        <blockquote class="answer">@answer</blockquote>
                        <p class="hint">
                            @(t.AnswerMode ?? "answer")
                            @if (t.LatencySeconds is { } lat) { <text> · started after @lat.ToString("0.#") s</text> }
                            @if (t.AnswerCompletedAt is { } done) { <text> · finished @done.ToLocalTime().ToString("T")</text> }
                            @if (t.HasAudio) { <text> · audio recorded (playback arrives with media storage)</text> }
                            @foreach (var m in t.SpeechMetrics.Take(6)) { <text> · @m.Key @m.Value.ToString("0.##")</text> }
                        </p>
                    }
                    else
                    {
                        <p class="hint">No answer yet.</p>
                    }

                    @foreach (var c in t.Contradictions)
                    {
                        <p class="notice warn">Contradicts an earlier answer: “@c.Quote” vs earlier “@c.EarlierQuote”.</p>
                    }

                    @if (t.Judgment is { } j)
                    {
                        <div class="judgment">
                            <div><strong>Score @Pct(j.OverallScore)</strong> <span class="hint">· panel agreement @Pct(j.Agreement)</span></div>
                            @if (!string.IsNullOrWhiteSpace(j.Summary)) { <p>@j.Summary</p> }
                            @if (j.Criteria.Count > 0)
                            {
                                <table class="grid criteria">
                                    <thead><tr><th>Criterion</th><th>Score</th><th>Why</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in j.Criteria)
                                        {
                                            <tr>
                                                <td>@c.Criterion</td>
                                                <td>@Pct(c.Score)</td>
                                                <td>
                                                    @c.Rationale
                                                    @foreach (var cite in c.Citations)
                                                    {
                                                        <details class="cite">
                                                            <summary>Source@(cite.Document is { } d ? $": {d}" : "")@(cite.Location is { } loc ? $", {loc}" : "")@(cite.Quote is { Length: > 0 } q ? $" — “{Trim(q, 80)}”" : "")</summary>
                                                            @if (cite.Found)
                                                            {
                                                                <pre class="passage">@cite.Text</pre>
                                                            }
                                                            else
                                                            {
                                                                <p class="hint">That passage is no longer in the source material (chunk @cite.ChunkId).</p>
                                                            }
                                                        </details>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            @if (j.Votes.Count > 0)
                            {
                                <details class="votes" open="@j.NeedsHumanReview">
                                    <summary>Each judge's verdict (@j.Votes.Count)</summary>
                                    <ul>
                                        @foreach (var v in j.Votes)
                                        {
                                            <li class="@(v.Dissents ? "dissent" : "")">
                                                <strong>@v.ProviderId</strong> <span class="hint">@v.Model</span> · @Pct(v.OverallScore)
                                                @if (v.Dissents) { <span class="tag warn">dissents</span> }
                                                <div>@v.Verdict</div>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                            @if (j.TextStyleScore is { } ts)
                            {
                                <p class="hint">Text style @Pct(ts): @IntegrityExplanations.TextStyle(ts) It never affects the score.</p>
                            }
                        </div>
                    }
                    @if (t.MasteryAfter is { } ma)
                    {
                        <p class="hint">Mastery of @t.ConceptTitle after this answer: @Pct(ma)</p>
                    }
                    @foreach (var e in item.DuringTurn)
                    {
                        <IntegrityNote Event="e" />
                    }
                </li>
            }
            else if (item.Event is { } ev)
            {
                <li class="event"><IntegrityNote Event="ev" /></li>
            }
        }
    </ol>

    <p class="hint">
        Integrity events are evidence for you to weigh, never findings: the platform doesn't infer dishonesty or emotion
        and never fails anyone on its own. Looking up or away while answering is a normal sign of thinking.
    </p>

    @if (view.Mastery.Count > 0)
    {
        <h2 class="section">Mastery by concept</h2>
        <table class="grid">
            <thead><tr><th>Concept</th><th>Mastery</th><th>Questions</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var m in view.Mastery)
                {
                    <tr>
                        <td>@m.ConceptTitle</td>
                        <td><span class="bar" style="--v:@((int)Math.Round(m.Estimate * 100))%"></span> @Pct(m.Estimate)</td>
                        <td>@m.Turns</td>
                        <td>@m.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2 class="section">AI report</h2>
    @if (view.Report is { } report)
    {
        <div class="report">@((MarkupString)SimpleMarkdown.ToHtml(report.Markdown))</div>
    }
    else
    {
        <p class="notice">The AI report is written when the session ends.</p>
    }

    <h2 class="section">Grading</h2>
    <div class="panel">
        <p>
            Grading happens in the <a href="grading/@s.Id">grading workspace</a>: the AI grades each learning objective,
            a human examiner grades independently (blind when the policy says so), disagreements are reconciled,
            and an authorized teacher approves and publishes the final grade. Nothing reaches the student without that approval.
        </p>
    </div>

    @if (view.Grades.Count > 0)
    {
        <h2 class="section">Earlier instructor decisions</h2>
        <table class="grid">
            <thead><tr><th>When</th><th>By</th><th>Grade</th><th>Score</th><th>Override</th><th>Comment</th></tr></thead>
            <tbody>
                @foreach (var (g, by) in view.Grades)
                {
                    <tr>
                        <td>@g.DecidedAt.ToLocalTime().ToString("g")</td>
                        <td>@by</td>
                        <td><strong>@g.Grade</strong></td>
                        <td>@(g.Score?.ToString("0.##") ?? "—")</td>
                        <td>@(g.OverridesRecommendation ? "yes" : "no")</td>
                        <td>@g.Comment</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="hint">Decisions recorded before the grading workflow, kept for the record. They are not shown to the student.</p>
    }
}

@code {
    [Parameter] public Guid SessionId { get; set; }

    private SessionReviewView? view;
    private bool loading = true;

    private ReviewService Service => new(Db, Tenant.OrganizationId!.Value);

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        view = await Service.GetAsync(SessionId);
        loading = false;
    }

    private static string Pct(double? v) => v is { } x ? $"{x * 100:0}%" : "—";
    private static string Trim(string s, int max) => s.Length <= max ? s : s[..max] + "…";
}

@using Gadfly.Server.Review

@* One integrity event, explained plainly (GAD-T54). Normal behavior (looking away while thinking) is
   shown as such, not as a flag. *@
<div class="integrity @(Event.IsNormalBehavior ? "normal" : "sev-" + Event.Severity.ToString().ToLowerInvariant())">
    <div>
        <strong>@Event.Label</strong>
        <span class="hint">
            @Event.StartedAt.UtcDateTime.ToString("HH:mm:ss")@(Event.EndedAt is { } end ? $"–{end.UtcDateTime:HH:mm:ss} ({Math.Max(0, (end - Event.StartedAt).TotalSeconds):0} s)" : "")
            · @Event.Source
            @if (!Event.IsNormalBehavior) { <text> · @Event.Severity.ToString().ToLowerInvariant() · confidence @($"{Event.Confidence * 100:0}%")</text> }
        </span>
    </div>
    @if (Event.Ongoing)
    {
        <div class="hint" data-ongoing="true">
            @if (Event.SessionOver)
            {
                <text>Still ongoing when the exam ended: the camera checks last reported it at @(Event.EndedAt is { } last ? last.UtcDateTime.ToString("HH:mm:ss") : Event.StartedAt.UtcDateTime.ToString("HH:mm:ss")), and the browser never sent a closing note (the tab may have closed or lost its connection). The end time shown is the last update, not a measured end.</text>
            }
            else
            {
                <text>Still going at the last update (@(Event.EndedAt is { } now ? now.UtcDateTime.ToString("HH:mm:ss") : "just now")); the length shown is so far.</text>
            }
        </div>
    }
    <div>@Event.Explanation</div>
    @if (!string.IsNullOrWhiteSpace(Event.Summary) && Event.Summary != Event.Explanation)
    {
        <div class="hint">@Event.Summary</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IntegrityView Event { get; set; } = default!;
}

@page "/review"
@attribute [Authorize(Policy = GadflyPolicies.Instructor)]
@using Gadfly.Server.Data
@using Gadfly.Server.Review
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant

<PageTitle>Review · Gadfly Exams</PageTitle>
<HeadContent><link rel="stylesheet" href="review.css" /></HeadContent>
<h1>Review <span>sessions to read and grade</span> <HelpLink Topic="instructor-guide" Anchor="6-review-a-session" /></h1>

<div class="review-filters">
    <label>Exam
        <select @bind="ExamFilter" @bind:after="ApplyFiltersAsync">
            <option value="">All exams</option>
            @foreach (var e in exams)
            {
                <option value="@e.Id">@e.Title</option>
            }
        </select>
    </label>
    <label class="check"><input type="checkbox" @bind="needsGrade" @bind:after="ApplyFiltersAsync" /> Needs a grade</label>
    <label class="check"><input type="checkbox" @bind="needsReview" @bind:after="ApplyFiltersAsync" /> Judges disagreed</label>
</div>

@if (rows is null)
{
    <p class="hint" role="status">Loading…</p>
}
else if (rows.Count == 0)
{
    <p class="notice">
        @if (ExamFilter.Length > 0 || needsGrade || needsReview)
        {
            <text>No sessions match these filters.</text>
        }
        else
        {
            <text>No exam sessions yet. Once students sit an exam, their sessions appear here for review and grading.</text>
        }
    </p>
}
else
{
    <table class="grid review-list">
        <thead>
            <tr>
                <th>Student</th><th>Exam</th><th>Attempt</th><th>State</th><th>Ended</th>
                <th>AI recommendation</th><th title="Answers where the judging panel disagreed">Disagreed</th>
                <th title="Integrity flags (normal behavior like looking away is not counted)">Flags</th><th>Grade</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in PagedRows)
            {
                <tr>
                    <td><a href="review/@r.SessionId">@r.StudentName</a></td>
                    <td>@r.ExamTitle</td>
                    <td>@r.Attempt</td>
                    <td>@r.State</td>
                    <td>@(r.EndedAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "—")</td>
                    <td>
                        @if (r.Recommendation is not null)
                        {
                            <span class="tag rec-@r.Recommendation">@r.Recommendation</span>
                            <span class="hint">@Pct(r.AiScore)</span>
                        }
                        else
                        {
                            <span class="hint">—</span>
                        }
                    </td>
                    <td>@if (r.JudgesDisagreed > 0) { <span class="tag warn">@r.JudgesDisagreed</span> } else { <span class="hint">0</span> }</td>
                    <td>@if (r.FlagsHidden) { <span class="hint" title="Hidden until your blind human score is submitted">hidden</span> } else if (r.IntegrityFlags > 0) { <span class="tag warn">@r.IntegrityFlags</span> } else { <span class="hint">0</span> }</td>
                    <td>
                        @if (r.LatestGrade is { } g)
                        {
                            <strong>@g.Grade</strong>
                            @* Blind grading leaves Recommendation null: whether the grade overrode it would reveal the AI's view. *@
                            @if (g.OverridesRecommendation && r.Recommendation is not null) { <span class="hint"> (override)</span> }
                        }
                        else if (r.NeedsGrade)
                        {
                            <span class="tag">needs grade</span>
                        }
                        else
                        {
                            <span class="hint">in progress</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (TotalPages > 1)
    {
        <nav class="pager" aria-label="Pages">
            <button type="button" class="link" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(currentPage - 1)">← Previous</button>
            <span>Page @currentPage of @TotalPages</span>
            <button type="button" class="link" disabled="@(currentPage >= TotalPages)" @onclick="() => GoToPage(currentPage + 1)">Next →</button>
        </nav>
    }
    <p class="hint">@rows.Count session@(rows.Count == 1 ? "" : "s").</p>
}

@code {
    /// <summary>Rows per page (GAD-T390): the list can otherwise render hundreds of rows in one table.</summary>
    private const int RowsPerPage = 50;

    private IReadOnlyList<(Guid Id, string Title)> exams = [];
    private IReadOnlyList<ReviewListRow>? rows;
    private string ExamFilter { get; set; } = "";
    private bool needsGrade, needsReview;
    // Not named with a "page" prefix: a bare "@page..." reference in the markup above is parsed as the @page directive.
    private int currentPage = 1;

    private int TotalPages => rows is null or { Count: 0 } ? 1 : (rows.Count + RowsPerPage - 1) / RowsPerPage;
    private IReadOnlyList<ReviewListRow> PagedRows => rows is null ? [] : rows.Skip((currentPage - 1) * RowsPerPage).Take(RowsPerPage).ToList();

    /// <summary>
    /// Each query runs in its own scope (never the circuit's shared DbContext, which allows one operation at a time), and only the
    /// newest filter's answer is shown: two quick filter changes used to overlap on that context and end the circuit (GAD-T208).
    /// </summary>
    private Task<T> InScopeAsync<T>(Func<ReviewService, Task<T>> work) =>
        Gadfly.Server.Components.Pages.Admin.AdminDb.RunAsync(Scopes, Tenant, (_, db) => work(new ReviewService(db, Tenant.OrganizationId!.Value, viewerRole: Tenant.Role)));

    private int loadSequence;

    protected override async Task OnInitializedAsync()
    {
        exams = await InScopeAsync(s => s.ExamsWithSessionsAsync());
        await LoadAsync();
    }

    /// <summary>A filter changed: back to page 1, since the rows it used to show may no longer match.</summary>
    private Task ApplyFiltersAsync()
    {
        currentPage = 1;
        return LoadAsync();
    }

    private void GoToPage(int n) => currentPage = Math.Clamp(n, 1, TotalPages);

    private async Task LoadAsync()
    {
        var mine = ++loadSequence;
        var filter = new ReviewListFilter(Guid.TryParse(ExamFilter, out var id) ? id : null, needsGrade, needsReview);
        var result = await InScopeAsync(s => s.ListAsync(filter));
        if (mine != loadSequence) return;
        rows = result;
        currentPage = Math.Clamp(currentPage, 1, TotalPages);
    }

    private static string Pct(double? v) => v is { } x ? $"{x * 100:0}%" : "";
}

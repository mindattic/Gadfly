@page "/org/members"
@attribute [Authorize(Policy = GadflyPolicies.OrgAdmin)]
@inject IOrganizationDirectory Directory
@inject ITenantContext Tenant
@using MindAttic.Authentication.Services

<PageTitle>Members · Gadfly Exams</PageTitle>
<h1>Members <HelpLink Topic="admin-guide" Anchor="members-and-roles" /></h1>
<Gadfly.Server.Components.Pages.Admin.AdminNav />

@if (Erased is { } erased)
{
    <p role="status" class="notice">Erased: @erased session record(s) deleted and the membership deactivated.</p>
}

<EditForm Model="invite" OnValidSubmit="InviteAsync" FormName="invite-member" class="panel">
    <h2>Invite by email</h2>
    <label>Email <InputText @bind-Value="invite.Email" type="email" autocomplete="off" /></label>
    <label>Role
        <InputSelect @bind-Value="invite.Role">
            @foreach (var r in InvitableRoles)
            {
                <option value="@r">@r</option>
            }
        </InputSelect>
    </label>
    <p class="hint">They get a single-use link by email (valid for 72 hours) to choose their own password; staff roles then set up two-step verification at first sign-in. Works for people who already have a Gadfly account too: they sign in and accept.</p>
    <button type="submit" disabled="@busy">Send invitation</button>
    @if (inviteMessage is not null)
    {
        <p role="status" class="@(inviteOk ? "ok" : "error")">@inviteMessage</p>
    }
</EditForm>

<EditForm Model="bulk" OnValidSubmit="InviteBulkAsync" FormName="invite-bulk" class="panel">
    <h2>Invite many (CSV)</h2>
    <label>Rows: <code>email</code> or <code>email,role</code>, one per line (a header row is fine)
        <InputTextArea @bind-Value="bulk.Csv" rows="5" autocomplete="off" />
    </label>
    <label>Role for rows without one
        <InputSelect @bind-Value="bulk.DefaultRole">
            @foreach (var r in InvitableRoles)
            {
                <option value="@r">@r</option>
            }
        </InputSelect>
    </label>
    @if (bulkPreview is { } preview && PreviewIsCurrent)
    {
        <div role="alert" class="notice">
            <p>
                @preview.Over.Count of the @preview.Rows.Count invitation@(preview.Rows.Count == 1 ? "" : "s") would exceed the free seats
                (@SeatsFree(preview.FreeStaffSeats, "staff"), @SeatsFree(preview.FreeStudentSeats, "student")).
                They can still be sent, but the people on these rows can't accept until seats free up (remove someone or upgrade the plan):
            </p>
            <ul>
                @foreach (var row in preview.Over)
                {
                    <li>Line @row.Line: @row.Email (@row.Role)</li>
                }
            </ul>
            @if (preview.AlreadyMembers > 0)
            {
                <p class="hint">@preview.AlreadyMembers row@(preview.AlreadyMembers == 1 ? " is" : "s are") already a member and won't be invited.</p>
            }
            <div class="row-actions">
                <button type="button" disabled="@busy" @onclick="SendBulkAnywayAsync">Send all anyway</button>
                <button type="button" class="link" disabled="@busy" @onclick="() => bulkPreview = null">Cancel</button>
            </div>
        </div>
    }
    else
    {
        <button type="submit" disabled="@busy">Send invitations</button>
    }
    @if (bulkResult is not null)
    {
        <p role="status" class="@(bulkResult.Invited == bulkResult.Rows.Count ? "ok" : "error")">@bulkResult.Invited of @bulkResult.Rows.Count invited.</p>
        <ul>
            @foreach (var row in bulkResult.Rows.Where(x => !x.Ok))
            {
                <li class="error">Line @row.Line @row.Email: @row.Message</li>
            }
        </ul>
    }
</EditForm>

@if (invitations.Count > 0)
{
    <table class="grid">
        <thead><tr><th>Invited</th><th>Role</th><th>Status</th><th>Expires</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
            @foreach (var i in invitations)
            {
                <tr>
                    <td>@i.Email</td>
                    <td>@i.Role</td>
                    <td>@i.Status.ToString().ToLowerInvariant()</td>
                    <td>@(i.Status == InvitationStatus.Pending ? i.ExpiresUtc.ToString("yyyy-MM-dd HH:mm") + " UTC" : "")</td>
                    <td>
                        @if (i.Status is InvitationStatus.Pending or InvitationStatus.Expired)
                        {
                            <div class="row-actions">
                                <button class="link" @onclick="() => ResendAsync(i.Id)">Resend</button>
                                <button class="link" @onclick="() => RevokeAsync(i.Id)">Revoke</button>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<EditForm Model="form" OnValidSubmit="AddAsync" FormName="add-member" class="panel">
    <h2>Add a member or change a role</h2>
    <label>User name <InputText @bind-Value="form.UserName" autocomplete="off" /></label>
    <label>Email <InputText @bind-Value="form.Email" type="email" autocomplete="off" /></label>
    <label>Role
        <InputSelect @bind-Value="form.Role">
            @foreach (var r in OrgRoles.All.Where(r => r != OrgRoles.Owner || Tenant.Role == OrgRoles.Owner))
            {
                <option value="@r">@r</option>
            }
        </InputSelect>
    </label>
    <label>Temporary password <InputText @bind-Value="form.Password" type="password" autocomplete="new-password" /></label>
    <p class="hint">Creates a new account (it changes this password at first sign-in; staff also set up two-step verification), or changes the role of someone already in this organization. Accounts from outside the organization cannot be added here: invite them by email above. This temporary-password path is for accounts you create yourself.</p>
    <button type="submit" disabled="@busy">Add</button>
    @if (message is not null)
    {
        <p role="status" class="@(ok ? "ok" : "error")">@message</p>
    }
</EditForm>

<table class="grid">
    <thead><tr><th>User</th><th>Email</th><th>Role</th><th>Status</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
    <tbody>
        @foreach (var m in members)
        {
            <tr>
                <td>@m.UserName</td>
                <td>@m.Email</td>
                <td>@m.Member.Role</td>
                <td>@(m.Member.IsActive ? "active" : "removed")</td>
                <td>
                    <div class="row-actions">
                        <button class="link" @onclick="() => ToggleAsync(m.Member.Id, !m.Member.IsActive)">@(m.Member.IsActive ? "Remove" : "Restore")</button>
                        <a href="privacy/export/@m.Member.UserId" download="gadfly-data-@(m.Member.UserId.ToString("N")).json">Export data</a>
                    </div>
                    @if (m.Member.UserId != Tenant.UserId)
                    {
                        <details class="erase">
                            <summary>Erase data…</summary>
                            <form method="post" action="privacy/erase/@m.Member.UserId" data-enhance="false">
                                <AntiforgeryToken />
                                <p class="hint">Deletes every exam session and assignment of @m.UserName in this organization (answers, judgments, reports, grades) and deactivates the membership. This cannot be undone; export first if the data is needed.</p>
                                <div class="row-actions">
                                    <input name="confirm" required pattern="DELETE" autocomplete="off" placeholder="Type DELETE" aria-label="Type DELETE to confirm" />
                                    <button type="submit" class="danger">Erase</button>
                                </div>
                            </form>
                        </details>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private sealed class Form
    {
        public string UserName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = OrgRoles.Student;
        public string Password { get; set; } = "";
    }

    /// <summary>Set by the erase endpoint's redirect: how many session records it deleted.</summary>
    [SupplyParameterFromQuery(Name = "erased")] public int? Erased { get; set; }

    private Form form = new();
    private sealed class InviteForm
    {
        public string Email { get; set; } = "";
        public string Role { get; set; } = OrgRoles.Student;
    }

    private sealed class BulkForm
    {
        public string Csv { get; set; } = "";
        public string DefaultRole { get; set; } = OrgRoles.Student;
    }

    private InviteForm invite = new();
    private BulkForm bulk = new();
    private BulkInviteResult? bulkResult;
    private BulkInvitePreview? bulkPreview;
    private string? previewedCsv, previewedRole;
    private IReadOnlyList<InvitationSummary> invitations = [];
    private IReadOnlyList<(MindAttic.Authentication.Entities.AuthMembership Member, string UserName, string? Email)> members = [];
    private string? message, inviteMessage;
    private bool ok, inviteOk, busy;

    private IEnumerable<string> InvitableRoles => OrgRoles.All.Where(r => r != OrgRoles.Owner || Tenant.Role == OrgRoles.Owner);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        members = await Directory.MembersAsync(Tenant.OrganizationId!.Value);
        invitations = await Directory.InvitationsAsync(Tenant.OrganizationId!.Value);
    }

    /// <summary>
    /// The directory shares the circuit's DbContext, which allows one operation at a time: a second click while one is in flight
    /// (a double click) is ignored, and the guard is released even when the operation throws (GAD-T204).
    /// </summary>
    private async Task GuardedAsync(Func<Task> work)
    {
        if (busy) return;
        busy = true;
        try { await work(); }
        finally { busy = false; }
    }

    private Task InviteAsync() => GuardedAsync(async () =>
    {
        var r = await Directory.InviteAsync(Tenant.OrganizationId!.Value, invite.Email, invite.Role, Tenant.Role, Tenant.UserId);
        inviteOk = r.Ok;
        inviteMessage = r.Message;
        if (r.Ok) invite = new();
        await LoadAsync();
    });

    /// <summary>
    /// Sending a CSV first checks it against the free seats (GAD-T487): when some rows would exceed them, the admin sees exactly
    /// which and chooses to send anyway (acceptance is still refused at the limit, GAD-T481) or to edit the list first.
    /// </summary>
    private Task InviteBulkAsync() => GuardedAsync(async () =>
    {
        bulkResult = null;
        var preview = await Directory.PreviewBulkInviteAsync(Tenant.OrganizationId!.Value, bulk.Csv, bulk.DefaultRole, Tenant.Role);
        if (preview.Over.Count > 0)
        {
            bulkPreview = preview;
            previewedCsv = bulk.Csv;
            previewedRole = bulk.DefaultRole;
            return;
        }
        await SendBulkCoreAsync();
    });

    private Task SendBulkAnywayAsync() => GuardedAsync(SendBulkCoreAsync);

    private async Task SendBulkCoreAsync()
    {
        bulkPreview = null;
        bulkResult = await Directory.InviteBulkAsync(Tenant.OrganizationId!.Value, bulk.Csv, bulk.DefaultRole, Tenant.Role, Tenant.UserId);
        if (bulkResult.Rows.All(x => x.Ok)) bulk = new() { DefaultRole = bulk.DefaultRole };
        await LoadAsync();
    }

    /// <summary>The warning belongs to the list it was made for: editing the rows or the default role asks again on the next send.</summary>
    private bool PreviewIsCurrent => bulk.Csv == previewedCsv && bulk.DefaultRole == previewedRole;

    private static string SeatsFree(int? free, string kind) =>
        free is { } n ? $"{n} {kind} seat{(n == 1 ? "" : "s")} free" : $"{kind} seats unlimited";

    private Task ResendAsync(Guid id) => GuardedAsync(async () =>
    {
        var r = await Directory.ResendInvitationAsync(Tenant.OrganizationId!.Value, id, Tenant.UserId);
        inviteOk = r.Ok;
        inviteMessage = r.Message;
        await LoadAsync();
    });

    private Task RevokeAsync(Guid id) => GuardedAsync(async () =>
    {
        var r = await Directory.RevokeInvitationAsync(Tenant.OrganizationId!.Value, id, Tenant.UserId);
        inviteOk = r.Ok;
        inviteMessage = r.Message;
        await LoadAsync();
    });

    private Task AddAsync()
    {
        if (form.Role == OrgRoles.Owner && Tenant.Role != OrgRoles.Owner)
        {
            ok = false;
            message = "Only an owner can add another owner.";
            return Task.CompletedTask;
        }
        return GuardedAsync(async () =>
        {
            var r = await Directory.AddMemberAsync(Tenant.OrganizationId!.Value, form.UserName, form.Email, form.Role, form.Password, actingRole: Tenant.Role, actorUserId: Tenant.UserId);
            ok = r.Ok;
            message = r.Message;
            if (r.Ok) form = new();
            await LoadAsync();
        });
    }

    private Task ToggleAsync(Guid memberId, bool active) => GuardedAsync(async () =>
    {
        var r = await Directory.SetMemberActiveAsync(Tenant.OrganizationId!.Value, memberId, active, actingRole: Tenant.Role, actorUserId: Tenant.UserId);
        ok = r.Ok;
        message = r.Message;
        await LoadAsync();
    });
}

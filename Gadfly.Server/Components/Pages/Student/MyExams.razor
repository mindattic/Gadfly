@page "/my-exams"
@attribute [Authorize(Policy = GadflyPolicies.Student)]
@using Gadfly.Server.Data
@using Gadfly.Server.Student
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject TimeProvider Clock
@inject Gadfly.Server.Localization.UiText T

<HeadContent><link rel="stylesheet" href="student.css" /><link rel="stylesheet" href="practice.css" /></HeadContent>
<PageTitle>@T["myExams.pageTitle"]</PageTitle>
<Tour Id="@Tours.TourIds.MyExams" Float="true" />
<header class="page-header">
    <h1>@T["myExams.heading"] <HelpLink Topic="student-guide" Anchor="finding-your-exam-my-exams" /></h1>
</header>
@if (Tenant.UserId is { } me)
{
    <p class="hint" data-tour="my-exams-data"><a href="privacy/export/@me" download="gadfly-data-@(me.ToString("N")).json">@T["myExams.downloadData"]</a> @T["myExams.downloadDataWhat"] &middot; <a href="my-notifications">@T["myExams.emailPrefs"]</a> &middot; <a href="my-research">@T["myExams.research"]</a></p>
}

@* The ungraded practice interview (GAD-T294): always offered, even with no exam assigned yet. *@
<section class="panel exam-item practice-offer page-section" data-tour="my-exams-practice" aria-labelledby="practice-offer-title">
    <div class="exam-item-head">
        <h2 id="practice-offer-title">@T["myExams.practice.title"]</h2>
        <span class="badge">@T["myExams.practice.badge"]</span>
    </div>
    <p class="hint">@T["myExams.practice.what"]</p>
    <div class="actions"><a class="button secondary" href="my-exams/practice">@T["myExams.practice.start"]</a></div>
</section>

@if (rows is null)
{
    <p class="hint" role="status">@T["myExams.loading"]</p>
}
else if (rows.Count == 0)
{
    <p class="notice info page-section" role="status" data-tour="my-exams-empty">@T["myExams.empty"]</p>
}
else
{
    <div class="exam-list page-section">
        @foreach (var r in rows)
        {
            <section class="panel exam-item" data-tour="my-exams-item" aria-labelledby="exam-@r.AssignmentId.ToString("N")">
                <div class="exam-item-head">
                    <h2 id="exam-@r.AssignmentId.ToString("N")">@r.ExamTitle</h2>
                    <span class="badge badge-@r.Standing.ToString().ToLowerInvariant()">@StudentExams.Describe(r.Standing, T)</span>
                </div>
                <p class="hint">
                    @Window(r) · @T["myExams.attempts", r.AttemptsUsed, r.AttemptsAllowed]
                    @* Every exam is spoken on camera (GAD-T239); typing is only an accommodation the instructor grants (GAD-T260). *@
                    <span> · @(r.TypedAnswers ? T["myExams.typed"] : T["myExams.spoken"])</span>
                </p>
                @if (!string.IsNullOrWhiteSpace(r.Instructions))
                {
                    <p>@r.Instructions</p>
                }
                @if (r.ExamArchived && r.ActiveSessionId is not null)
                {
                    <p class="hint">@T["myExams.archivedInProgress"]</p>
                }
                @if (r.CanStart)
                {
                    <div class="actions" data-tour="my-exams-start">
                        @if (r.CanResumeDirectly)
                        {
                            <a class="button" href="exam/@r.ActiveSessionId">@T["myExams.resume"]</a>
                        }
                        else
                        {
                            <a class="button" href="my-exams/@r.AssignmentId/start">@(r.ActiveSessionId is null ? T["myExams.start"] : T["myExams.resume"])</a>
                        }
                    </div>
                }
                @foreach (var pub in Published(r.AssignmentId))
                {
                    <div class="result">
                        <h3>@(r.AttemptsAllowed > 1 ? T["myExams.resultAttempt", pub.Attempt] : T["myExams.result"])</h3>
                        <p><strong>@T["myExams.grade"]</strong> @(pub.FinalPercent is { } fp ? T.Number((double)fp) + "%" : "—")@(pub.Label is { } lbl ? $" ({lbl})" : "")
                            @if (pub.Status == Gadfly.Assessment.GradeStatus.Amended) { <span class="hint"> · @T["myExams.amended"]</span> }
                            @if (pub.OpenAppeal) { <span class="hint"> · @T["myExams.appealOpen"]</span> }
                        </p>
                        <p><a href="my-results/@pub.SessionId">@T["myExams.report"]</a></p>
                    </div>
                }
                @if (!Published(r.AssignmentId).Any() && r.ScoresClearedAt is not null && r.AttemptsUsed > 0)
                {
                    <p class="hint">@(r.AttemptsUsed == 1 ? T["myExams.clearedOne", T.DateTime(r.ScoresClearedAt.Value), r.AttemptsAllowed] : T["myExams.clearedMany", T.DateTime(r.ScoresClearedAt.Value), r.AttemptsUsed, r.AttemptsAllowed])</p>
                }
                else if (!Published(r.AssignmentId).Any() && r.Standing == AssignmentStanding.Completed)
                {
                    <p class="hint">@T["myExams.submitted"]</p>
                }
            </section>
        }
    </div>
}

@* Every exam the student can take, by category (GAD-T658); open exams not started yet live only here. *@
@if (rows is not null)
{
    <ExamCatalog />
}

@code {
    private IReadOnlyList<StudentAssignmentView>? rows;
    private IReadOnlyList<Gadfly.Server.Grading.StudentResultRow> published = [];

    // Results reach students only through the grading workflow: approved and published (GAD-T98).
    private IEnumerable<Gadfly.Server.Grading.StudentResultRow> Published(Guid assignmentId) =>
        published.Where(p => p.AssignmentId == assignmentId).OrderByDescending(p => p.Attempt).Take(1);

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user)
        {
            rows = [];
            return;
        }
        // Only what staff assigned or the student already started (GAD-T674): an open exam gets its assignment when the
        // student starts it from the catalog below (/my-exams/exam/{id}/start, GAD-T669), not on sight.
        rows = await StudentExams.ListAsync(Scopes, org, user, Clock.GetUtcNow(), T.Language);
        published = await Gadfly.Server.Grading.GradingDb.RunAsync(Scopes, Tenant, g => g.MyResultsAsync());
    }

    private string Window(StudentAssignmentView r) => (r.OpensAt, r.ClosesAt) switch
    {
        (null, null) => T["myExams.window.any"],
        ({ } o, null) => T["myExams.window.opens", T.DateTime(o)],
        (null, { } c) => T["myExams.window.closes", T.DateTime(c)],
        ({ } o, { } c) => T["myExams.window.range", T.DateTime(o), T.DateTime(c)],
    };
}

@page "/my-exams"
@attribute [Authorize(Policy = GadflyPolicies.Student)]
@using Gadfly.Server.Data
@using Gadfly.Server.Student
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject TimeProvider Clock
@inject Gadfly.Server.Localization.UiText T

<HeadContent><link rel="stylesheet" href="student.css" /><link rel="stylesheet" href="practice.css" /></HeadContent>
<PageTitle>@T["myExams.pageTitle"]</PageTitle>
<Tour Id="@Tours.TourIds.MyExams" Float="true" />
<header class="page-header">
    <h1>@T["myExams.heading"] <HelpLink Topic="student-guide" Anchor="finding-your-exam-my-exams" /></h1>
</header>
@if (Tenant.UserId is { } me)
{
    <p class="hint" data-tour="my-exams-data"><a href="privacy/export/@me" download="gadfly-data-@(me.ToString("N")).json">@T["myExams.downloadData"]</a> @T["myExams.downloadDataWhat"] &middot; <a href="my-notifications">@T["myExams.emailPrefs"]</a> &middot; <a href="my-research">@T["myExams.research"]</a></p>
}

@* The ungraded practice interview (GAD-T294): always offered, even with no exam assigned yet. *@
<section class="panel exam-item practice-offer page-section" data-tour="my-exams-practice" aria-labelledby="practice-offer-title">
    <div class="exam-item-head">
        <h2 id="practice-offer-title">@T["myExams.practice.title"]</h2>
        <span class="badge">@T["myExams.practice.badge"]</span>
    </div>
    <p class="hint">@T["myExams.practice.what"]</p>
    <div class="actions"><a class="button secondary" href="my-exams/practice">@T["myExams.practice.start"]</a></div>
</section>

@* Every published exam in the organization, once each, every card alike (GAD-T845): none is assigned to anyone. Starting one by
   exam makes the student's attempt record (/my-exams/exam/{id}/start, GAD-T669); an attempt in progress or finished shows its
   standing and Resume or View result on the same card. *@
@if (cards is null)
{
    <p class="hint" role="status">@T["myExams.loading"]</p>
}
else
{
    <section class="exam-catalog page-section" aria-labelledby="exam-list-heading">
        <div class="exam-list-header">
            <h2 id="exam-list-heading">@T["myExams.list.heading"]</h2>
            <div class="exam-list-tools"></div>
        </div>
        @if (cards.Count == 0)
        {
            <p class="notice info" role="status" data-tour="my-exams-empty">@T["myExams.empty"]</p>
        }
        else
        {
            <div class="exam-list">
                @foreach (var c in cards)
                {
                    var r = c.Row;
                    var pub = r is null ? null : Published(r.AssignmentId);
                    <section class="panel exam-item" data-tour="my-exams-item" aria-labelledby="exam-@c.ExamId.ToString("N")">
                        <div class="exam-item-head">
                            <h2 id="exam-@c.ExamId.ToString("N")">@c.Title</h2>
                            @if (r is not null && (r.Standing != AssignmentStanding.Open || r.AttemptsUsed > 0))
                            {
                                <span class="badge badge-@r.Standing.ToString().ToLowerInvariant()">@StudentExams.Describe(r.Standing, T)</span>
                            }
                        </div>
                        <p class="hint">
                            @(c.Category.Length > 0 ? c.Category : T["myExams.catalog.uncategorized"])
                            @if (c.Languages.Count > 0)
                            {
                                <span> · @T["myExams.catalog.languages"]: @string.Join(", ", c.Languages.Select(Gadfly.Engine.ExamLanguage.NativeName))</span>
                            }
                            @if (r is not null && (r.OpensAt is not null || r.ClosesAt is not null))
                            {
                                <span> · @Window(r)</span>
                            }
                            @if (r is not null && r.AttemptsUsed > 0)
                            {
                                <span> · @T["myExams.attempts", r.AttemptsUsed, r.AttemptsAllowed]</span>
                            }
                            @* Every exam is spoken on camera (GAD-T239); typing is only an accommodation the instructor grants (GAD-T260). *@
                            <span> · @(r is { TypedAnswers: true } ? T["myExams.typed"] : T["myExams.spoken"])</span>
                        </p>
                        @if (r is { ExamArchived: true, ActiveSessionId: not null })
                        {
                            <p class="hint">@T["myExams.archivedInProgress"]</p>
                        }
                        @if (pub is not null)
                        {
                            <p class="result"><strong>@T["myExams.grade"]</strong> @(pub.FinalPercent is { } fp ? T.Number((double)fp) + "%" : "—")@(pub.Label is { } lbl ? $" ({lbl})" : "")
                                @if (pub.Status == Gadfly.Assessment.GradeStatus.Amended) { <span class="hint"> · @T["myExams.amended"]</span> }
                                @if (pub.OpenAppeal) { <span class="hint"> · @T["myExams.appealOpen"]</span> }
                            </p>
                        }
                        else if (r is not null && r.ScoresClearedAt is not null && r.AttemptsUsed > 0)
                        {
                            <p class="hint">@(r.AttemptsUsed == 1 ? T["myExams.clearedOne", T.DateTime(r.ScoresClearedAt.Value), r.AttemptsAllowed] : T["myExams.clearedMany", T.DateTime(r.ScoresClearedAt.Value), r.AttemptsUsed, r.AttemptsAllowed])</p>
                        }
                        else if (r is { Standing: AssignmentStanding.Completed })
                        {
                            <p class="hint">@T["myExams.submitted"]</p>
                        }
                        @if (r is null || r.CanStart || pub is not null)
                        {
                            <div class="actions" data-tour="my-exams-start">
                                @if (r is null)
                                {
                                    <a class="button" href="my-exams/exam/@c.ExamId/start">@T["myExams.start"]</a>
                                }
                                else if (r.CanResumeDirectly)
                                {
                                    <a class="button" href="exam/@r.ActiveSessionId">@T["myExams.resume"]</a>
                                }
                                else if (r.CanStart)
                                {
                                    <a class="button" href="my-exams/@r.AssignmentId/start">@(r.ActiveSessionId is null ? T["myExams.start"] : T["myExams.resume"])</a>
                                }
                                @if (pub is not null)
                                {
                                    <a class="button secondary" href="my-results/@pub.SessionId">@T["myExams.viewResult"]</a>
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }
    </section>
}

@code {
    /// <summary>One card: a published exam, or an attempt record on an exam no longer published, with the student's attempt record when they have one.</summary>
    private sealed record Card(Guid ExamId, string Title, string Category, IReadOnlyList<string> Languages, StudentAssignmentView? Row);

    private IReadOnlyList<Card>? cards;
    private IReadOnlyList<Gadfly.Server.Grading.StudentResultRow> published = [];

    // Results reach students only through the grading workflow: approved and published (GAD-T98).
    private Gadfly.Server.Grading.StudentResultRow? Published(Guid assignmentId) =>
        published.Where(p => p.AssignmentId == assignmentId).OrderByDescending(p => p.Attempt).FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user)
        {
            cards = [];
            return;
        }
        var exams = await StudentCatalog.ListAsync(Scopes, org, T.Language);
        var rows = await StudentExams.ListAsync(Scopes, org, user, Clock.GetUtcNow(), T.Language);
        published = await Gadfly.Server.Grading.GradingDb.RunAsync(Scopes, Tenant, g => g.MyResultsAsync());

        var byExam = rows.GroupBy(r => r.ExamId).ToDictionary(g => g.Key, g => g.First());
        var listed = exams.Select(e => new Card(e.ExamId, e.Title, e.CategoryName, e.Languages, byExam.GetValueOrDefault(e.ExamId))).ToList();
        // An exam archived or withdrawn after the student started it stays on their list while it has an attempt to finish or a result.
        var shown = exams.Select(e => e.ExamId).ToHashSet();
        var retired = rows.Where(r => !shown.Contains(r.ExamId)
                                      && (r.Standing is AssignmentStanding.InProgress or AssignmentStanding.Completed || Published(r.AssignmentId) is not null))
            .Select(r => new Card(r.ExamId, r.ExamTitle, "", [], r));
        cards = listed.Concat(retired)
            .OrderBy(c => c.Row?.Standing == AssignmentStanding.InProgress ? 0 : 1)
            .ToList();
    }

    private string Window(StudentAssignmentView r) => (r.OpensAt, r.ClosesAt) switch
    {
        (null, null) => T["myExams.window.any"],
        ({ } o, null) => T["myExams.window.opens", T.DateTime(o)],
        (null, { } c) => T["myExams.window.closes", T.DateTime(c)],
        ({ } o, { } c) => T["myExams.window.range", T.DateTime(o), T.DateTime(c)],
    };
}

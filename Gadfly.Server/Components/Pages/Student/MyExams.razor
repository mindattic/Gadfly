@page "/my-exams"
@attribute [Authorize(Policy = GadflyPolicies.Student)]
@using Gadfly.Server.Data
@using Gadfly.Server.Student
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject TimeProvider Clock
@inject IConfiguration Config

<HeadContent><link rel="stylesheet" href="student.css" /><link rel="stylesheet" href="practice.css" /></HeadContent>
<PageTitle>My exams · Gadfly Exams</PageTitle>
<h1>My exams <HelpLink Topic="student-guide" Anchor="finding-your-exam-my-exams" /></h1>
@if (Tenant.UserId is { } me)
{
    <p class="hint"><a href="privacy/export/@me" download="gadfly-data-@(me.ToString("N")).json">Download my data</a> (everything this organization keeps about you, as a JSON file)</p>
}

@* The ungraded practice interview (GAD-T294): always offered, even with no exam assigned yet. *@
<section class="panel exam-item practice-offer">
    <div class="exam-item-head">
        <h2>Meet your examiner (practice)</h2>
        <span class="badge">Not graded</span>
    </div>
    <p class="hint">A five-minute practice with the talking examiner: answering out loud, saying "I don't know", eye contact, and what happens if your microphone or camera stops.
        Nothing is kept or counted as an attempt. Take it as often as you like.</p>
    <div class="actions"><a class="button secondary" href="my-exams/practice">Start the practice</a></div>
</section>

@if (rows is null)
{
    <p class="hint" role="status">Loading your exams…</p>
}
else if (rows.Count == 0)
{
    <p class="notice">You have no exams assigned yet. When your instructor assigns one, it appears here.</p>
}
else
{
    <div class="exam-list">
        @foreach (var r in rows)
        {
            <section class="panel exam-item">
                <div class="exam-item-head">
                    <h2>@r.ExamTitle</h2>
                    <span class="badge badge-@r.Standing.ToString().ToLowerInvariant()">@StudentExams.Describe(r.Standing)</span>
                </div>
                <p class="hint">
                    @Window(r) · Attempts used @r.AttemptsUsed of @r.AttemptsAllowed
                    @* Every exam is spoken on camera (GAD-T239); typing is only an accommodation the instructor grants (GAD-T260). *@
                    <span> · @(r.TypedAnswers ? "Spoken questions, typed answers (your accommodation)" : "Spoken exam, on camera")</span>
                </p>
                @if (!string.IsNullOrWhiteSpace(r.Instructions))
                {
                    <p>@r.Instructions</p>
                }
                @if (r.ExamArchived && r.ActiveSessionId is not null)
                {
                    <p class="hint">Your instructor has closed this exam to new attempts. You can still finish the attempt you started.</p>
                }
                @if (r.CanStart)
                {
                    <div class="actions">
                        @if (r.CanResumeDirectly)
                        {
                            <a class="button" href="exam/@r.ActiveSessionId">Resume</a>
                        }
                        else
                        {
                            <a class="button" href="my-exams/@r.AssignmentId/start">@(r.ActiveSessionId is null ? "Start" : "Resume")</a>
                        }
                    </div>
                }
                @foreach (var pub in Published(r.AssignmentId))
                {
                    <div class="result">
                        <h3>Your result@(r.AttemptsAllowed > 1 ? $" (attempt {pub.Attempt})" : "")</h3>
                        <p><strong>Grade:</strong> @(pub.FinalPercent is { } fp ? fp.ToString("0.##") + "%" : "—")@(pub.Label is { } lbl ? $" ({lbl})" : "")
                            @if (pub.Status == Gadfly.Assessment.GradeStatus.Amended) { <span class="hint"> · amended</span> }
                            @if (pub.OpenAppeal) { <span class="hint"> · appeal under review</span> }
                        </p>
                        <p><a href="my-results/@pub.SessionId">See the assessment report</a></p>
                    </div>
                }
                @if (!Published(r.AssignmentId).Any() && r.ScoresClearedAt is not null && r.AttemptsUsed > 0)
                {
                    <p class="hint">Your instructor cleared the scores of this exam for review on @Local(r.ScoresClearedAt.Value).
                        Your answers are kept, and @(r.AttemptsUsed == 1 ? "the attempt you made still counts" : $"the {r.AttemptsUsed} attempts you made still count")
                        toward the @r.AttemptsAllowed allowed. A new result appears here once an examiner has graded it and it has been published.</p>
                }
                else if (!Published(r.AssignmentId).Any() && r.Standing == AssignmentStanding.Completed)
                {
                    <p class="hint">Your answers were submitted. Your result appears here once examiners have graded it and it has been approved and published.</p>
                }
            </section>
        }
    </div>
}

@code {
    private IReadOnlyList<StudentAssignmentView>? rows;
    private IReadOnlyList<Gadfly.Server.Grading.StudentResultRow> published = [];

    // Results reach students only through the grading workflow: approved and published (GAD-T98).
    private IEnumerable<Gadfly.Server.Grading.StudentResultRow> Published(Guid assignmentId) =>
        published.Where(p => p.AssignmentId == assignmentId).OrderByDescending(p => p.Attempt).Take(1);

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user)
        {
            rows = [];
            return;
        }
        // Open exams (GAD-T253): every published exam in the organization, assigned on first sight.
        if (Config.GetValue<bool>(StudentExams.OpenExamsSetting))
            await StudentExams.EnsureOpenAssignmentsAsync(Scopes, org, user, Clock.GetUtcNow());
        rows = await StudentExams.ListAsync(Scopes, org, user, Clock.GetUtcNow());
        published = await Gadfly.Server.Grading.GradingDb.RunAsync(Scopes, Tenant, g => g.MyResultsAsync());
    }

    private static string Window(StudentAssignmentView r) => (r.OpensAt, r.ClosesAt) switch
    {
        (null, null) => "Open any time",
        ({ } o, null) => $"Opens {Local(o)}",
        (null, { } c) => $"Closes {Local(c)}",
        ({ } o, { } c) => $"{Local(o)} to {Local(c)}",
    };

    private static string Local(DateTimeOffset t) => t.ToUniversalTime().ToString("ddd d MMM yyyy, HH:mm") + " UTC";
}

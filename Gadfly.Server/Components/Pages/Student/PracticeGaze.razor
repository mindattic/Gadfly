@* The eye-contact check in the practice interview (GAD-T294): the exam room's own check (wwwroot/js/examiner-gaze.js, the same
   indicator, fade and spoken remarks as ExaminerGaze) run against the practice. The camera is analysed on the student's device
   only, as in an exam. The difference: every episode the browser reports is dropped (PracticeInterview.DropGazeEpisodes), so
   nothing about a practice is stored, and it always runs, whatever any exam's integrity level or accommodation is. *@
@implements IAsyncDisposable
@using Gadfly.Server.Sessions
@using Gadfly.Server.Student
@using Gadfly.Server.Voice
@inject ITenantContext Tenant
@inject VoiceGrants Grants
@inject IJSRuntime JS
@inject ILogger<PracticeGaze> Log
@inject Gadfly.Server.Localization.UiText Ui

<HeadContent><link rel="stylesheet" href="examiner-gaze.css" /></HeadContent>

<div class="examiner-gaze" data-examiner-gaze data-state="off" role="status" aria-live="polite">
    <span class="examiner-gaze-dot" aria-hidden="true"></span>
    <span class="examiner-gaze-label" data-examiner-gaze-label></span>
    <button type="button" class="link" data-examiner-gaze-action="calibrate" hidden>@T["examRoom.gaze.calibrate"]</button>
    <details class="examiner-gaze-more">
        <summary>@T["examRoom.gaze.how"]</summary>
        <p class="examiner-gaze-note">@T["examRoom.gaze.notePractice"]</p>
    </details>
</div>
<div class="examiner-fade" data-examiner-fade data-active="false" aria-hidden="true"></div>

@code {
    [Parameter, EditorRequired] public PracticeInterview Practice { get; set; } = default!;

    /// <summary>
    /// The practice's examiner is the male one (GAD-T672): PracticePage resolves it once, with the assignment's fixed examiner, so the
    /// remarks' pronouns match the examiner actually shown rather than the student's own pick alone.
    /// </summary>
    [Parameter] public bool MaleExaminer { get; set; }

    private bool started;

    /// <summary>The page's language, with the pronouns of the practice's examiner (GAD-T606, GAD-T672).</summary>
    private ExamRoomText T => new(Ui, MaleExaminer);
    private Guid user;
    private IJSObjectReference? module;
    private DotNetObjectReference<PracticeGaze>? self;
    private readonly CancellationTokenSource stop = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || started) return;
        started = true;
        if (Tenant.UserId is not { } u) return;
        user = u;
        try
        {
            self = DotNetObjectReference.Create(this);
            module = await JS.InvokeAsync<IJSObjectReference>("import", stop.Token, "./js/examiner-gaze.js");
            await module.InvokeVoidAsync("start", stop.Token, self, new { basePath = "webcam/", accommodation = false });
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            Log.LogDebug(ex, "The practice eye-contact check did not start.");
        }
    }

    /// <summary>Called by examiner-gaze.js with finished episodes. In a practice they are dropped; true keeps the check running.</summary>
    [JSInvokable]
    public Task<bool> Record(HubIntegrityEvent[]? events) => Task.FromResult(PracticeInterview.DropGazeEpisodes(events));

    /// <summary>The examiner's fixed eye-contact remark for <paramref name="kind"/>, offered to the avatar hub for this practice.</summary>
    [JSInvokable]
    public Task<string?> Remark(string? kind) => Task.FromResult(Practice.Remark(Grants, user, kind));

    public async ValueTask DisposeAsync()
    {
        stop.Cancel();
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("stop");
                await module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException or InvalidOperationException) { }
        }
        self?.Dispose();
        stop.Dispose();
    }
}

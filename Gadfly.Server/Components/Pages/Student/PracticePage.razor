@page "/my-exams/practice"
@attribute [Authorize(Policy = GadflyPolicies.Student)]
@implements IDisposable
@using Gadfly.Server.Student
@using Gadfly.Server.Voice
@inject VoiceSettings Settings
@inject TimeProvider Clock
@inject ILogger<PracticePage> Log
@inject Gadfly.Server.Localization.UiText UiLanguage
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ITenantContext Tenant
@inject IServiceScopeFactory Scopes

@* "Meet your examiner" (GAD-T294): an ungraded practice interview any student can take from My exams at any time. It runs the
   real exam room's pieces (VoiceRoom: the talking examiner, captions, microphone, self-view, transcript, the judging-wait filler
   and her thinking gesture with a short line, the pause on a lost device; and the gentle eye-contact reminders, PracticeGaze) against fixed, built-in
   practice lines (Student/PracticeInterview.cs). Nothing is stored: no session, attempt, turn, grade, report, integrity note or
   audit row; the practice lives in this page's memory and is gone when it closes. The examiner's lines are fixed text, so a
   practice never calls the AI panel; in live mode it costs only her voice and the speech recognizer. *@
<HeadContent>
    <link rel="stylesheet" href="student.css" />
    <link rel="stylesheet" href="practice.css" />
</HeadContent>
<PageTitle>@UiLanguage["practice.pageTitle"]</PageTitle>

<div class="exam-room practice-room @(started ? "exam-live" : null)">
    <header class="exam-head">
        <h1>@UiLanguage["practice.heading"] <span class="practice-tag">@UiLanguage["practice.tag"]</span></h1>
        @if (started)
        {
            <div class="exam-bar">
                <PracticeGaze Practice="practice" />
            </div>
            <div class="exam-status">
                <span class="timer" role="timer" aria-live="off" title="@UiLanguage["practice.clockTitle"]">@Format(practice.Clock.Remaining(Clock.GetUtcNow()))</span>
                @if (practice.Clock.GivenBack(Clock.GetUtcNow()) is { } back && back >= TimeSpan.FromSeconds(1))
                {
                    <span class="hint practice-credit">@UiLanguage["practice.givenBack", Format(back)]</span>
                }
                <span class="progress-line">
                    @UiLanguage["practice.stepOf", practice.StepIndex + 1, PracticeInterview.Steps.Count]
                    <progress max="@PracticeInterview.Steps.Count" value="@(practice.StepIndex + 1)" aria-hidden="true"></progress>
                </span>
                <span class="row-actions">
                    @if (!practice.IsFinished)
                    {
                        <button type="button" class="link" @onclick="Skip" disabled="@pondering">@UiLanguage["practice.skip"]</button>
                    }
                    <button type="button" class="link" @onclick="Restart">@UiLanguage["practice.restart"]</button>
                    <a href="my-exams">@UiLanguage["practice.leave"]</a>
                </span>
            </div>
        }
    </header>

    @if (!Settings.Available)
    {
        <p class="error" role="alert">@UiLanguage["practice.voiceOff"]</p>
        <p><a href="my-exams">@UiLanguage["getReady.backToMyExams"]</a></p>
    }
    else if (!started)
    {
        <section class="panel wide practice-intro">
            <p>@(new ExamRoomText(UiLanguage, maleExaminer)["practice.intro"])</p>
            <ol class="practice-steps">
                @foreach (var s in PracticeInterview.StepsFor(UiLanguage.Language))
                {
                    <li>@s.Title</li>
                }
            </ol>
            <p><strong>@UiLanguage["practice.nothingKept"]</strong> @UiLanguage["practice.nothingKeptMore"]</p>
            <p class="hint">@UiLanguage["practice.needs"]</p>
            @if (Settings.Mode == VoiceMode.Mock)
            {
                <p class="notice" role="note">@UiLanguage["practice.mock"]</p>
            }
            <div class="actions">
                <button type="button" @onclick="Start">@UiLanguage["myExams.practice.start"]</button>
                <a href="my-exams">@UiLanguage["getReady.backToMyExams"]</a>
                <HelpLink Topic="practice-interview" Label="@UiLanguage["practice.about"]" />
            </div>
        </section>
    }
    else
    {
        @* The talking examiner's own lines (voice-room.js, examiner-gaze.js) in the page's language (GAD-T606). *@
        <UiTextData Prefix="examRoom.js." />
        <VoiceRoom SessionId="practice.Id" VoiceFromAssignment="Assignment" TurnIndex="practice.Turn" Question="@practice.Line" CanAnswer="CanAnswer"
                   Active="voiceOn" ActiveChanged="OnVoiceActive" OnAnswer="OnAnswerAsync" OnExaminerSpeaks="OnExaminerSpeaks" Pondering="pondering" AllowWaitAbTest="false" />

        <section class="panel wide exam-card practice-card" aria-labelledby="practice-step-title">
            @if (!voiceOn && !practice.IsFinished)
            {
                <p class="notice" role="status">@(practice.Clock.IsStarted ? UiLanguage["practice.paused"] : UiLanguage["practice.waiting"])</p>
            }
            <p class="concept" id="practice-step-title">@UiLanguage["practice.stepTitle", practice.StepIndex + 1, practice.Current.Title]</p>
            @if (pondering)
            {
                <div class="thinking" role="status">
                    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    @UiLanguage["practice.thinking"]
                    <span class="hint">@UiLanguage["practice.thinkingWhy"]</span>
                </div>
            }
            else
            {
                <ul class="practice-points">
                    @foreach (var point in practice.Current.Points)
                    {
                        <li>@point</li>
                    }
                </ul>
            }
            @if (practice.IsFinished)
            {
                <div class="practice-done" role="status">
                    <p><strong>@UiLanguage["practice.ready"]</strong> @UiLanguage["practice.readyMore"]</p>
                    <div class="actions">
                        <a class="button" href="my-exams">@UiLanguage["practice.goMyExams"]</a>
                        <button type="button" class="secondary" @onclick="Restart">@UiLanguage["practice.again"]</button>
                        <HelpLink Topic="student-guide" Label="@UiLanguage["practice.studentGuide"]" />
                    </div>
                </div>
            }
        </section>
    }
</div>

@code {
    /// <summary>The examiner the student will meet is the male one (GAD-T606): the introduction's pronouns follow.</summary>
    private bool maleExaminer, examinerRead;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || examinerRead) return;
        examinerRead = true;
        (string? Exam, string? Organization) fixedBy = (null, null);
        try
        {
            if (Assignment is { } a && Tenant.OrganizationId is { } org)
                fixedBy = await ExaminerCatalog.AvatarIdsForAssignmentAsync(Scopes, org, a);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogDebug(ex, "The practice's examiner could not be read.");
        }
        if (await ExamRoomText.MaleExaminerAsync(JS, ExaminerCatalog.For(Settings, Env.WebRootPath), fixedBy.Exam, fixedBy.Organization, CancellationToken.None))
        {
            maleExaminer = true;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Opened from an exam's get-ready page (GAD-T560): my-exams/practice?assignment={id} runs the free practice with that exam's own
    /// examiner voice, so the student rehearses with the same examiner. Only the student's own assignment is honoured.
    /// </summary>
    [SupplyParameterFromQuery(Name = "assignment")] public Guid? Assignment { get; set; }

    private readonly PracticeInterview practice = new();
    private bool started, voiceOn, pondering;
    private Timer? ticker;
    private readonly CancellationTokenSource stop = new();

    /// <summary>The microphone opens only while the examiner waits for an answer to this step and isn't "thinking".</summary>
    private bool CanAnswer => voiceOn && practice.WantsAnswer && !pondering;

    // The click is the browser's user activation, so the examiner can speak at once (VoiceRoom's autoStart).
    private void Start()
    {
        started = true;
        practice.Language = UiLanguage.Language;   // her remarks in the student's language (GAD-T532)
        ticker ??= new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Skip()
    {
        if (pondering) return;
        practice.Next();
    }

    private void Restart()
    {
        pondering = false;
        practice.Restart();
        if (voiceOn) practice.Clock.Start(Clock.GetUtcNow());
    }

    private void OnExaminerSpeaks() => practice.Clock.Start(Clock.GetUtcNow());

    /// <summary>VoiceRoom reports the microphone, camera and connection working (true) or lost (false): the practice clock follows.</summary>
    private void OnVoiceActive(bool on)
    {
        voiceOn = on;
        var now = Clock.GetUtcNow();
        if (on) practice.Clock.Resume(now);
        else practice.Clock.Pause(now);
    }

    /// <summary>
    /// A spoken answer, taken as heard as in an exam (GAD-T405): the examiner "thinks" for a moment (her thinking gesture and a short
    /// line, GAD-T559; never the typing arm of the wait A/B test, GAD-T627), then moves to the next step. The words are only checked for "I don't know", then dropped.
    /// </summary>
    /// <remarks>Returns whether the answer was taken (GAD-T473): not taken, the browser keeps the words and sends them again once
    /// an answer is wanted, or drops them when the practice has moved to another step.</remarks>
    private async Task<bool> OnAnswerAsync(VoiceAnswerPayload payload)
    {
        if (pondering || !practice.WantsAnswer) return false;
        var turn = practice.Turn;
        if (payload?.Turn is { } t && t != turn) return false;   // an answer to a step the practice already left
        var said = string.Join(' ', (payload?.Segments ?? []).Select(s => (s.Text ?? "").Trim()).Where(x => x.Length > 0));
        pondering = true;
        StateHasChanged();
        try { await Task.Delay(PracticeInterview.ThinkingPause, stop.Token); }
        catch (OperationCanceledException) { return true; }
        if (practice.Turn == turn) practice.Answer(turn, said);   // unless "Skip" or "Start again" moved on meanwhile
        pondering = false;
        StateHasChanged();
        return true;
    }

    private static string Format(TimeSpan t) => $"{(int)t.TotalMinutes}:{t.Seconds:00}";

    public void Dispose()
    {
        stop.Cancel();
        ticker?.Dispose();
        stop.Dispose();
    }
}

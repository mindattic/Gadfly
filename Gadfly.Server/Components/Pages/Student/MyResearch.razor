@page "/my-research"
@attribute [Authorize(Policy = GadflyPolicies.Student)]
@using Gadfly.Server.Data
@using Gadfly.Server.Research
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject TimeProvider Clock
@inject Gadfly.Server.Localization.UiText T

@* A student's own research choice (GAD-T452): join, decline, or withdraw at any time. Never affects an exam. *@

<HeadContent><link rel="stylesheet" href="student.css" /></HeadContent>
<PageTitle>@T["myResearch.pageTitle"]</PageTitle>
<h1>@T["myExams.research"]</h1>

@if (!loaded)
{
    <p class="hint" role="status">@T["common.loading"]</p>
}
else if (status is null || (!status.Enabled && status.Current != ResearchConsentDecision.Agreed))
{
    <p class="panel">@T["myResearch.none"]</p>
}
else
{
    <section class="panel wide">
        @if (status.Current == ResearchConsentDecision.Agreed)
        {
            <p><strong>@T["myResearch.taking"]</strong> @T["myResearch.takingSince", When(status.Since)]</p>
            @if (status.StudyCode is not null)
            {
                <p>@T["myResearch.code"] <strong>@status.StudyCode</strong>. @T["myResearch.codeWhy"]</p>
            }
            <h2>@withdrawal!.Title</h2>
            @foreach (var p in withdrawal.Paragraphs)
            {
                <p>@p</p>
            }
            <button type="button" @onclick="() => DecideAsync(ResearchConsentDecision.Withdrawn)" disabled="@busy">@T["myResearch.withdraw"]</button>
        }
        else
        {
            <p>
                @T[status.Current switch
                {
                    ResearchConsentDecision.Declined => "myResearch.declined",
                    ResearchConsentDecision.Withdrawn => "myResearch.withdrawn",
                    _ => "myResearch.notAnswered",
                }]
                @T["myResearch.notUsed"]
            </p>
            @if (status.Enabled && status.Invitation is { } invitation)
            {
                <h2>@invitation.Title</h2>
                @foreach (var p in invitation.Paragraphs)
                {
                    <p>@p</p>
                }
                <div class="actions">
                    <button type="button" @onclick="() => DecideAsync(ResearchConsentDecision.Agreed)" disabled="@busy">@T["myResearch.yes"]</button>
                    @if (status.Current is null)
                    {
                        <button type="button" class="secondary" @onclick="() => DecideAsync(ResearchConsentDecision.Declined)" disabled="@busy">@T["myResearch.no"]</button>
                    }
                </div>
            }
        }
        @if (message is not null)
        {
            <p role="status" class="@(ok ? "ok" : "error")">@message</p>
        }
    </section>
    <p><a href="my-exams">@T["getReady.backToMyExams"]</a></p>
}

@code {
    private ResearchStatus? status;
    private ResearchConsentNotice? withdrawal;
    private bool loaded, busy, ok;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        loaded = true;
    }

    private async Task LoadAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } me) return;
        await using var scope = Scopes.CreateAsyncScopeFor(Gadfly.Server.Tenancy.TenantSnapshot.Of(Tenant));
        var db = scope.ServiceProvider.GetRequiredService<GadflyDbContext>();
        status = await new ResearchService(db, Clock).StatusAsync(org, me, text: T);
        var name = await db.Organizations.AsNoTracking().Where(o => o.Id == org).Select(o => o.Name).FirstOrDefaultAsync() ?? "Your organization";
        withdrawal = ResearchConsentNotice.Withdrawal(name, T);
    }

    private async Task DecideAsync(ResearchConsentDecision decision)
    {
        if (busy || status is null || Tenant.OrganizationId is not { } org || Tenant.UserId is not { } me) return;
        var shown = decision == ResearchConsentDecision.Withdrawn ? withdrawal?.Sha256 : status.Invitation?.Sha256;
        if (shown is null) return;
        busy = true;
        message = null;
        try
        {
            await using var scope = Scopes.CreateAsyncScopeFor(Gadfly.Server.Tenancy.TenantSnapshot.Of(Tenant));
            var r = await new ResearchService(scope.ServiceProvider.GetRequiredService<GadflyDbContext>(), Clock)
                .RecordAsync(org, me, decision, shown, "my-research", text: T);
            ok = r.Ok;
            message = r.Message;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is DbUpdateException or InvalidOperationException)
        {
            ok = false;
            message = T["myResearch.saveFailed"];
        }
        finally { busy = false; }
    }

    private string When(DateTimeOffset? at) => at is { } t ? (T.IsEnglish ? t.UtcDateTime.ToString("d MMMM yyyy") : T.Date(t)) : "";
}

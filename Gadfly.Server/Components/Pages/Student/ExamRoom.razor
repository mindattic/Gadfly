@page "/exam/{SessionId:guid}"
@attribute [Authorize(Policy = GadflyPolicies.Student)]
@implements IAsyncDisposable
@using Gadfly.Engine
@using Gadfly.Server.Data
@using Gadfly.Server.Integrity
@using Gadfly.Server.Sessions
@using Gadfly.Server.Student
@using Gadfly.Server.Verification
@using Gadfly.Sources
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject TimeProvider Clock
@inject SessionOrchestrator Sessions
@inject NavigationManager Nav
@inject ILogger<ExamRoom> Log
@inject IJSRuntime JS

<HeadContent><link rel="stylesheet" href="student.css" /></HeadContent>
<PageTitle>@T["examRoom.pageTitle", examTitle ?? T["examRoom.defaultTitle"]]</PageTitle>

@* While the examiner is on screen the room is one screen with no page scroll (GAD-T416, student.css .exam-live): the student keeps
   eye contact with her, so her stage takes the height left over and everything else stays short. *@
@* The attempt's language and examiner (GAD-T606): everything the room hosts reads its text from here. *@
<CascadingValue Value="T" IsFixed="false">
<UiTextData Prefix="examRoom.js." Language="@language" />
<div class="exam-room @(phase is Phase.Answering or Phase.Thinking or Phase.Reflecting && voiceAvailable ? "exam-live" : null)" lang="@language">
    @* Each question or request is announced to screen readers exactly once, when the examiner begins to say it (GAD-T599, WCAG 4.1.3):
       one live region that stays on the page, since the question card is rebuilt between phases and her caption is aria-hidden. *@
    <p class="exam-announce" role="status" aria-live="polite" aria-atomic="true">@announced</p>
    @* The visible timer is silent (role=timer, aria-live=off); only the minutes in TimeWarnings are said, once each, in their own region. *@
    <p class="exam-announce" role="status" aria-live="polite" aria-atomic="true">@timeAnnounced</p>
    <header class="exam-head">
        <h1>@(examTitle ?? T["examRoom.defaultTitle"])</h1>
        @* The camera, eye-contact and integrity lines share the title's row (GAD-T416), each one short line until opened. *@
        <div class="exam-bar">
            <WebcamIntegrity SessionId="SessionId" />
            <StaffNoticeBanner SessionId="SessionId" HeldChanged="OnStaffHeld" />

            @if (integrity is { Level: not IntegrityLevel.Off } watched && phase is Phase.Answering or Phase.Thinking)
            {
                <div class="integrity-notice" role="note">
                    @* The full notice was already agreed to on the consent page. *@
                    <details>
                        <summary>@T["examRoom.integrity.summary"]</summary>
                        <p>@IntegrityNotice(watched)</p>
                    </details>
                    @if (watched.Level == IntegrityLevel.Strict && !fullscreen)
                    {
                        <button type="button" class="secondary small" @onclick="GoFullscreenAsync">@T["examRoom.integrity.fullscreen"]</button>
                    }
                </div>
            }
        </div>
        @* No clock or progress while the closing reflection is asked (GAD-T818): the exam is over and nothing is timed. *@
        @if (phase is Phase.Answering or Phase.Thinking && step is { Reflection: null })
        {
            <div class="exam-status">
                <span class="timer @(TimeLeft <= TimeSpan.FromMinutes(2) ? "timer-low" : "")" role="timer" aria-live="off" title="@T["examRoom.timer.title"]">@Format(TimeLeft)</span>
                <span class="progress-line">
                    @T["examRoom.progress", step.ConceptsClosed, step.ConceptsTotal]
                    <progress max="@Math.Max(1, step.ConceptsTotal)" value="@step.ConceptsClosed" aria-hidden="true"></progress>
                </span>
            </div>
        }
    </header>

    @if (phase is Phase.Answering or Phase.Thinking or Phase.Reflecting)
    {
        if (voiceAvailable)
        {
            @* The talking examiner (GAD-T53, mandatory since GAD-T239): kept outside the phase switch so the microphone, the camera and
               the examiner persist from question to question, and on to the closing reflection (GAD-T818). *@
            <VoiceRoom SessionId="SessionId" TurnIndex="VoiceTurn" Question="@VoiceQuestion" Move="@(step?.Reflection is null ? step?.Move : null)" Prompt="@VoicePrompt"
                       PromptId="step?.Verification?.ResponseId" CanAnswer="VoiceCanAnswer" HeldByStaff="staffHeld" Active="voiceOn" ActiveChanged="OnVoiceActive"
                       OnAnswer="OnVoiceAnswerAsync" OnExaminerSpeaks="OnExaminerSpeaksAsync" TypedAnswers="typedAnswers" @ref="voiceRoom" Pondering="VoicePondering"
                       OnPartialAnswer="OnPartialAnswerAsync" OnSayAnotherWay="SayAnotherWayAsync" CanSayAnotherWay="CanSayAnotherWay" />
        }
        else
        {
            <p class="error" role="alert">@T["examRoom.voiceOff"]</p>
        }
        @* Leaving the exam window (GAD-T511): a neutral line, never a strike count or a threat. *@
        @if (windowAway)
        {
            <p class="notice exam-window" role="status">@T["examRoom.window.away"]</p>
        }
        else if (windowBackNotice)
        {
            <p class="notice exam-window" role="status">@T["examRoom.window.back"]</p>
        }
    }

    @if (reviewNotice && phase is Phase.Answering or Phase.Thinking or Phase.Ended)
    {
        @* Several or long absences (GAD-T511): a person decides; the student is told and may explain. Nothing is cancelled. *@
        <section class="panel wide exam-review-note" aria-labelledby="review-note-title">
            <h2 id="review-note-title" class="verify-label">@T["examRoom.review.title"]</h2>
            <p>@T["examRoom.review.body"]</p>
            @if (reviewNoteSent)
            {
                <p class="ok" role="status">@T["examRoom.review.noteThanks"]</p>
            }
            else
            {
                <label>
                    @T["examRoom.review.noteLabel"]
                    <textarea rows="3" maxlength="1000" @bind="reviewNote" @bind:event="oninput"></textarea>
                </label>
                <div class="actions">
                    <button type="button" class="secondary" disabled="@(reviewNoteSending || string.IsNullOrWhiteSpace(reviewNote))" @onclick="SendReviewNoteAsync">@T["examRoom.review.noteSend"]</button>
                    <button type="button" class="link" @onclick="() => reviewNotice = false">@T["examRoom.review.noteLater"]</button>
                </div>
            }
        </section>
    }

    @switch (phase)
    {
        case Phase.Loading:
            <p class="hint" role="status">@T["examRoom.loading"]</p>
            break;

        case Phase.NotFound:
            <p class="notice">@T["examRoom.notFound"] <a href="my-exams">@T["examRoom.backToMyExams"]</a></p>
            break;

        case Phase.Thinking:
            <section class="panel wide exam-card" aria-busy="true">
                @if (step?.Question is not null && thinkingAbout == ThinkingAbout.Answer)
                {
                    <p class="hint">@step.ConceptTitle</p>
                }
                <div class="thinking" role="status">
                    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    @(thinkingAbout switch
                    {
                        ThinkingAbout.Answer => T["examRoom.thinking.answer"],
                        ThinkingAbout.Finish => T["examRoom.thinking.finish"],
                        ThinkingAbout.Saving => T["examRoom.thinking.saving"],
                        _ => T["examRoom.thinking.question"],
                    })
                    <span class="hint">@T["examRoom.thinking.wait"]</span>
                </div>
            </section>
            break;

        case Phase.Answering:
            <section class="panel wide exam-card">
                @if (!voiceOn)
                {
                    @* No microphone, camera or examiner connection (not yet, or lost): the exam is paused (GAD-T239). The question
                       is not shown until the examiner asks it, so time before the clock starts can't be spent reading it. *@
                    <p class="notice" role="status">@(examinerHasSpoken
                        ? T[(typedAnswers ? "examRoom.paused.typed" : "examRoom.paused") + (PauseStopsClock ? ".clockStopped" : "")]
                        : T[typedAnswers ? "examRoom.waitingToStart.typed" : "examRoom.waitingToStart"])</p>
                }
                else
                {
                @if (!string.IsNullOrWhiteSpace(step?.ConceptTitle))
                {
                    <p class="concept">@step.ConceptTitle</p>
                }
                @* The question shows as the caption under the examiner, in step with her speech, and in the transcript; screen
                   readers hear it from the exam-announce region (GAD-T599), so the card doesn't repeat it. *@
                @if (step?.Verification is { Kind: ResponseLedger.TranscriptKind })
                {
                    @* A read-back request left over from before GAD-T405: there is nothing to confirm or correct any more. The page takes
                       the answer as heard on its own (TakeAsHeardAsync), so only a moment's status shows here. *@
                    <p class="hint" role="status">@T["examRoom.thinking.answer"]</p>
                }
                else if (step?.Verification is { } v)
                {
                    @* One request at a time about the answer just given, before it is judged (GAD-T88). A spoken answer is taken as heard
                       and never gets one (GAD-T405): this is a typed answer's meaning clarification, or one left over from before. *@
                    <div class="verify" role="region" aria-labelledby="verify-title">
                        <p class="verify-label">@T["examRoom.verify.recorded"]</p>
                        <blockquote class="recorded-answer">@v.RecordedText</blockquote>
                        <h2 id="verify-title" class="verify-title">@T["examRoom.verify.title"]</h2>
                        <p class="verify-prompt">@v.Prompt</p>
                        <p class="hint">@T["examRoom.verify.hint"]</p>
                        @if (typedAnswers && typoFix)
                        {
                            <label>
                                @T["examRoom.verify.typoLabel"]
                                <textarea rows="6" @bind="extraText" @bind:event="oninput" aria-describedby="typo-hint"></textarea>
                            </label>
                            <p id="typo-hint" class="hint">@T["examRoom.verify.typoHint"]</p>
                            <div class="actions">
                                <button type="button" disabled="@string.IsNullOrWhiteSpace(extraText)" @onclick="CorrectPendingAsync">@T["examRoom.verify.saveTypo"]</button>
                                <button type="button" class="secondary" @onclick="() => typoFix = false">@T["examRoom.back"]</button>
                            </div>
                        }
                        else if (typedAnswers)
                        {
                            @* Typed-answer accommodation (GAD-T260): the clarification is typed too. *@
                            <label>
                                @T["examRoom.verify.clarifyLabel"]
                                <textarea id="clarify-box" rows="4" @bind="extraText" @bind:event="oninput" placeholder="@T["examRoom.verify.clarifyPlaceholder"]"></textarea>
                            </label>
                            <div class="actions">
                                <button type="button" disabled="@(busy || string.IsNullOrWhiteSpace(extraText))" @onclick="() => ClarifyTypedAsync(v)">@T["examRoom.verify.send"]</button>
                                <button type="button" class="secondary" @onclick="() => ClarifyAsync(v, null)">@T["examRoom.verify.decline"]</button>
                                <button type="button" class="link" @onclick="() => StartTypoFix(v.RecordedText)">@T["examRoom.verify.typoInstead"]</button>
                            </div>
                        }
                        else
                        {
                            @* Left over from before GAD-T405 on a spoken answer: clarified out loud, never typed (GAD-T239), and a spoken
                               answer has no typo fix. *@
                            <p class="hint" role="status">@T["examRoom.verify.spoken"]</p>
                            <div class="actions">
                                <button type="button" class="secondary" @onclick="() => ClarifyAsync(v, null)">@T["examRoom.verify.decline"]</button>
                            </div>
                        }
                    </div>
                }
                else if (typedAnswers)
                {
                    @* Typed-answer accommodation (GAD-T260): granted by an instructor or admin for this student on this exam, never chosen
                       by the student. The examiner still speaks the question and the camera and gaze check still run; only the answer is
                       typed, stored as typed, and a paste into this box is noted for review (integrity.js, #answer-box). *@
                    <label>
                        @T["examRoom.typed.label"]
                        <textarea id="answer-box" rows="7" @bind="typedAnswer" @bind:event="oninput" @bind:after="OnTyped" @onkeydown="OnTypedKeyDownAsync"
                                  placeholder="@T["examRoom.typed.placeholder"]" aria-describedby="answer-hint"></textarea>
                    </label>
                    <p id="answer-hint" class="hint">@T["examRoom.typed.hint"]</p>
                    <div class="actions">
                        <button type="button" @onclick="SubmitTypedAsync" disabled="@(busy || staffHeld || string.IsNullOrWhiteSpace(typedAnswer))" title="@(staffHeld ? T["examRoom.typed.heldTitle"] : null)">@T["examRoom.typed.submit"]</button>
                        <button type="button" class="secondary" @onclick="DontKnowAsync" disabled="@(!CanSayDontKnow)" title="@DontKnowTitle">@T["examRoom.dontKnow"]</button>
                    </div>
                }
                else
                {
                    @* Spoken answers only (GAD-T239): there is no typed answer box. *@
                    <div class="actions">
                        <p class="hint" role="status">@T["examRoom.spoken.hint"]</p>
                        <button type="button" class="secondary" @onclick="DontKnowAsync" disabled="@(!CanSayDontKnow)" title="@DontKnowTitle">@T["examRoom.dontKnow"]</button>
                    </div>
                }
                }
                @if (step?.Notice is { } note && error is null)
                {
                    <p class="ok" role="status">@(step.NoticeKey is { } noteKey ? T[noteKey] : note)</p>
                }
                @if (error is not null && lastMode == LastMode.None)
                {
                    <p class="error" role="alert">@error</p>
                }
            </section>

            @* A spoken answer is kept as heard: no changed answer (GAD-T239) and no after-the-fact fix (GAD-T405), so the server only
               offers this for a typed answer (GAD-T260): a small typo fix, never a new answer. *@
            @if (voiceOn && step?.Verification is null && step?.LastAnswer is { } last && last.CanCorrectTypo)
            {
                <section class="panel wide last-answer" aria-labelledby="last-title">
                    <p id="last-title" class="verify-label">@T["examRoom.last.title"]</p>
                    @if (lastMode == LastMode.Typo)
                    {
                        <p class="hint">@T["examRoom.last.question", last.Question]</p>
                        <label>
                            @T["examRoom.last.typoLabel"]
                            <textarea rows="5" @bind="extraText" @bind:event="oninput" aria-describedby="last-typo-hint"></textarea>
                        </label>
                        <p id="last-typo-hint" class="hint">@T["examRoom.last.typoHint"]</p>
                        <div class="actions">
                            <button type="button" disabled="@string.IsNullOrWhiteSpace(extraText)" @onclick="CorrectLastAsync">@T["examRoom.last.save"]</button>
                            <button type="button" class="secondary" @onclick="CancelLast">@T["examRoom.cancel"]</button>
                        </div>
                    }
                    else
                    {
                        <div class="actions">
                            <button type="button" class="link" @onclick="() => StartLast(LastMode.Typo, last.Text)">@T["examRoom.last.typoOpen"]</button>
                        </div>
                    }
                    @if (error is not null && lastMode != LastMode.None)
                    {
                        <p class="error" role="alert">@error</p>
                    }
                </section>
            }

            <section class="finish">
                @if (!confirmFinish)
                {
                    <button type="button" class="link" @onclick="() => confirmFinish = true">@T["examRoom.finish.open"]</button>
                }
                else
                {
                    @* Moves focus here when it opens (GAD-T365): nothing else marks it modal (the page behind still
                       scrolls and takes clicks), so a screen reader needs to be put here directly to notice it at all. *@
                    <div class="notice" role="alertdialog" aria-labelledby="finish-q" tabindex="-1" @ref="confirmDialogRef">
                        <p id="finish-q"><strong>@T["examRoom.finish.question"]</strong> @T["examRoom.finish.confirm"]</p>
                        <div class="actions">
                            <button type="button" @onclick="FinishAsync">@T["examRoom.finish.yes"]</button>
                            <button type="button" class="secondary" @onclick="() => confirmFinish = false">@T["examRoom.finish.keepGoing"]</button>
                        </div>
                    </div>
                }
            </section>
            break;

        case Phase.Reflecting:
            @* The closing reflection (GAD-T818): asked aloud after the examiner ended the exam, outside the clock and never graded. No
               timer, no progress and no "I don't know"; one plain Skip (Elenchus at Scale 2.5.1, 5.3.4). *@
            <section class="panel wide exam-card" aria-labelledby="reflection-title">
                <h2 id="reflection-title" class="verify-label">@T["examRoom.reflection.title"]</h2>
                <p class="exam-question">@step?.Reflection</p>
                <p class="hint">@T["examRoom.reflection.notGraded"]</p>
                @if (typedAnswers)
                {
                    <label>
                        @T["examRoom.typed.label"]
                        <textarea id="reflection-box" rows="5" @bind="typedReflection" @bind:event="oninput" placeholder="@T["examRoom.typed.placeholder"]"></textarea>
                    </label>
                    <p class="hint">@T["examRoom.reflection.typed"]</p>
                    <div class="actions">
                        <button type="button" @onclick="SubmitTypedReflectionAsync" disabled="@(busy || string.IsNullOrWhiteSpace(typedReflection))">@T["examRoom.reflection.send"]</button>
                        <button type="button" class="secondary" @onclick="SkipReflectionAsync" disabled="@busy">@T["examRoom.reflection.skip"]</button>
                    </div>
                }
                else
                {
                    <div class="actions">
                        <p class="hint" role="status">@T["examRoom.reflection.spoken"]</p>
                        <button type="button" class="secondary" @onclick="SkipReflectionAsync" disabled="@busy">@T["examRoom.reflection.skip"]</button>
                    </div>
                }
                @if (error is not null)
                {
                    <p class="error" role="alert">@error</p>
                }
            </section>
            break;

        case Phase.Ended:
            <section class="panel wide exam-card">
                <h2>@T["examRoom.ended.title"]</h2>
                @if (endNote is not null)
                {
                    <p>@endNote</p>
                }
                @{ var results = ResultsSentence(); }
                <p>@results.Before<a href="my-exams">@T["examRoom.ended.resultsLink"]</a>@results.After</p>
                @* GAD-T320: help sits only on the ended and error cards, never in the header while the examiner is on screen, so
                   nothing covers her or draws the student away mid-answer. *@
                <p class="hint"><HelpLink Topic="grading-and-results" Label="@T["examRoom.help.grading"]" /></p>
                <a class="button" href="my-exams">@T["examRoom.backToMyExams"]</a>
            </section>
            break;

        case Phase.Error:
            <section class="panel wide exam-card">
                <p class="error" role="alert">@error</p>
                <p class="hint"><HelpLink Topic="troubleshooting-browser" Label="@T["examRoom.help.browser"]" /></p>
                <div class="actions">
                    <button type="button" @onclick="RetryAsync">@T["examRoom.tryAgain"]</button>
                    <a class="button secondary" href="my-exams">@T["examRoom.backToMyExams"]</a>
                </div>
            </section>
            break;
    }
</div>
</CascadingValue>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private enum Phase { Loading, NotFound, Thinking, Answering, Reflecting, Ended, Error }
    private enum ThinkingAbout { Question, Answer, Finish, Saving }
    private enum LastMode { None, Typo }

    /// <summary>The typo-fix box is open instead of a typed answer's clarification (GAD-T260; a spoken answer has none).</summary>
    private bool typoFix;
    private LastMode lastMode;
    /// <summary>The text of whichever side box is open: a correction of how an answer was recorded.</summary>
    private string extraText = "";

    private Phase phase = Phase.Loading;
    private ThinkingAbout thinkingAbout;
    private SessionStep? step;
    private string? examTitle, error, endNote;
    private DateTimeOffset? answerStartedAt;
    private DateTimeOffset deadline;
    private bool busy, confirmFinish, timeUpHandled;
    /// <summary>The answer to resend when a step failed partway (e.g. a panel call timed out).</summary>
    private string? pendingAnswer;

    private readonly CancellationTokenSource stop = new();
    private PeriodicTimer? ticker;

    private TimeSpan TimeLeft
    {
        get
        {
            // Held until the examiner begins the first question (GAD-T239): shown, but not counting down.
            if (step is { ClockStarted: false } held) return held.Remaining;
            // Paused for a lost microphone or camera (GAD-T263): standing still until the pause allowance is spent, then counting again.
            if (step is { ClockPaused: true } paused)
            {
                var pausedFor = Clock.GetUtcNow() - (deadline - paused.Remaining);
                var over = pausedFor - paused.PauseAllowanceLeft;
                var stillLeft = over > TimeSpan.Zero ? paused.Remaining - over : paused.Remaining;
                return stillLeft < TimeSpan.Zero ? TimeSpan.Zero : stillLeft;
            }
            var left = deadline - Clock.GetUtcNow();
            return left < TimeSpan.Zero ? TimeSpan.Zero : left;
        }
    }

    /// <summary>The minutes left at which a screen reader hears the time (WCAG 4.1.3): never every second.</summary>
    private static readonly int[] TimeWarnings = [5, 2, 1];
    private string? timeAnnounced;
    /// <summary>The smallest warning the time left is already under, or null before the clock is first seen.</summary>
    private int? timeWarnedAt;

    /// <summary>Says the time once as it falls under each warning. The first reading only notes where the clock stands, so a
    /// short exam or a reload doesn't open with a warning for a mark it was already past.</summary>
    private void WarnTime()
    {
        if (step is not { ClockStarted: true }) return;
        var left = TimeLeft;
        if (left <= TimeSpan.Zero) return;
        var under = TimeWarnings.Where(m => left <= TimeSpan.FromMinutes(m)).DefaultIfEmpty(int.MaxValue).Min();
        if (timeWarnedAt is { } last && under < last)
            timeAnnounced = under == 1 ? T["examRoom.timer.warn.one"] : T["examRoom.timer.warn", under];
        timeWarnedAt = under;
    }

    private ElementReference confirmDialogRef;
    private bool confirmDialogFocused;

    // Load only once interactive: the first step can call the panel, which must not run during prerender.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadExaminerAsync();   // the examiner's pronouns (GAD-T606)
            await LoadAsync();
            StateHasChanged();
            _ = TickAsync();
            WatchReconnect();
            _ = StartWindowWatchAsync();   // leaving the exam window pauses it (GAD-T511)
        }
        // The "Finish the exam now?" prompt (GAD-T365): focus moves to it the moment it opens, once, so a screen
        // reader user is told it's there instead of having to find it; it resets so the next opening focuses again.
        if (confirmFinish && !confirmDialogFocused)
        {
            confirmDialogFocused = true;
            try { await confirmDialogRef.FocusAsync(); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException) { }
        }
        else if (!confirmFinish)
        {
            confirmDialogFocused = false;
        }
    }

    private async Task LoadAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user)
        {
            phase = Phase.NotFound;
            return;
        }
        var info = await StudentExams.SessionAsync(Scopes, org, user, SessionId);
        if (info is not { } s)
        {
            phase = Phase.NotFound;
            return;
        }
        examTitle = s.ExamTitle;
        LoadVoice();   // every exam is spoken (GAD-T239)
        await LoadTypedAnswersAsync(org, user);   // unless typing was granted as an accommodation (GAD-T260)
        switch (s.State)
        {
            case SessionState.Created:
                // Consent first.
                Nav.NavigateTo($"my-exams/{s.AssignmentId}/start");
                return;
            case SessionState.Ended:
                // A reload while the closing reflection waits comes back to it (GAD-T818); otherwise the ended card.
                phase = Phase.Ended;
                await RunStepAsync(ThinkingAbout.Saving, () => Sessions.CurrentAsync(org, SessionId, user));
                if (phase == Phase.Error)
                {
                    error = null;
                    phase = Phase.Ended;
                }
                return;
            case SessionState.Failed:
                phase = Phase.Error;
                error = T["examRoom.error.cantContinue"];
                return;
        }
        if (!integrityStarted)
        {
            integrityStarted = true;
            _ = StartIntegrityAsync(org, user);
        }
        await RunStepAsync(ThinkingAbout.Question, () => Sessions.CurrentAsync(org, SessionId, user));
    }

    // ---------------------------------------------------------------- browser integrity signals (GAD-T56)

    private IntegritySettings? integrity;
    private IJSObjectReference? integrityModule;
    private DotNetObjectReference<ExamRoom>? integrityRef;
    private Guid integrityOrg, integrityUser;
    private bool fullscreen, integrityStarted;
    private TimeSpan? clientSkew;

    /// <summary>Loads the exam's integrity level and, unless it is Off, starts wwwroot/js/integrity.js. Never blocks the exam.</summary>
    private async Task StartIntegrityAsync(Guid org, Guid user)
    {
        try
        {
            await using (var scope = Scopes.CreateAsyncScopeFor(TenantSnapshot.ForOrganization(org)))
                integrity = await IntegrityRecorder.Create(scope.ServiceProvider).SettingsAsync(org, user, SessionId, stop.Token);
            if (integrity is not { Level: not IntegrityLevel.Off } settings) return;
            integrityOrg = org;
            integrityUser = user;
            integrityRef ??= DotNetObjectReference.Create(this);
            integrityModule = await JS.InvokeAsync<IJSObjectReference>("import", stop.Token, "./js/integrity.js");
            await integrityModule.InvokeAsync<bool>("start", stop.Token, integrityRef, new
            {
                sessionId = SessionId,
                level = settings.Level.ToString(),
                // Answers are spoken (GAD-T239): there is no answer box to paste into, except under the typed-answer accommodation
                // (GAD-T260), where a paste is noted for review (never blocked: assistive tools often insert text this way).
                recordPaste = typedAnswers,
            });
            fullscreen = await integrityModule.InvokeAsync<bool>("isFullscreen", stop.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            Log.LogDebug(ex, "Browser integrity signals did not start for session {SessionId}.", SessionId);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Browser integrity signals did not start for session {SessionId}.", SessionId);
        }
    }

    /// <summary>Called by integrity.js with a batch of signals. Returns false when the browser should stop sending.</summary>
    [JSInvokable]
    public async Task<bool> RecordIntegrity(BrowserSignalBatch batch)
    {
        if (integrityOrg == Guid.Empty || integrityUser == Guid.Empty || batch is null) return false;
        // The smallest clock offset seen on this connection is the best estimate (no queueing delay in it).
        if (IntegrityRecorder.ObservedSkew(batch, Clock.GetUtcNow()) is { } seen && (clientSkew is null || seen < clientSkew)) clientSkew = seen;
        try
        {
            bool keepGoing;
            await using (var scope = Scopes.CreateAsyncScopeFor(TenantSnapshot.ForOrganization(integrityOrg)))
                keepGoing = await IntegrityRecorder.Create(scope.ServiceProvider).RecordAsync(integrityOrg, integrityUser, SessionId, batch, clockSkew: clientSkew);
            if (fullscreen && batch.Events.Any(e => e.Type == "fullscreen-exit"))
            {
                fullscreen = false;
                await InvokeAsync(StateHasChanged);
            }
            return keepGoing;
        }
        catch (Exception ex)
        {
            // Never the student's problem: log and let the browser keep its queue moving.
            Log.LogWarning(ex, "Could not record browser integrity signals for session {SessionId}.", SessionId);
            return true;
        }
    }

    private async Task GoFullscreenAsync()
    {
        if (integrityModule is null) return;
        try { fullscreen = await integrityModule.InvokeAsync<bool>("enterFullscreen"); }
        catch (JSException) { fullscreen = false; }
    }

    /// <summary>What is noted, in the student's words: no surprise monitoring (matches the consent notice). One whole sentence per case.</summary>
    private string IntegrityNotice(IntegritySettings s) => T[(s.Level == IntegrityLevel.Strict, typedAnswers) switch
    {
        (true, true) => "examRoom.integrity.notice.strictTyped",
        (true, false) => "examRoom.integrity.notice.strict",
        (false, true) => "examRoom.integrity.notice.typed",
        _ => "examRoom.integrity.notice",
    }];

    /// <summary>The "results on My exams" sentence around its link, whose place differs by language.</summary>
    private (string Before, string After) ResultsSentence()
    {
        var parts = T["examRoom.ended.results", "\u0000"].Split('\u0000');
        return (parts[0], parts.Length > 1 ? parts[1] : "");
    }

    /// <summary>
    /// Runs one orchestrator step with the thinking state shown, then shows its result. False when it did not run (another step was
    /// running) or the server refused it (the reason is shown), so a spoken answer can be kept in the browser (GAD-T473).
    /// </summary>
    private async Task<bool> RunStepAsync(ThinkingAbout about, Func<Task<SessionStep>> run)
    {
        if (busy) return false;
        var ran = true;
        busy = true;
        error = null;
        confirmFinish = false;
        thinkingAbout = about;
        var previous = phase;
        phase = Phase.Thinking;
        StateHasChanged();
        try
        {
            Apply(await run());
            pendingAnswer = null;
        }
        catch (SessionRefusedException ex)
        {
            error = ex.In(T.Text);   // in the attempt's language (GAD-T628)
            phase = previous is Phase.Answering or Phase.Reflecting ? previous : Phase.Error;
            ran = false;
        }
        catch (Exception ex) when (ex is not OperationCanceledException || !stop.IsCancellationRequested)
        {
            Log.LogError(ex, "Exam room step failed for session {SessionId}.", SessionId);
            error = T["examRoom.error.step"];
            phase = Phase.Error;
        }
        finally
        {
            busy = false;
        }
        await TakeAsHeardAsync();
        return ran;
    }

    private void Apply(SessionStep next)
    {
        step = next;
        deadline = Clock.GetUtcNow() + next.Remaining;
        if (next.Reflection is not null)
        {
            // The examiner ended the exam and asks the closing reflection (GAD-T818); answering or skipping it shows the ended card.
            phase = Phase.Reflecting;
            return;
        }
        if (next.State == SessionState.Ended || next.Question is null)
        {
            phase = Phase.Ended;
            endNote = next.EndReason switch
            {
                nameof(EndReason.TimeUp) => T["examRoom.ended.timeUp"],
                nameof(EndReason.Abandoned) => T["examRoom.ended.early"],
                nameof(EndReason.Mastery) or nameof(EndReason.Aporia) or nameof(EndReason.TurnLimit) or nameof(EndReason.EvidenceComplete) => T["examRoom.ended.examinerDone"],
                _ => null,
            };
            return;
        }
        // A new request or question, or a completed action, closes the side boxes.
        if (next.Verification?.ResponseId != shownRequest || next.TurnIndex != shownTurn || next.Notice is not null)
        {
            typoFix = false;
            lastMode = LastMode.None;
            extraText = "";
            shownRequest = next.Verification?.ResponseId;
        }
        // A new question starts a new answer.
        if (next.TurnIndex != shownTurn)
        {
            answerStartedAt = null;
            typedAnswer = "";
            shownTurn = next.TurnIndex;
        }
        timeUpHandled = false;
        phase = Phase.Answering;
    }

    private int? shownTurn;
    private Guid? shownRequest;

    private void StartTypoFix(string text)
    {
        typoFix = true;
        extraText = text;
        error = null;
    }

    private void StartLast(LastMode mode, string text)
    {
        lastMode = mode;
        extraText = mode == LastMode.Typo ? text : "";
        error = null;
    }

    private void CancelLast()
    {
        lastMode = LastMode.None;
        extraText = "";
        error = null;
    }

    private async Task VerifyStepAsync(ThinkingAbout about, Func<Guid, Guid, Task<SessionStep>> run)
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user) return;
        pendingAnswer = null;
        // Resolving a request about the answer (a clarification, a typo fix) sends it to be judged: the examiner fills that wait out
        // loud (GAD-T290), as for any answer.
        await RunStepAsync(about, () => run(org, user));
    }

    private Task ClarifyAsync(PendingVerification v, string? reply) =>
        VerifyStepAsync(ThinkingAbout.Answer, (org, user) => Sessions.ClarifyAsync(org, SessionId, user, v.ResponseId, reply?.Trim()));

    private Task CorrectPendingAsync() =>
        VerifyStepAsync(ThinkingAbout.Answer, (org, user) => Sessions.CorrectAnswerAsync(org, SessionId, user, extraText.Trim()));

    /// <summary>The read-back request already answered as heard, so it is never sent twice (a refusal must not loop).</summary>
    private Guid? takenAsHeard;

    /// <summary>
    /// A spoken answer is taken as heard (GAD-T405). A read-back request created before that change can still be waiting on an exam in
    /// progress: the page answers it at once as heard, through the same confirmation the old Yes button used, so the answer is judged
    /// and the exam moves on without the student being asked anything. Runs after every step; nothing to do when there is no such request.
    /// </summary>
    private async Task TakeAsHeardAsync()
    {
        if (step?.Verification is not { Kind: ResponseLedger.TranscriptKind } v || takenAsHeard == v.ResponseId) return;
        takenAsHeard = v.ResponseId;
        await VerifyStepAsync(ThinkingAbout.Answer, (org, user) => Sessions.ConfirmTranscriptAsync(org, SessionId, user, v.ResponseId));
    }

    private Task CorrectLastAsync() =>
        VerifyStepAsync(ThinkingAbout.Saving, (org, user) => Sessions.CorrectAnswerAsync(org, SessionId, user, extraText.Trim()));

    private Task DontKnowAsync() => CanSayDontKnow ? SendAsync(SourceExamEngine.AporiaWord) : Task.CompletedTask;

    private async Task SendAsync(string text)
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user || string.IsNullOrWhiteSpace(text)) return;
        pendingAnswer = text;
        // A resend after a failed step keeps a spoken answer's voice modality, word timings and metrics (GAD-T53).
        var submitted = pendingVoiceAnswer is { } spoken && spoken.Text == text
            ? spoken with { CompletedAt = Clock.GetUtcNow() }
            : new Answer
            {
                Text = text,
                Mode = "text",
                StartedAt = answerStartedAt,
                CompletedAt = Clock.GetUtcNow(),
            };
        if (pendingVoiceAnswer is not null && submitted.Mode == "voice") pendingVoiceAnswer = submitted;
        await RunStepAsync(ThinkingAbout.Answer, () => Sessions.AnswerAsync(org, SessionId, user, submitted));
    }

    private async Task FinishAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user) return;
        await RunStepAsync(ThinkingAbout.Finish, () => Sessions.EndAsync(org, SessionId, user, EndReason.Abandoned));
    }

    private async Task RetryAsync()
    {
        if (pendingAnswer is { } text) await SendAsync(text);
        else await LoadAsync();
    }

    /// <summary>Ticks the countdown locally between steps; the server's Remaining resets it on every step.</summary>
    private async Task TickAsync()
    {
        ticker = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await ticker.WaitForNextTickAsync(stop.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (phase is not (Phase.Answering or Phase.Thinking)) return;
                    if (phase == Phase.Answering && !busy && !timeUpHandled && step is { ClockStarted: true } && TimeLeft <= TimeSpan.Zero)
                    {
                        timeUpHandled = true;
                        await TimeUpAsync();
                    }
                    WarnTime();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Time's up: the session ends (an answer still being spoken is not handed in; answers are spoken, never typed).</summary>
    private async Task TimeUpAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user) return;
        // Under the typed-answer accommodation (GAD-T260) what is typed is handed in, as before GAD-T239 (the server then ends it).
        if (typedAnswers && step?.Verification is null && !string.IsNullOrWhiteSpace(typedAnswer))
        {
            await SubmitTypedAsync();
            return;
        }
        // A request about the last answer still open: the server judges that answer as recorded and flags it for a human.
        await RunStepAsync(ThinkingAbout.Finish, () => Sessions.EndAsync(org, SessionId, user, EndReason.TimeUp));
    }

    private static string Format(TimeSpan t) =>
        t.TotalHours >= 1 ? $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}" : $"{t.Minutes:00}:{t.Seconds:00}";

    public async ValueTask DisposeAsync()
    {
        stop.Cancel();
        DisposeReconnectWatch();
        await DisposeWindowWatchAsync();
        ticker?.Dispose();
        if (integrityModule is not null)
        {
            try
            {
                await integrityModule.InvokeVoidAsync("stop", true);
                await integrityModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException) { }
        }
        integrityRef?.Dispose();
        stop.Dispose();
    }
}

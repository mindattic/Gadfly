@page "/exam/{SessionId:guid}"
@attribute [Authorize(Policy = GadflyPolicies.Student)]
@implements IAsyncDisposable
@using Gadfly.Engine
@using Gadfly.Server.Data
@using Gadfly.Server.Integrity
@using Gadfly.Server.Sessions
@using Gadfly.Server.Student
@using Gadfly.Server.Verification
@using Gadfly.Sources
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject TimeProvider Clock
@inject SessionOrchestrator Sessions
@inject NavigationManager Nav
@inject ILogger<ExamRoom> Log
@inject IJSRuntime JS

<HeadContent><link rel="stylesheet" href="student.css" /></HeadContent>
<PageTitle>@(examTitle ?? "Exam") · Gadfly Exams</PageTitle>

<div class="exam-room">
    <header class="exam-head">
        <h1>@(examTitle ?? "Exam")</h1>
        @if (phase is Phase.Answering or Phase.Thinking && step is not null)
        {
            <div class="exam-status">
                <span class="timer @(TimeLeft <= TimeSpan.FromMinutes(2) ? "timer-low" : "")" role="timer" aria-live="off" title="Time left">@Format(TimeLeft)</span>
                <span class="progress-line">
                    Topics finished @step.ConceptsClosed of @step.ConceptsTotal
                    <progress max="@Math.Max(1, step.ConceptsTotal)" value="@step.ConceptsClosed" aria-hidden="true"></progress>
                </span>
            </div>
        }
    </header>
    <WebcamIntegrity SessionId="SessionId" />

    @if (integrity is { Level: not IntegrityLevel.Off } watched && phase is Phase.Answering or Phase.Thinking)
    {
        <div class="integrity-notice" role="note">
            <p>@IntegrityNotice(watched)</p>
            @if (watched.Level == IntegrityLevel.Strict && !fullscreen)
            {
                <button type="button" class="secondary small" @onclick="GoFullscreenAsync">Go full screen</button>
            }
        </div>
    }

    @switch (phase)
    {
        case Phase.Loading:
            <p class="hint">Loading your exam…</p>
            break;

        case Phase.NotFound:
            <p class="notice">That exam session isn't yours, or it no longer exists. <a href="my-exams">Back to my exams</a></p>
            break;

        case Phase.Thinking:
            <section class="panel wide exam-card" aria-busy="true">
                @if (step?.Question is { } asked && thinkingAbout == ThinkingAbout.Answer)
                {
                    <p class="hint">@step.ConceptTitle</p>
                    <p class="exam-question muted-question">@asked</p>
                }
                <div class="thinking" role="status">
                    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    @(thinkingAbout switch
                    {
                        ThinkingAbout.Answer => "Thinking about your answer…",
                        ThinkingAbout.Finish => "Submitting your exam…",
                        ThinkingAbout.Saving => "Saving…",
                        _ => "Preparing your question…",
                    })
                </div>
                <p class="hint">This can take a few seconds. Please keep this page open.</p>
            </section>
            break;

        case Phase.Answering:
            <section class="panel wide exam-card">
                @if (!string.IsNullOrWhiteSpace(step?.ConceptTitle))
                {
                    <p class="concept">@step.ConceptTitle</p>
                }
                <p class="exam-question" aria-live="polite">@step?.Question</p>
                @if (step?.Verification is { } v)
                {
                    @* One request at a time about the answer just given, before it is judged (GAD-T88). *@
                    <div class="verify" role="region" aria-labelledby="verify-title">
                        <p class="verify-label">Your answer, as recorded</p>
                        <blockquote class="recorded-answer">@v.RecordedText</blockquote>
                        @if (v.Kind == ResponseLedger.TranscriptKind)
                        {
                            <h2 id="verify-title" class="verify-title">Check the recording</h2>
                            <p class="verify-prompt" aria-live="polite">@v.Prompt</p>
                            <p class="hint">Confirming only says the recording matches what you said. It doesn't mean your answer is right or wrong.</p>
                            @if (verifyMode is VerifyMode.Correct or VerifyMode.Repeat)
                            {
                                <label>
                                    @(verifyMode == VerifyMode.Correct ? "Correct the recording" : "Say or type your answer again")
                                    <textarea rows="5" @bind="extraText" @bind:event="oninput" aria-describedby="correct-hint"></textarea>
                                </label>
                                <p id="correct-hint" class="hint">Your original recording is kept. Correcting a recording error never lowers your score.</p>
                                <div class="actions">
                                    <button type="button" disabled="@string.IsNullOrWhiteSpace(extraText)" @onclick="() => CorrectPendingAsync(verifyMode == VerifyMode.Repeat)">Save</button>
                                    <button type="button" class="secondary" @onclick="() => verifyMode = VerifyMode.None">Back</button>
                                </div>
                            }
                            else
                            {
                                <div class="actions">
                                    <button type="button" @onclick="() => ConfirmAsync(v)">Yes, this is what I said</button>
                                    <button type="button" class="secondary" @onclick="() => StartVerify(VerifyMode.Correct, v.RecordedText)">No, I want to correct it</button>
                                    <button type="button" class="secondary" @onclick="() => StartVerify(VerifyMode.Repeat, string.Empty)">Repeat my answer</button>
                                </div>
                            }
                        }
                        else
                        {
                            <h2 id="verify-title" class="verify-title">A quick clarification</h2>
                            <p class="verify-prompt" aria-live="polite">@v.Prompt</p>
                            <p class="hint">This only checks what you meant, so your answer is understood the way you intended. It doesn't mean your answer is right or wrong, and your answer stays exactly as you wrote it.</p>
                            @if (verifyMode == VerifyMode.Correct)
                            {
                                <label>
                                    Fix a typo in your answer
                                    <textarea rows="6" @bind="extraText" @bind:event="oninput" aria-describedby="typo-hint"></textarea>
                                </label>
                                <p id="typo-hint" class="hint">Small spelling fixes only. Your original answer is kept on record, and a typo fix never lowers your score.</p>
                                <div class="actions">
                                    <button type="button" disabled="@string.IsNullOrWhiteSpace(extraText)" @onclick="() => CorrectPendingAsync(false)">Save typo fix</button>
                                    <button type="button" class="secondary" @onclick="() => verifyMode = VerifyMode.None">Back</button>
                                </div>
                            }
                            else
                            {
                                <label>
                                    Your clarification
                                    <textarea id="clarify-box" rows="4" @bind="extraText" @bind:event="oninput" placeholder="In your own words…"></textarea>
                                </label>
                                <div class="actions">
                                    <button type="button" disabled="@string.IsNullOrWhiteSpace(extraText)" @onclick="() => ClarifyAsync(v, extraText)">Send clarification</button>
                                    <button type="button" class="secondary" @onclick="() => ClarifyAsync(v, null)">I'd rather not add anything</button>
                                    <button type="button" class="link" @onclick="() => StartVerify(VerifyMode.Correct, v.RecordedText)">Fix a typo in my answer instead</button>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <label>
                        Your answer
                        <textarea id="answer-box" rows="7" @bind="answer" @bind:event="oninput" @bind:after="OnTyped" @onkeydown="OnKeyDown"
                                  placeholder="Answer in your own words…" aria-describedby="answer-hint"></textarea>
                    </label>
                    <p id="answer-hint" class="hint">Ctrl+Enter submits.</p>
                    <div class="actions">
                        <button type="button" @onclick="SubmitAsync" disabled="@string.IsNullOrWhiteSpace(answer)">Submit answer</button>
                        <button type="button" class="secondary" @onclick="DontKnowAsync">I don't know</button>
                    </div>
                }
                @if (step?.Notice is { } note && error is null)
                {
                    <p class="ok" role="status">@note</p>
                }
                @if (error is not null && lastMode == LastMode.None)
                {
                    <p class="error" role="alert">@error</p>
                }
            </section>

            @if (step?.Verification is null && step?.LastAnswer is { } last && (last.CanCorrectTypo || last.CanRevise))
            {
                <section class="panel wide last-answer" aria-labelledby="last-title">
                    <p id="last-title" class="verify-label">Your last answer</p>
                    @if (lastMode == LastMode.Typo)
                    {
                        <p class="hint">Question: @last.Question</p>
                        <label>
                            Correct a typo in your last answer
                            <textarea rows="5" @bind="extraText" @bind:event="oninput" aria-describedby="last-typo-hint"></textarea>
                        </label>
                        <p id="last-typo-hint" class="hint">Small spelling fixes only. Your original answer stays on record, and a typo fix never lowers your score. To change what your answer says, use "I want to change my answer".</p>
                        <div class="actions">
                            <button type="button" disabled="@string.IsNullOrWhiteSpace(extraText)" @onclick="CorrectLastAsync">Save typo fix</button>
                            <button type="button" class="secondary" @onclick="CancelLast">Cancel</button>
                        </div>
                    }
                    else if (lastMode == LastMode.Revise)
                    {
                        <p class="hint">Question: @last.Question</p>
                        <blockquote class="recorded-answer">@last.Text</blockquote>
                        <p class="notice">@last.RevisionRule</p>
                        <label>
                            Your changed answer
                            <textarea rows="6" @bind="extraText" @bind:event="oninput"></textarea>
                        </label>
                        <div class="actions">
                            <button type="button" disabled="@string.IsNullOrWhiteSpace(extraText)" @onclick="ReviseLastAsync">Record my changed answer</button>
                            <button type="button" class="secondary" @onclick="CancelLast">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="actions">
                            @if (last.CanCorrectTypo)
                            {
                                <button type="button" class="link" @onclick="() => StartLast(LastMode.Typo, last.Text)">Correct a typo in my last answer</button>
                            }
                            @if (last.CanRevise)
                            {
                                <button type="button" class="link" @onclick="() => StartLast(LastMode.Revise, last.Text)">I want to change my answer</button>
                            }
                        </div>
                    }
                    @if (error is not null && lastMode != LastMode.None)
                    {
                        <p class="error" role="alert">@error</p>
                    }
                </section>
            }

            <section class="finish">
                @if (!confirmFinish)
                {
                    <button type="button" class="link" @onclick="() => confirmFinish = true">Finish and leave the exam</button>
                }
                else
                {
                    <div class="notice" role="alertdialog" aria-labelledby="finish-q">
                        <p id="finish-q"><strong>Finish the exam now?</strong> What you've answered so far is submitted and this attempt is used up. You can't come back to it.</p>
                        <div class="actions">
                            <button type="button" @onclick="FinishAsync">Yes, finish now</button>
                            <button type="button" class="secondary" @onclick="() => confirmFinish = false">Keep going</button>
                        </div>
                    </div>
                }
            </section>
            break;

        case Phase.Ended:
            <section class="panel wide exam-card">
                <h2>Your answers were submitted</h2>
                @if (endNote is not null)
                {
                    <p>@endNote</p>
                }
                <p>Your instructor will review your exam and release results. You'll see them on <a href="my-exams">My exams</a>.</p>
                <a class="button" href="my-exams">Back to my exams</a>
            </section>
            break;

        case Phase.Error:
            <section class="panel wide exam-card">
                <p class="error" role="alert">@error</p>
                <div class="actions">
                    <button type="button" @onclick="RetryAsync">Try again</button>
                    <a class="button secondary" href="my-exams">Back to my exams</a>
                </div>
            </section>
            break;
    }
</div>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private enum Phase { Loading, NotFound, Thinking, Answering, Ended, Error }
    private enum ThinkingAbout { Question, Answer, Finish, Saving }
    private enum VerifyMode { None, Correct, Repeat }
    private enum LastMode { None, Typo, Revise }

    private VerifyMode verifyMode;
    private LastMode lastMode;
    /// <summary>The text of whichever side box is open: a clarification, a correction or a changed answer.</summary>
    private string extraText = "";

    private Phase phase = Phase.Loading;
    private ThinkingAbout thinkingAbout;
    private SessionStep? step;
    private string? examTitle, error, endNote;
    private string answer = "";
    private DateTimeOffset? answerStartedAt;
    private DateTimeOffset deadline;
    private bool busy, confirmFinish, timeUpHandled;
    /// <summary>The answer to resend when a step failed partway (e.g. a panel call timed out).</summary>
    private string? pendingAnswer;

    private readonly CancellationTokenSource stop = new();
    private PeriodicTimer? ticker;

    private TimeSpan TimeLeft
    {
        get
        {
            var left = deadline - Clock.GetUtcNow();
            return left < TimeSpan.Zero ? TimeSpan.Zero : left;
        }
    }

    // Load only once interactive: the first step can call the panel, which must not run during prerender.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
        StateHasChanged();
        _ = TickAsync();
    }

    private async Task LoadAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user)
        {
            phase = Phase.NotFound;
            return;
        }
        var info = await StudentExams.SessionAsync(Scopes, org, user, SessionId);
        if (info is not { } s)
        {
            phase = Phase.NotFound;
            return;
        }
        examTitle = s.ExamTitle;
        switch (s.State)
        {
            case SessionState.Created:
                // Consent first.
                Nav.NavigateTo($"my-exams/{s.AssignmentId}/start");
                return;
            case SessionState.Ended:
                phase = Phase.Ended;
                return;
            case SessionState.Failed:
                phase = Phase.Error;
                error = "This exam session could not continue. Ask your instructor to reset it.";
                return;
        }
        if (!integrityStarted)
        {
            integrityStarted = true;
            _ = StartIntegrityAsync(org, user);
        }
        await RunStepAsync(ThinkingAbout.Question, () => Sessions.CurrentAsync(org, SessionId, user));
    }

    // ---------------------------------------------------------------- browser integrity signals (GAD-T56)

    private IntegritySettings? integrity;
    private IJSObjectReference? integrityModule;
    private DotNetObjectReference<ExamRoom>? integrityRef;
    private Guid integrityOrg, integrityUser;
    private bool fullscreen, integrityStarted;
    private TimeSpan? clientSkew;

    /// <summary>Loads the exam's integrity level and, unless it is Off, starts wwwroot/js/integrity.js. Never blocks the exam.</summary>
    private async Task StartIntegrityAsync(Guid org, Guid user)
    {
        try
        {
            await using (var scope = Scopes.CreateAsyncScopeFor(TenantSnapshot.ForOrganization(org)))
                integrity = await IntegrityRecorder.Create(scope.ServiceProvider).SettingsAsync(org, user, SessionId, stop.Token);
            if (integrity is not { Level: not IntegrityLevel.Off } settings) return;
            integrityOrg = org;
            integrityUser = user;
            integrityRef ??= DotNetObjectReference.Create(this);
            integrityModule = await JS.InvokeAsync<IJSObjectReference>("import", stop.Token, "./js/integrity.js");
            await integrityModule.InvokeAsync<bool>("start", stop.Token, integrityRef, new
            {
                sessionId = SessionId,
                level = settings.Level.ToString(),
                // Pastes matter where answers are typed; voice exams will block typing (ET voice mode).
                recordPaste = settings.Mode == ExamMode.Text,
            });
            fullscreen = await integrityModule.InvokeAsync<bool>("isFullscreen", stop.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            Log.LogDebug(ex, "Browser integrity signals did not start for session {SessionId}.", SessionId);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Browser integrity signals did not start for session {SessionId}.", SessionId);
        }
    }

    /// <summary>Called by integrity.js with a batch of signals. Returns false when the browser should stop sending.</summary>
    [JSInvokable]
    public async Task<bool> RecordIntegrity(BrowserSignalBatch batch)
    {
        if (integrityOrg == Guid.Empty || integrityUser == Guid.Empty || batch is null) return false;
        // The smallest clock offset seen on this connection is the best estimate (no queueing delay in it).
        if (IntegrityRecorder.ObservedSkew(batch, Clock.GetUtcNow()) is { } seen && (clientSkew is null || seen < clientSkew)) clientSkew = seen;
        try
        {
            bool keepGoing;
            await using (var scope = Scopes.CreateAsyncScopeFor(TenantSnapshot.ForOrganization(integrityOrg)))
                keepGoing = await IntegrityRecorder.Create(scope.ServiceProvider).RecordAsync(integrityOrg, integrityUser, SessionId, batch, clockSkew: clientSkew);
            if (fullscreen && batch.Events.Any(e => e.Type == "fullscreen-exit"))
            {
                fullscreen = false;
                await InvokeAsync(StateHasChanged);
            }
            return keepGoing;
        }
        catch (Exception ex)
        {
            // Never the student's problem: log and let the browser keep its queue moving.
            Log.LogWarning(ex, "Could not record browser integrity signals for session {SessionId}.", SessionId);
            return true;
        }
    }

    private async Task GoFullscreenAsync()
    {
        if (integrityModule is null) return;
        try { fullscreen = await integrityModule.InvokeAsync<bool>("enterFullscreen"); }
        catch (JSException) { fullscreen = false; }
    }

    /// <summary>What is noted, in the student's words: no surprise monitoring (matches the consent notice).</summary>
    private static string IntegrityNotice(IntegritySettings s)
    {
        var what = new List<string> { "switch to another tab or window" };
        if (s.Mode == ExamMode.Text) what.Add("paste into the answer box");
        what.Add("copy the question");
        if (s.Level == IntegrityLevel.Strict) what.AddRange(["leave full screen", "have more than one screen connected"]);
        var list = what.Count == 1 ? what[0] : string.Join(", ", what.Take(what.Count - 1)) + " or " + what[^1];
        return $"Integrity notes are on for this exam: if you {list}, the browser notes when and for how long, for your instructor to review. "
            + "They are notes, never an automatic fail, and nothing is blocked."
            + (s.Level == IntegrityLevel.Strict ? " Your browser may ask to allow screen detection; you can decline." : "");
    }

    /// <summary>Runs one orchestrator step with the thinking state shown, then shows its result.</summary>
    private async Task RunStepAsync(ThinkingAbout about, Func<Task<SessionStep>> run)
    {
        if (busy) return;
        busy = true;
        error = null;
        confirmFinish = false;
        thinkingAbout = about;
        var previous = phase;
        phase = Phase.Thinking;
        StateHasChanged();
        try
        {
            Apply(await run());
            pendingAnswer = null;
        }
        catch (SessionRefusedException ex)
        {
            error = ex.Message;
            phase = previous == Phase.Answering ? Phase.Answering : Phase.Error;
        }
        catch (Exception ex) when (ex is not OperationCanceledException || !stop.IsCancellationRequested)
        {
            Log.LogError(ex, "Exam room step failed for session {SessionId}.", SessionId);
            error = "Something went wrong on our side. Your progress is saved; press \"Try again\" to continue.";
            phase = Phase.Error;
        }
        finally
        {
            busy = false;
        }
    }

    private void Apply(SessionStep next)
    {
        step = next;
        deadline = Clock.GetUtcNow() + next.Remaining;
        if (next.State == SessionState.Ended || next.Question is null)
        {
            phase = Phase.Ended;
            endNote = next.EndReason switch
            {
                nameof(EndReason.TimeUp) => "Time ran out.",
                nameof(EndReason.Abandoned) => "You finished the exam early.",
                nameof(EndReason.Mastery) or nameof(EndReason.Aporia) or nameof(EndReason.TurnLimit) or nameof(EndReason.EvidenceComplete) =>"The examiner has finished asking questions.",
                _ => null,
            };
            return;
        }
        // A new request or question, or a completed action, closes the side boxes.
        if (next.Verification?.ResponseId != shownRequest || next.TurnIndex != shownTurn || next.Notice is not null)
        {
            verifyMode = VerifyMode.None;
            lastMode = LastMode.None;
            extraText = "";
            shownRequest = next.Verification?.ResponseId;
        }
        // A new question clears the answer box; the same question (a resume) keeps what was typed.
        if (next.TurnIndex != shownTurn)
        {
            answer = "";
            answerStartedAt = null;
            shownTurn = next.TurnIndex;
        }
        timeUpHandled = false;
        phase = Phase.Answering;
    }

    private int? shownTurn;
    private Guid? shownRequest;

    private void StartVerify(VerifyMode mode, string text)
    {
        verifyMode = mode;
        extraText = text;
        error = null;
    }

    private void StartLast(LastMode mode, string text)
    {
        lastMode = mode;
        extraText = mode == LastMode.Typo ? text : "";
        error = null;
    }

    private void CancelLast()
    {
        lastMode = LastMode.None;
        extraText = "";
        error = null;
    }

    private async Task VerifyStepAsync(ThinkingAbout about, Func<Guid, Guid, Task<SessionStep>> run)
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user) return;
        pendingAnswer = null;
        await RunStepAsync(about, () => run(org, user));
    }

    private Task ClarifyAsync(PendingVerification v, string? reply) =>
        VerifyStepAsync(ThinkingAbout.Answer, (org, user) => Sessions.ClarifyAsync(org, SessionId, user, v.ResponseId, reply?.Trim()));

    private Task ConfirmAsync(PendingVerification v) =>
        VerifyStepAsync(ThinkingAbout.Answer, (org, user) => Sessions.ConfirmTranscriptAsync(org, SessionId, user, v.ResponseId));

    private Task CorrectPendingAsync(bool repeat) =>
        VerifyStepAsync(ThinkingAbout.Answer, (org, user) => Sessions.CorrectAnswerAsync(org, SessionId, user, extraText.Trim(), repeat));

    private Task CorrectLastAsync() =>
        VerifyStepAsync(ThinkingAbout.Saving, (org, user) => Sessions.CorrectAnswerAsync(org, SessionId, user, extraText.Trim()));

    private Task ReviseLastAsync() =>
        VerifyStepAsync(ThinkingAbout.Saving, (org, user) => Sessions.ReviseAnswerAsync(org, SessionId, user, extraText.Trim()));

    private void OnTyped()
    {
        if (answerStartedAt is null && answer.Length > 0) answerStartedAt = Clock.GetUtcNow();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey) && !string.IsNullOrWhiteSpace(answer)) await SubmitAsync();
    }

    private Task SubmitAsync() => SendAsync(answer.Trim());

    private Task DontKnowAsync() => SendAsync(SourceExamEngine.AporiaWord);

    private async Task SendAsync(string text)
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user || string.IsNullOrWhiteSpace(text)) return;
        pendingAnswer = text;
        var submitted = new Answer
        {
            Text = text,
            Mode = "text",
            StartedAt = answerStartedAt,
            CompletedAt = Clock.GetUtcNow(),
        };
        await RunStepAsync(ThinkingAbout.Answer, () => Sessions.AnswerAsync(org, SessionId, user, submitted));
    }

    private async Task FinishAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user) return;
        await RunStepAsync(ThinkingAbout.Finish, () => Sessions.EndAsync(org, SessionId, user, EndReason.Abandoned));
    }

    private async Task RetryAsync()
    {
        if (pendingAnswer is { } text) await SendAsync(text);
        else await LoadAsync();
    }

    /// <summary>Ticks the countdown locally between steps; the server's Remaining resets it on every step.</summary>
    private async Task TickAsync()
    {
        ticker = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await ticker.WaitForNextTickAsync(stop.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (phase is not (Phase.Answering or Phase.Thinking)) return;
                    if (phase == Phase.Answering && !busy && !timeUpHandled && step is not null && TimeLeft <= TimeSpan.Zero)
                    {
                        timeUpHandled = true;
                        await TimeUpAsync();
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Time's up: hand in what's typed (the server then ends the session), or end it outright.</summary>
    private async Task TimeUpAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user) return;
        // A request about the last answer still open: the server judges that answer as recorded and flags it for a human.
        if (step?.Verification is not null) await RunStepAsync(ThinkingAbout.Finish, () => Sessions.EndAsync(org, SessionId, user, EndReason.TimeUp));
        else if (!string.IsNullOrWhiteSpace(answer)) await SendAsync(answer.Trim());
        else await RunStepAsync(ThinkingAbout.Finish, () => Sessions.EndAsync(org, SessionId, user, EndReason.TimeUp));
    }

    private static string Format(TimeSpan t) =>
        t.TotalHours >= 1 ? $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}" : $"{t.Minutes:00}:{t.Seconds:00}";

    public async ValueTask DisposeAsync()
    {
        stop.Cancel();
        ticker?.Dispose();
        if (integrityModule is not null)
        {
            try
            {
                await integrityModule.InvokeVoidAsync("stop", true);
                await integrityModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException) { }
        }
        integrityRef?.Dispose();
        stop.Dispose();
    }
}

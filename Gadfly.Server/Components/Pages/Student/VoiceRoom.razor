@implements IAsyncDisposable
@using Gadfly.Server.Voice
@using Gadfly.Server.Exams
@using Microsoft.EntityFrameworkCore
@inject IJSRuntime JS
@inject VoiceSettings Settings
@inject VoiceGrants Grants
@inject ITenantContext Tenant
@inject ILogger<VoiceRoom> Log
@inject IServiceScopeFactory Scopes
@inject TimeProvider Clock
@inject ExaminerSpeechWarmup Warmup
@inject Gadfly.Server.Diagnostics.VoiceRecognitionTimingRecorder RecognitionTimings
@inject Gadfly.Server.Sessions.SessionOrchestrator Sessions

@* The exam room's talking examiner (GAD-T53): the examiner speaks each question (<ma-avatar>, captions) and the student answers
   out loud with a live transcript. All browser work is in wwwroot/js/voice-room.js.
   The interview room (GAD-T231): the student's own camera with the examiner (picture in picture since GAD-T416), an on-screen transcript of every question and
   spoken answer, and each answer's response delay as it happens.
   Voice and camera are mandatory (GAD-T239): there is no typed answer mode. The examiner starts on its own when the page opens
   (no separate click), and while the microphone or camera is missing or lost the exam is paused here until it is restored.
   Typed answers (GAD-T260): for a student granted the typed-answer accommodation (TypedAnswers) the examiner and the camera run
   the same way, but no microphone is opened and the spoken-answer controls are hidden; the exam room shows the answer box. *@
<HeadContent><link rel="stylesheet" href="voice.css" /></HeadContent>

<section class="voice-room" aria-label="The examiner" data-state="@state.ToString().ToLowerInvariant()">
    @if (state == VoiceState.Off || state == VoiceState.Failed)
    {
        <div class="voice-offer">
            @if (Settings.Mode == VoiceMode.Mock)
            {
                <p class="notice" role="note">Practice voice: speech recognition is simulated here, so your words will appear as the placeholder "speech".</p>
            }
            @if (!supported)
            {
                <p class="error" role="alert">@(notice ?? "This browser can't run the spoken exam.")</p>
                <p class="hint">@(TypedAnswers ? "This exam needs a camera, and sound to hear the examiner." : "This exam is spoken and needs a microphone and a camera.") Use a current Chrome, Edge, Firefox or Safari on a secure connection, then reload this page.</p>
                @* GAD-T320: help appears only in these states, when the examiner is not on screen and no answer is being given, and
                   opens in a new tab so the exam page stays where it is. Never while the examiner is speaking or listening. *@
                <p class="hint"><HelpLink Topic="troubleshooting-browser" Label="Help with browsers and connections" /></p>
            }
            else if (state == VoiceState.Failed)
            {
                <p class="error" role="alert"><strong>@(needsClick ? "One click to go." : "The exam is paused.")</strong> @notice</p>
                <button type="button" data-voice-action="start">@(needsClick ? "Continue to the examiner" : "Try again")</button>
                <p class="hint">@(TypedAnswers ? "Your camera must stay on for the whole exam: you type your answers, and your camera shows you during the exam." : "Your microphone and camera must stay on for the whole exam: you answer the examiner out loud, and your camera shows you during the exam.") Once the first question has been asked, the clock stops while the exam is paused, for up to 10 minutes in all.</p>
                @if (!needsClick)
                {
                    @* The exam is paused here (the clock is stopped), so a help link opening in a new tab pulls no one away mid-answer. *@
                    <p class="hint">
                        @if (!TypedAnswers) { <HelpLink Topic="troubleshooting-microphone" Label="Microphone help" /> <text> · </text> }
                        <HelpLink Topic="troubleshooting-camera" Label="Camera help" />
                    </p>
                }
            }
            else
            {
                <p class="hint" role="status">@(TypedAnswers ? "Connecting you to the examiner… Your browser may ask to use your camera: allow it." : "Connecting you to the examiner… Your browser may ask to use your microphone and camera: allow both.")</p>
            }
        </div>
    }

    @* One screen, like a video call (GAD-T416, GAD-T501): the examiner's large 16:9 stage in the middle with the student's own camera
       as a small 16:9 inset in its bottom-right corner (kept away from her face, where the eye-contact check calibrates). The stage
       is sized by its width and aspect ratio alone (voice.css): the transcript to her left and the answer controls to her right sit
       outside it and scroll on their own, so nothing they hold can stretch her window. Below her on narrower screens. *@
    <div class="voice-interview" hidden="@(state is not (VoiceState.On or VoiceState.Starting))">
        <div class="voice-center">
            <div class="voice-pip">
                <figure class="voice-party voice-examiner">
                    <div class="voice-stage" data-voice-stage></div>
                    <figcaption>Examiner</figcaption>
                </figure>
                <figure class="voice-party voice-self" data-self-state="@selfState">
                    <div class="voice-self-frame">
                        <video data-voice-self muted playsinline autoplay aria-label="Your camera (only you see this)"></video>
                        @if (SelfNote is { } selfNote)
                        {
                            <p class="voice-self-note">@selfNote</p>
                        }
                    </div>
                    <figcaption>You</figcaption>
                </figure>
            </div>
            @if (state is VoiceState.Starting or VoiceState.On)
            {
                <p class="voice-caption" data-voice-caption aria-hidden="true"></p>
            }
        </div>

        @if (state is VoiceState.Starting or VoiceState.On)
        {
            @* The transcript scrolls inside its own panel (voice-room.js keeps the newest line in view); the page never grows. *@
            <section class="voice-transcript" aria-labelledby="voice-transcript-title">
                <h2 id="voice-transcript-title" class="verify-label">Transcript</h2>
                @if (transcript.Count == 0)
                {
                    <p class="hint">Each question and each answer you @(TypedAnswers ? "give" : "speak") will appear here as the interview goes.</p>
                }
                else
                {
                    @* Off, not polite: the question is already announced by the exam room, and the answer was just spoken. *@
                    <ol class="voice-log" role="log" aria-live="off" data-voice-transcript>
                        @foreach (var line in transcript)
                        {
                            <li @key="line.Id" class="voice-line @(line.Examiner ? "voice-line-examiner" : "voice-line-you")">
                                <span class="voice-who">@(line.Examiner ? "Examiner" : "You")</span>
                                <span class="voice-said">@line.Text</span>
                                @if (line.DelaySeconds is { } delay)
                                {
                                    <span class="voice-line-delay">Response delay: @FormatDelay(delay)</span>
                                }
                                @if (line.Voice is { } voice)
                                {
                                    <span class="voice-line-delay voice-line-strain">@voice</span>
                                }
                            </li>
                        }
                    </ol>
                }
            </section>
            <div class="voice-body">
                <p class="voice-status" role="status" aria-live="polite" data-voice-status>Connecting you to the examiner…</p>
                <p class="voice-delay" data-voice-delay data-state="idle" aria-live="off"></p>
                @if (!TypedAnswers)
                {
                    <div class="voice-level" data-voice-level aria-hidden="true"><i></i></div>
                }
                @if (avatarNote is not null)
                {
                    <p class="hint" role="note">@avatarNote</p>
                }
                @if (browserVoice)
                {
                    @* The voice provider stopped answering and the browser's own speech reads her lines (GAD-T328). *@
                    <p class="hint" role="status">The examiner's usual voice isn't responding right now, so your browser's own voice is reading the questions for her. Nothing is wrong with your exam, and every question is also shown on screen.</p>
                }
                @if (TypedAnswers)
                {
                    @* Typed answers (GAD-T260): the answer box is the exam room's; only the question can be repeated here. *@
                    <div class="actions voice-actions">
                        <button type="button" class="secondary" @onclick="RepeatAsync" disabled="@(!CanRepeat)">Repeat the question</button>
                    </div>
                }
                else
                {
                    <div class="voice-answer">
                        <p class="verify-label">What I heard</p>
                        @* A reload or a crash mid-answer keeps what was said as a draft (GAD-T306): filled in by voice-room.js,
                           never on its own a reason to submit anything. *@
                        <p class="hint voice-recovered" data-voice-recovered aria-live="polite"></p>
                        <p class="voice-draft" data-voice-draft aria-live="polite"></p>
                        <p class="voice-live" data-voice-live aria-live="off"></p>
                        <div class="voice-cue" data-voice-cue data-active="false" aria-hidden="true"><i></i></div>
                    </div>
                    <div class="actions voice-actions">
                        <button type="button" data-voice-action="done" data-voice-needs-draft disabled>Done answering</button>
                        <button type="button" class="secondary" data-voice-action="clear" data-voice-needs-draft disabled>Clear and answer again</button>
                        <button type="button" class="secondary" @onclick="RepeatAsync" disabled="@(!CanRepeat)">Repeat the question</button>
                        <button type="button" class="secondary" data-voice-action="mode">Switch to hold-to-talk</button>
                        <button type="button" class="secondary" data-voice-action="ptt" hidden>Hold to talk</button>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private enum VoiceState { Off, Starting, On, Failed }

    /// <summary>The exam session (already checked by the exam room to be this student's, and running).</summary>
    [Parameter, EditorRequired] public Guid SessionId { get; set; }
    /// <summary>Identifies the question being asked (a new value means a new question to speak).</summary>
    [Parameter] public int? TurnIndex { get; set; }
    [Parameter] public string? Question { get; set; }
    /// <summary>The kind of question (the planner's move): picks her speaking style from a fixed map that never hints at the grade (GAD-T303).</summary>
    [Parameter] public string? Move { get; set; }
    /// <summary>
    /// A pending meaning clarification about the last answer, spoken instead of the question. A spoken answer is never read back
    /// (GAD-T405): the exam room doesn't pass a transcript request here.
    /// </summary>
    [Parameter] public string? Prompt { get; set; }
    /// <summary>Stable identity of the pending request, so a changed prompt is spoken once.</summary>
    [Parameter] public Guid? PromptId { get; set; }
    /// <summary>True while an answer may be given by voice (a question or a request is waiting and nothing is being judged).</summary>
    [Parameter] public bool CanAnswer { get; set; }
    /// <summary>
    /// Staff paused the exam from the live monitor (GAD-T471): <see cref="CanAnswer"/> is false and the browser says why, keeps the
    /// words already said, and opens the microphone again once it is released.
    /// </summary>
    [Parameter] public bool HeldByStaff { get; set; }
    /// <summary>True while voice mode is on and typing the main answer is off.</summary>
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<bool> ActiveChanged { get; set; }
    /// <summary>
    /// A finished spoken answer; resolves to whether the exam room took it (GAD-T473). Not taken, the browser keeps the words and
    /// sends them again once this question can be answered. The exam room renders the result itself (this is not an EventCallback).
    /// </summary>
    [Parameter] public Func<VoiceAnswerPayload, Task<bool>>? OnAnswer { get; set; }
    /// <summary>The examiner is beginning to speak a question or request (the exam room starts the held clock on the first, GAD-T239).</summary>
    [Parameter] public EventCallback OnExaminerSpeaks { get; set; }
    /// <summary>
    /// The typed-answer accommodation (GAD-T260): no microphone, no spoken-answer controls; the examiner still speaks and the camera
    /// still runs. Read once, when the room starts.
    /// </summary>
    [Parameter] public bool TypedAnswers { get; set; }
    /// <summary>
    /// True while the panel judges an answer and the next question is written (GAD-T290): the examiner fills the wait with a
    /// short neutral line (<see cref="ExaminerFiller"/>) unless the next question is ready first.
    /// </summary>
    [Parameter] public bool Pondering { get; set; }

    private VoiceState state;
    private bool supported = true, armed, needsClick;
    private string? notice, avatarNote;
    /// <summary>The browser's own speech is reading her lines because the voice provider failed (GAD-T328).</summary>
    private bool browserVoice;
    private string? spokenKey;
    private bool lastAllowed, lastHeld;
    /// <summary>The last <see cref="Pondering"/> sent to the browser, and the last filler line said (the next one differs).</summary>
    private bool pondered;
    private string? lastFiller;
    /// <summary>The last acknowledgement handed to the browser (GAD-T496); the next one differs.</summary>
    private string? lastAck;
    /// <summary>The camera self-view, as voice-room.js reports it: starting, on, hidden, denied or unavailable.</summary>
    private string selfState = "starting";
    /// <summary>The interview so far: every question or request the examiner spoke and every answer spoken back (GAD-T231).</summary>
    private readonly List<TranscriptLine> transcript = [];
    private string? loggedKey;
    private int renderedLines;
    private IJSObjectReference? module;
    private DotNetObjectReference<VoiceRoom>? self;
    private Guid org, user;
    private readonly CancellationTokenSource stop = new();

    private sealed record TranscriptLine(int Id, bool Examiner, string Text, double? DelaySeconds, string? Voice = null);

    /// <summary>The longest response delay worth showing; anything longer is a clock problem, not a pause.</summary>
    private const double MaxDelaySeconds = 6 * 60 * 60;

    private string? SelfNote => selfState switch
    {
        "denied" => "The camera wasn't allowed.",
        "unavailable" => "No camera is available.",
        _ => null,
    };

    private static string FormatDelay(double seconds) => seconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + " s";

    /// <summary>The next transcript line's key: lines can be taken out again (an answer not taken, GAD-T473), so never the count.</summary>
    private int nextLineId;

    private TranscriptLine? AddLine(bool examiner, string text, double? delaySeconds, string? voice = null)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var line = new TranscriptLine(++nextLineId, examiner, text.Trim(), delaySeconds, voice);
        transcript.Add(line);
        return line;
    }

    /// <summary>
    /// The answer's voice against the student's own first spoken answers (GAD-T232), as the exam room will store it, in a short
    /// descriptive line for the student's transcript. Null when it can't be measured; never blocks the answer.
    /// </summary>
    private async Task<string?> VoiceLineAsync(VoiceAnswerPayload? payload)
    {
        if (payload?.Acoustics is null) return null;
        try
        {
            var built = VoiceAnswerBuilder.Build(payload, Clock.GetUtcNow());
            if (built is null) return null;
            await using var scope = Scopes.CreateAsyncScopeFor(TenantSnapshot.ForOrganization(org));
            var answer = await VoiceStrain.ApplyAsync(scope.ServiceProvider.GetRequiredService<Gadfly.Server.Data.GadflyDbContext>(), SessionId, built.Answer, stop.Token);
            return VoiceStrain.Describe(answer.SpeechMetrics)?.Brief;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogDebug(ex, "Voice strain line could not be computed for session {SessionId}.", SessionId);
            return null;
        }
    }

    private bool CanRepeat => state == VoiceState.On && !string.IsNullOrWhiteSpace(SpokenText);

    /// <summary>The prompt for a request, else the question.</summary>
    private string? SpokenText => Prompt is { Length: > 0 } p ? p : Question;

    /// <summary>
    /// The examiner's fixed lines, prepared once per server in the avatar's phrase cache so the first one a student hears starts at
    /// once (GAD-T303): the acknowledgements first, since one is said the moment every answer is in (GAD-T496), then the wait
    /// fillers (GAD-T329), then the eye-contact remarks.
    /// </summary>
    private IEnumerable<string> FixedLines() =>
        ExaminerFiller.Acknowledgements
            .Concat(Settings.BackchannelMs > 0 ? ExaminerFiller.Backchannels : [])
            .Concat(ExaminerFiller.First)
            .Concat(ExaminerFiller.Again)
            .Concat(Gadfly.Server.Integrity.WebcamIntegrityRecorder.ExaminerRemarks.Values);

    /// <summary>Her speaking style for what is being said: requests about an answer are always neutral, questions by their move.</summary>
    private string SpeakingStyle => Prompt is { Length: > 0 } ? ExaminerStyle.Neutral : ExaminerStyle.For(Move);

    protected override void OnInitialized()
    {
        if (Tenant.OrganizationId is { } o && Tenant.UserId is { } u)
        {
            org = o;
            user = u;
            Grants.Arm(user, org, SessionId);
            Warmup.Warm(FixedLines());
            armed = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            await ScrollTranscriptAsync();
            return;
        }
        if (!armed) return;
        // The import and the first call into it are bounded (GAD-T306), the same house style as the get-ready page's
        // own checks (StartExam.razor, GAD-T288): a stalled connection or a slow server shows a plain "taking too
        // long" message instead of a page that silently never finishes loading the examiner.
        using var startupBound = CancellationTokenSource.CreateLinkedTokenSource(stop.Token);
        startupBound.CancelAfter(TimeSpan.FromSeconds(20));
        try
        {
            var timeMultiplier = await TimeMultiplierAsync();
            var (cueFloorMs, cueCeilingMs) = Settings.EndCue(timeMultiplier);
            var (language, vocabulary) = await VocabularyAsync();
            Grants.SetVocabulary(user, SessionId, language, vocabulary);
            // The exam's voice, else the organization's default, else the platform's (GAD-T475): chosen here, enforced by VoiceHubFilter.
            if (await ExaminerVoiceAsync() is { } voice)
            {
                Grants.SetVoice(user, SessionId, voice);
                Warmup.Warm(FixedLines(), voice);
            }
            module = await JS.InvokeAsync<IJSObjectReference>("import", startupBound.Token, "./js/voice-room.js");
            self = DotNetObjectReference.Create(this);
            var caps = await module.InvokeAsync<Capabilities>("init", startupBound.Token, self, new
            {
                // The end-of-answer silence (GAD-T264): starts at the floor and adapts to the student's own pauses, up to the
                // ceiling; both are lengthened by the extra-time accommodation.
                endCueMs = cueFloorMs,
                endCueMaxMs = cueCeilingMs,
                // Endpointing (GAD-T498): the shorter silence after a finished sentence, and the speech detector's hangover (how
                // long a silence closes one stretch of speech and commits it to the recognizer).
                endCueCompleteMs = Settings.EndCueCompleteMs(timeMultiplier),
                hangoverMs = Settings.SpeechHangoverMs,
                // The listening "Mm-hm." after a finished sentence (GAD-T496); 0 is off.
                backchannelMs = Settings.BackchannelMs,
                modelUrl = Settings.AvatarModelUrl,
                portraitUrl = Settings.PortraitUrl,
                // Where the portrait's mouth is, so it can move while she speaks in portrait mode (GAD-T303).
                portraitMouth = Settings.PortraitMouth,
                // Typed answers (GAD-T260): the examiner and the camera without a microphone.
                typed = TypedAnswers,
                // Per-exam language and vocabulary hints (GAD-T357, GAD-T358): computed here, on the server, from the exam
                // itself; VoiceHubFilter refuses a StartSession call that asks for anything else.
                language,
                keyterms = vocabulary,
                // Keys the words-already-spoken draft kept across a reload or a crash (GAD-T306); never sent anywhere else.
                sessionId = SessionId.ToString("N"),
            });
            if (!caps.Microphone || !caps.AudioContext)
            {
                supported = false;
                notice = "This browser can't use the microphone and camera (it needs a current browser and a secure connection).";
                StateHasChanged();
                return;
            }
            // Begin exam goes straight into the talking examiner (GAD-T239): no separate click to start voice.
            await module.InvokeVoidAsync("autoStart", startupBound.Token);
        }
        catch (OperationCanceledException) when (!stop.IsCancellationRequested)
        {
            // The bound above tripped, not the room closing (GAD-T306): the module may never have loaded, so there is
            // nothing in place left to retry — a reload is the honest recovery, the same one every page here falls
            // back to, and it always re-syncs from the server's current state.
            supported = false;
            Log.LogWarning("The examiner took too long to start for session {SessionId}.", SessionId);
            notice = "That's taking too long. Check your internet connection, then reload this page to try again.";
            StateHasChanged();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException or ObjectDisposedException)
        {
            supported = false;
            Log.LogDebug(ex, "The examiner could not load for session {SessionId}.", SessionId);
            notice = "The examiner could not start in this browser.";
            StateHasChanged();
        }
    }

    /// <summary>
    /// The student's extra-time accommodation for this session's assignment (1 = none), which also lengthens the end-of-answer
    /// silence (GAD-T264). Falls back to 1 when it can't be read: the cue then keeps its configured length.
    /// </summary>
    private async Task<double> TimeMultiplierAsync()
    {
        try
        {
            await using var scope = Scopes.CreateAsyncScopeFor(TenantSnapshot.ForOrganization(org));
            var db = scope.ServiceProvider.GetRequiredService<Gadfly.Server.Data.GadflyDbContext>();
            var multiplier = await (from x in db.ExamSessions
                                    join a in db.ExamAssignments on x.AssignmentId equals a.Id
                                    where x.Id == SessionId && x.OrganizationId == org && a.OrganizationId == org
                                    select (decimal?)a.TimeMultiplier).FirstOrDefaultAsync(stop.Token);
            return (double)(multiplier ?? 1m);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogDebug(ex, "The extra-time accommodation could not be read for session {SessionId}.", SessionId);
            return 1;
        }
    }

    /// <summary>
    /// The exam's own spoken language and vocabulary (GAD-T357, GAD-T358), computed from the exam this session belongs to.
    /// Falls back to no language preference and no vocabulary hints when it can't be read: the recognizer then just
    /// detects the language and uses no keyterm hints, same as before this ticket.
    /// </summary>
    private async Task<(string? Language, IReadOnlyList<string> Vocabulary)> VocabularyAsync()
    {
        try
        {
            await using var scope = Scopes.CreateAsyncScopeFor(TenantSnapshot.ForOrganization(org));
            var db = scope.ServiceProvider.GetRequiredService<Gadfly.Server.Data.GadflyDbContext>();
            var examId = await db.ExamSessions.AsNoTracking()
                .Where(s => s.Id == SessionId && s.OrganizationId == org).Select(s => (Guid?)s.ExamId).FirstOrDefaultAsync(stop.Token);
            string? language = null;
            if (examId is { } id)
            {
                var policyJson = await db.Exams.AsNoTracking().Where(e => e.Id == id && e.OrganizationId == org)
                    .Select(e => e.PolicyJson).FirstOrDefaultAsync(stop.Token);
                language = ExamService.ReadPolicy(policyJson).Language;
            }
            var vocabulary = await VoiceVocabulary.ForSessionAsync(db, org, SessionId, stop.Token);
            return (language, vocabulary);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogDebug(ex, "The exam's language and vocabulary could not be read for session {SessionId}.", SessionId);
            return (null, []);
        }
    }

    /// <summary>This session's examiner voice id (GAD-T475), or null for the platform voice (always null outside live mode, or when
    /// it can't be read).</summary>
    private async Task<string?> ExaminerVoiceAsync()
    {
        if (Settings.Mode != VoiceMode.Live) return null;
        try
        {
            await using var scope = Scopes.CreateAsyncScopeFor(TenantSnapshot.ForOrganization(org));
            var db = scope.ServiceProvider.GetRequiredService<Gadfly.Server.Data.GadflyDbContext>();
            return await ExaminerVoice.ForSessionAsync(db, Settings.Mode, org, SessionId, Log, stop.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.LogDebug(ex, "The examiner voice could not be read for session {SessionId}; the platform voice is used.", SessionId);
            return null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (module is null || state != VoiceState.On) return;
        await SyncAsync();
    }

    /// <summary>Keeps the newest transcript line in view after a line was added.</summary>
    private async Task ScrollTranscriptAsync()
    {
        if (module is null || transcript.Count == renderedLines) return;
        renderedLines = transcript.Count;
        try { await module.InvokeVoidAsync("scrollTranscript", stop.Token); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException or ObjectDisposedException) { }
    }

    /// <summary>Speaks a new question or request once, and tells the browser whether an answer is wanted.</summary>
    private async Task SyncAsync()
    {
        var text = SpokenText;
        var key = $"{TurnIndex}|{PromptId}|{text}";
        try
        {
            var spoke = false;
            if (!string.IsNullOrWhiteSpace(text) && key != spokenKey)
            {
                spokenKey = key;
                spoke = true;
                // Into the transcript once; turning voice off and on doesn't repeat it.
                if (key != loggedKey)
                {
                    loggedKey = key;
                    AddLine(true, Prompt is { Length: > 0 } p ? p : Question ?? text, null);
                }
                await OnExaminerSpeaks.InvokeAsync();
                await SpeakAsync(text);
            }
            if (spoke || CanAnswer != lastAllowed || HeldByStaff != lastHeld)
            {
                // An answer window opens: the acknowledgement she says the moment that answer is in (GAD-T496) goes ahead now, so the
                // browser plays it without waiting on the server.
                if (CanAnswer && (spoke || !lastAllowed)) await OfferAcknowledgementAsync();
                lastAllowed = CanAnswer;
                lastHeld = HeldByStaff;
                await module!.InvokeVoidAsync("setAllowed", stop.Token, CanAnswer, HeldByStaff);
            }
            if (Pondering != pondered)
            {
                pondered = Pondering;
                if (pondered) await FillWaitAsync();
                else await module!.InvokeVoidAsync("endWait", stop.Token);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException or ObjectDisposedException)
        {
            Log.LogDebug(ex, "Voice prompt could not be sent to the browser.");
        }
    }

    /// <summary>
    /// Hands the browser this wait's filler lines (GAD-T290), offered to the avatar hub like any question. The browser says them only
    /// if the wait outlasts <see cref="ExaminerFiller.FirstAfter"/> (and the second after <see cref="ExaminerFiller.AgainAfter"/>), never
    /// with the microphone open; a question that arrives meanwhile is asked once the line has finished, and cancels the rest.
    /// </summary>
    private async Task FillWaitAsync()
    {
        var (first, again) = ExaminerFiller.Pick(Random.Shared, lastFiller);
        if (!Grants.Offer(user, SessionId, first)) return;
        lastFiller = first;
        var longWait = Grants.Offer(user, SessionId, again) ? again : null;
        await module!.InvokeVoidAsync("fillWait", stop.Token, first, longWait,
            ExaminerFiller.FirstAfter.TotalMilliseconds, ExaminerFiller.AgainAfter.TotalMilliseconds);
    }

    /// <summary>
    /// Offers the next acknowledgement (GAD-T496) and hands it to the browser, which says it the moment the answer is committed
    /// (unless she is already saying something). Never the same one twice running; fixed lines only, never text from the browser.
    /// </summary>
    private async Task OfferAcknowledgementAsync()
    {
        var ack = ExaminerFiller.PickAcknowledgement(Random.Shared, lastAck);
        if (!Grants.Offer(user, SessionId, ack)) return;
        lastAck = ack;
        await module!.InvokeVoidAsync("nextAcknowledgement", stop.Token, ack);
        if (Settings.BackchannelMs > 0)
            await module!.InvokeVoidAsync("backchannels", stop.Token, ExaminerFiller.Backchannels.Where(t => Grants.Offer(user, SessionId, t)).ToArray());
    }

    private async Task SpeakAsync(string text, bool repeat = false)
    {
        // The hub speaks only what the server offered for this student's own session.
        if (!Grants.Offer(user, SessionId, text)) return;
        // Cached by the avatar hub after its first playing, so "Repeat the question" and a reload replay at once (GAD-T303).
        // The turn index keys the words-already-spoken draft (GAD-T306): a new question starts a fresh one.
        await module!.InvokeVoidAsync("speak", stop.Token, text, true, SpeakingStyle, TurnIndex, repeat);
    }

    /// <summary>
    /// Says the question again. Pressed mid-answer, the words already said are kept as the draft for the same question and the
    /// microphone opens again on them once she has finished (GAD-T474).
    /// </summary>
    private async Task RepeatAsync()
    {
        if (SpokenText is { Length: > 0 } text && module is not null) await SpeakAsync(text, repeat: true);
    }

    private async Task StopVoiceAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("stop"); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
    }

    private async Task SetStateAsync(VoiceState next)
    {
        var wasActive = state == VoiceState.On;
        state = next;
        if (wasActive != (next == VoiceState.On)) await ActiveChanged.InvokeAsync(next == VoiceState.On);
        StateHasChanged();
    }

    // ----------------------------------------------------------------------------------- called by voice-room.js

    [JSInvokable]
    public Task OnVoiceStarting() => InvokeAsync(async () =>
    {
        notice = null;
        needsClick = false;
        avatarNote = null;
        browserVoice = false;
        selfState = "starting";
        await SetStateAsync(VoiceState.Starting);
    });

    [JSInvokable]
    public Task OnVoiceStarted(string vad) => InvokeAsync(async () =>
    {
        spokenKey = null;
        lastAllowed = false;
        lastHeld = false;
        pondered = false;
        await SetStateAsync(VoiceState.On);
        await SyncAsync();
    });

    [JSInvokable]
    public Task OnAvatarMode(string mode, string reason) => InvokeAsync(() =>
    {
        avatarNote = mode switch
        {
            "portrait" => "Showing the examiner's picture instead of the 3D head" + (reason switch
            {
                "no-webgl" => " because this browser has no 3D graphics.",
                "reduced-motion" => " because your device asks for reduced motion.",
                "no-src" => ".",
                "load-failed" => " because the 3D examiner could not load.",
                "slow-device" => " because this device can't draw the 3D examiner smoothly.",
                "graphics-lost" => " because the browser's 3D graphics stopped working.",
                _ => ".",
            }) + " Questions are still spoken and shown as text.",
            "none" => reason.Length > 0 ? reason : "The examiner's picture could not start; questions are shown as text.",
            _ => null,
        };
        StateHasChanged();
    });

    /// <summary>
    /// Who is reading the examiner's lines (GAD-T328): "browser" when the voice provider failed and the browser's own speech took
    /// over, "provider" when her usual voice is back. Shown as a short note, so a change in how she sounds is never a mystery.
    /// </summary>
    [JSInvokable]
    public Task OnExaminerVoice(string source) => InvokeAsync(() =>
    {
        var browser = source == "browser";
        if (browser == browserVoice) return;
        browserVoice = browser;
        if (browser) Log.LogInformation("The examiner's voice fell back to the browser's speech for session {SessionId}.", SessionId);
        StateHasChanged();
    });

    /// <summary>
    /// The browser could not start, or lost, the microphone, the camera or the examiner's connection: the exam pauses here and asks for it
    /// to be restored (GAD-T239). There is no typed fallback; "Try again" starts everything again and the examiner repeats the question.
    /// </summary>
    [JSInvokable]
    public Task OnVoiceProblem(string kind, string message, bool fatal) => InvokeAsync(async () =>
    {
        if (!fatal) return;
        Log.LogInformation("The examiner paused for session {SessionId}: {Kind}.", SessionId, kind);
        await StopVoiceAsync();
        needsClick = kind == "gesture";
        notice = kind switch
        {
            "gesture" => "Your browser needs one click before the examiner can speak.",
            "mic-denied" => "The microphone wasn't allowed. Allow the microphone for this site in your browser (the icon in the address bar), then press Try again.",
            "microphone" => "The microphone couldn't be opened. Check that it is plugged in and not used by another app, then press Try again.",
            "mic-lost" => "Your microphone stopped working. Plug it back in or allow it again, then press Try again.",
            "camera-denied" => "The camera wasn't allowed. Allow the camera for this site in your browser (the icon in the address bar), then press Try again.",
            "camera" => "No camera could be opened. Check that it is connected, uncovered and not used by another app, then press Try again.",
            "camera-lost" => "Your camera stopped working. Plug it back in or allow it again, then press Try again.",
            "hub" or "recognizer" => "The connection to the examiner was lost. Check your internet connection, then press Try again.",
            _ => "The examiner couldn't start. Press Try again; if it keeps failing, reload the page.",
        };
        await SetStateAsync(VoiceState.Failed);
    });

    [JSInvokable]
    public Task OnSelfView(string selfView) => InvokeAsync(() =>
    {
        if (selfView is not ("starting" or "on" or "hidden" or "denied" or "unavailable") || selfView == selfState) return;
        selfState = selfView;
        StateHasChanged();
    });

    /// <summary>
    /// A finished spoken answer from voice-room.js. Returns whether the exam room took it (GAD-T473): the browser clears the words and
    /// their reload draft only when it did, and otherwise keeps them to send again once the question can be answered.
    /// </summary>
    [JSInvokable]
    public async Task<bool> OnVoiceAnswer(VoiceAnswerPayload payload)
    {
        var taken = false;
        await InvokeAsync(async () =>
        {
            if (payload is null || OnAnswer is null) return;
            // The question it answers (GAD-T321): the one the browser heard asked, else the one shown when it arrived (the awaits
            // below can let the exam move on first). An answer kept and sent again (GAD-T473) still names its own question, so it can
            // never become the answer to the next one.
            payload.Turn ??= TurnIndex;
            // The words as heard, joined the way VoiceAnswerBuilder joins them; the delay is the one the student watched (display only).
            var said = string.Join(' ', payload.Segments.Select(s => (s.Text ?? "").Trim()).Where(t => t.Length > 0));
            var delay = payload.ResponseDelayMs is { } ms && double.IsFinite(ms) && ms >= 0 && ms / 1000 <= MaxDelaySeconds ? ms / 1000 : (double?)null;
            // Numbers and punctuation normalized for this on-screen line only (GAD-T360): the answer built from payload below
            // (VoiceAnswerBuilder.Build, in OnAnswer's handler) still uses the words exactly as the recognizer gave them. Added before
            // the answer is handed on, so it comes before the next question's line.
            var line = AddLine(false, TranscriptDisplay.ForDisplay(said), delay, await VoiceLineAsync(payload));
            StateHasChanged();
            // The answer a cut-off marker that follows belongs to (GAD-T462): set now, since the marker can arrive while it is judged.
            cutOffTurn = payload.Turn;
            taken = await OnAnswer(payload);
            if (taken)
            {
                RecordRecognitionDiagnostics(payload);
            }
            else
            {
                if (cutOffTurn == payload.Turn) cutOffTurn = null;   // nothing was recorded for a marker to belong to
                if (line is not null) transcript.Remove(line);   // kept in the browser and sent again later: it joins the transcript then
            }
            StateHasChanged();
        });
        return taken;
    }

    /// <summary>The turn whose spoken answer was sent last and not yet marked as cut off (GAD-T462); null once marked.</summary>
    private int? cutOffTurn;

    /// <summary>
    /// The end-of-answer silence closed the last answer and the student went on speaking <paramref name="delayMs"/> later
    /// (GAD-T462). Stored with that answer's speech metrics as a possible cut-off, once per answer; never audio, never part of a
    /// grade or of how the examiner probes. Best effort: a failure here never disturbs the exam.
    /// </summary>
    [JSInvokable]
    public async Task OnAnswerCutOff(double delayMs)
    {
        if (cutOffTurn is not { } turn || org == Guid.Empty || user == Guid.Empty) return;
        cutOffTurn = null;
        try { await AnswerCutOffRecorder.RecordAsync(Scopes, Sessions, org, user, SessionId, turn, delayMs, stop.Token); }
        catch (OperationCanceledException) { }   // the room closed
        catch (Exception ex)
        {
            Log.LogDebug(ex, "A possible answer cut-off could not be recorded for session {SessionId}.", SessionId);
        }
    }

    /// <summary>
    /// Recognizer latency and this answer's unsure-word share, into the in-memory status-page counters (GAD-T361).
    /// Rebuilds the answer once more with the library's own calculators (the same pure function <c>SessionOrchestrator</c>
    /// calls next): cheap, and keeps this diagnostic from depending on what the orchestrator decides to do with the answer.
    /// Best effort: a bad payload here never blocks the real answer from going through <see cref="OnAnswer"/>.
    /// </summary>
    private void RecordRecognitionDiagnostics(VoiceAnswerPayload? payload)
    {
        try
        {
            var built = VoiceAnswerBuilder.Build(payload, Clock.GetUtcNow());
            var wordCount = built?.Metrics.WordCount ?? 0;
            double? unsureShare = built is not null && wordCount > 0 ? (double)built.Verification.LowConfidenceWords.Count / wordCount : null;
            RecognitionTimings.Record(payload?.RecognizerLatenciesMs, unsureShare, wordCount);
        }
        catch (Exception ex)
        {
            Log.LogDebug(ex, "Recognizer diagnostics could not be recorded for session {SessionId}.", SessionId);
        }
    }

    /// <summary>
    /// The spoken answer just sent was turned away before it reached the exam (nothing usable to record) and the same question is
    /// still waiting (GAD-T316). The browser shut its microphone when it sent the answer and nothing else would open it again, so
    /// the student was told to say it again with no way to: this opens it for the same question.
    /// </summary>
    public async Task ListenAgainAsync()
    {
        if (module is null || state != VoiceState.On || !CanAnswer) return;
        try
        {
            await module.InvokeVoidAsync("setAllowed", stop.Token, true, false);
            lastAllowed = true;
            lastHeld = false;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException or ObjectDisposedException)
        {
            Log.LogDebug(ex, "The microphone could not be reopened for session {SessionId}.", SessionId);
        }
    }

    /// <summary>A typed answer was handed in (GAD-T260): it joins the on-screen transcript like a spoken one.</summary>
    public void NoteTypedAnswer(string text)
    {
        AddLine(false, text, null);
        StateHasChanged();
    }

    private sealed record Capabilities(bool Microphone, bool Webgl, bool AudioContext);

    public async ValueTask DisposeAsync()
    {
        stop.Cancel();
        if (armed) Grants.Disarm(user, SessionId);
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or ObjectDisposedException) { }
        }
        self?.Dispose();
        stop.Dispose();
    }
}

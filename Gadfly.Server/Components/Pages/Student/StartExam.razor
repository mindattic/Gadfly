@page "/my-exams/{AssignmentId:guid}/start"
@page "/my-exams/exam/{ExamId:guid}/start"
@inject IConfiguration Config
@attribute [Authorize(Policy = GadflyPolicies.Student)]
@implements IAsyncDisposable
@using Gadfly.Server.Data
@using Gadfly.Server.Localization
@using Gadfly.Server.Sessions
@using Gadfly.Server.Student
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject TimeProvider Clock
@inject SessionOrchestrator Sessions
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Gadfly.Server.Voice.VoiceSettings VoiceConfig
@inject UiText T
@inject IWebHostEnvironment Env
@inject Gadfly.Server.Voice.VoiceGrants Grants

@* The get-ready studio (GAD-T506): one screen with everything a student needs before the first question, in their language
   (GAD-T544): the camera, microphone and eye-tracking checks, a plain statement of what the camera is for, the eye-contact
   rules, the examiner's preview, a link to a free practice run, how the exam works, and the notice to agree to. Nothing on
   this page is graded or recorded. *@
<HeadContent><link rel="stylesheet" href="student.css" /><link rel="stylesheet" href="get-ready.css" /></HeadContent>
<PageTitle>@T["getReady.pageTitle"]</PageTitle>
@* The text the page's scripts write (the microphone test, the eye-tracking setup, the examiner preview), in this language. *@
<UiTextData Prefix="getReady.js." />

@if (loading)
{
    <h1>@T["getReady.heading"]</h1>
    <p class="hint" role="status">@T["common.loading"]</p>
}
else if (assignment is null)
{
    <h1>@T["getReady.heading"]</h1>
    <p class="notice">@T["getReady.notAssigned"] <a href="my-exams">@T["getReady.backToMyExams"]</a></p>
}
else
{
    @if (assignment.CanStart && !assignment.CanResumeDirectly)
    {
        @* The tour only points at the page: it never opens or touches the camera, microphone or system check (GAD-T341). *@
        <Tour Id="@Tours.TourIds.GetReady" Float="true" />
    }
    <h1>@assignment.ExamTitle <span>· @T["getReady.titleSuffix"]</span> <HelpLink Topic="student-guide" Anchor="the-get-ready-page" /></h1>

    @if (assignment.CanResumeDirectly)
    {
        <p class="notice">@T["getReady.inProgress"] <a class="button" href="exam/@assignment.ActiveSessionId">@T["getReady.resume"]</a></p>
    }
    else if (!assignment.CanStart)
    {
        <p class="notice">@T["getReady.cantStart", T.IsEnglish ? StudentExams.Describe(assignment.Standing, T).ToLowerInvariant() : StudentExams.Describe(assignment.Standing, T)] <a href="my-exams">@T["getReady.backToMyExams"]</a></p>
    }
    else
    {
        <p class="hint ready-intro">@T["getReady.intro"]</p>
        <ol class="steps" data-tour="ready-steps">
            <li class="@(spoken.Count > 0 ? "done" : "")">@T["getReady.step.language"]</li>
            <li class="@(Done(1) ? "done" : "")">@T["getReady.step.check"]</li>
            <li class="@(Done(2) ? "done" : "")">@T["getReady.step.examiner"]</li>
            <li class="@(Done(3) ? "done" : "")">@T["getReady.step.how"]</li>
            <li class="@(Done(4) ? "done" : "")">@T["getReady.step.consent"]</li>
        </ol>

        <section class="panel wide language-panel" data-tour="ready-language" aria-labelledby="ready-language-title">
            @* The language questions (GAD-T552): asked, never inferred; prefilled from the saved profile; saved when the exam begins. *@
            <h2 id="ready-language-title">@T["getReady.language.title"]</h2>
            <p class="hint">@T["getReady.language.why"]</p>
            <fieldset>
                <legend>@T["getReady.language.spoken"]</legend>
                <div class="language-options">
                    @foreach (var l in StudentLanguages.Choices)
                    {
                        <label lang="@l.Tag">
                            <input type="checkbox" checked="@spoken.Contains(l.Tag)" @onchange="e => ToggleSpoken(l.Tag, e)" />
                            @l.NativeName
                        </label>
                    }
                </div>
            </fieldset>
            <label class="language-primary">
                @T["getReady.language.primary"]
                <select @bind="primary" @bind:after="OnPrimaryChanged">
                    @foreach (var l in StudentLanguages.Choices.Where(c => spoken.Count == 0 || spoken.Contains(c.Tag)))
                    {
                        <option value="@l.Tag" lang="@l.Tag">@l.NativeName</option>
                    }
                </select>
            </label>
            <p class="hint">@T["getReady.language.editable"]</p>
            @* The exam language (GAD-T546): only languages this exam is offered in. Choosing one switches this page, the rules, the
               notice and the examiner's preview to it at once; it is fixed for the attempt when the exam begins. *@
            @if (offered.Count > 1)
            {
                <fieldset class="exam-language">
                    <legend>@T["getReady.language.exam"]</legend>
                    <div class="language-options">
                        @foreach (var l in offered)
                        {
                            <label lang="@l">
                                <input type="radio" name="exam-language" value="@l" checked="@(l == examLanguage)" @onchange="() => ChooseExamLanguageAsync(l)" />
                                @StudentLanguages.NativeName(l)
                            </label>
                        }
                    </div>
                </fieldset>
                <p class="hint exam-language-lock">@T["getReady.language.lock"]</p>
            }
            else
            {
                <p class="exam-language-lock">@T["getReady.language.only"] <span lang="@examLanguage">@StudentLanguages.NativeName(examLanguage)</span></p>
            }
            @* Voice calibration (GAD-T594): optional, short, redoable. The student reads a known sentence three times through the real
               recognizer in that language; only derived numbers are stored on their language profile, never audio or words. *@
            @if (VoiceConfig.Available && !TypedAnswers)
            {
                <details class="calibration" open="@(!CalibrationOptional || calibrating is not null)">
                    <summary>@(CalibrationOptional ? T["getReady.calibration.summaryOptional"] : T["getReady.calibration.summary"])</summary>
                    <p class="hint">@T["getReady.calibration.why"]</p>
                    @if (calibrating is { } lang)
                    {
                        var text = StudentLanguages.CalibrationFor(lang);
                        <p>@T["getReady.calibration.readThis"]</p>
                        <p class="calibration-text" lang="@lang">@text.Text</p>
                        <div class="calibration-progress" aria-hidden="true">
                            @for (var i = 0; i < StudentLanguages.CalibrationReadings; i++)
                            {
                                <i class="@(i < calibrationDone ? "done" : "")"></i>
                            }
                        </div>
                        <div class="syscheck-level" @ref="calibrationLevel" aria-hidden="true"><i></i></div>
                        <p role="status">@T[calibrationStatus, calibrationDone + 1, StudentLanguages.CalibrationReadings]</p>
                        <div class="actions"><button type="button" class="secondary" @onclick="StopCalibrationAsync">@T["getReady.calibration.stop"]</button></div>
                    }
                    else
                    {
                        @if (calibrationStatus is not "getReady.calibration.reading" and not "")
                        {
                            <p role="status">@T[calibrationStatus]</p>
                        }
                        <div class="actions">
                            @foreach (var l in CalibrationLanguages)
                            {
                                <button type="button" class="secondary" @onclick="() => CalibrateAsync(l)" disabled="@(microphone != "ok")">
                                    @(calibrated.Contains(l) ? T["getReady.calibration.redo", StudentLanguages.NativeName(l)] : T["getReady.calibration.start", StudentLanguages.NativeName(l)])
                                </button>
                            }
                        </div>
                        @if (microphone != "ok")
                        {
                            <p class="hint">@T["getReady.calibration.waitMic"]</p>
                        }
                    }
                </details>
            }
        </section>

        <section class="panel wide" data-tour="ready-check" aria-labelledby="ready-check-title">
            <h2 id="ready-check-title">@T["getReady.check.title"]</h2>
            @if (checks is null)
            {
                <p class="hint">@T["getReady.check.checking"]</p>
            }
            else
            {
                @* Voice and camera are mandatory (GAD-T239): the camera preview and the microphone meter prove both work. The preview
                   is also where the student checks their framing and lighting: the exam room itself doesn't show it (GAD-T510). *@
                <div class="syscheck-media">
                    <video @ref="preview" class="syscheck-camera" muted playsinline autoplay aria-label="@T["getReady.check.cameraPreview"]"></video>
                    <div class="syscheck-level" @ref="meter" aria-hidden="true"><i></i></div>
                </div>
                @* Choose the camera and microphone (GAD-T593): switching reopens the preview and the meter on that device, and the
                   choice is remembered on this device for the exam room (js/device-prefs.js). *@
                <div class="device-pickers">
                    <label>
                        @T["getReady.devices.camera"]
                        <select @onchange="e => ChooseDeviceAsync(DeviceKind.Camera, e)" disabled="@(cameras.Count == 0)">
                            @if (cameras.Count == 0) { <option>@T["getReady.devices.default"]</option> }
                            @foreach (var d in cameras)
                            {
                                <option value="@d.Id" selected="@d.Selected">@(string.IsNullOrWhiteSpace(d.Label) ? T["getReady.devices.unnamedCamera", d.Index].Value : d.Label)</option>
                            }
                        </select>
                    </label>
                    @if (!TypedAnswers)
                    {
                        <label>
                            @T["getReady.devices.microphone"]
                            <select @onchange="e => ChooseDeviceAsync(DeviceKind.Microphone, e)" disabled="@(microphones.Count == 0)">
                                @if (microphones.Count == 0) { <option>@T["getReady.devices.default"]</option> }
                                @foreach (var d in microphones)
                                {
                                    <option value="@d.Id" selected="@d.Selected">@(string.IsNullOrWhiteSpace(d.Label) ? T["getReady.devices.unnamedMicrophone", d.Index].Value : d.Label)</option>
                                }
                            </select>
                        </label>
                    }
                </div>
                <p class="hint">@T["getReady.devices.hint"]</p>
                @* Microphone test (GAD-T359): noise floor, clipping and an echo hint, filled by js/mic-check.js once the
                   microphone is open. Advice only, like the eye-tracking panel below; never blocks Begin exam. *@
                @if (!TypedAnswers)
                {
                    <p class="hint mic-check" data-mic-check></p>
                }
                <ul class="syschecks">
                    @foreach (var c in AllChecks)
                    {
                        <li class="syscheck syscheck-@c.Status.ToString().ToLowerInvariant()">
                            <span class="syscheck-mark" aria-hidden="true">@Mark(c.Status)</span>
                            <div>
                                <strong>@c.Name</strong> — @c.Result
                                @if (c.Fix is not null)
                                {
                                    <div class="hint">@c.Fix</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
                <button type="button" class="secondary" @onclick="RunChecksAsync" disabled="@checking">@T["getReady.check.again"]</button>
                @if (!ChecksPass)
                {
                    <p class="error" role="status">@T["getReady.check.blocked"]</p>
                }
                @* What the camera is for, in plain words (GAD-T506, research note attention-and-gaze 3.5 and 4.3): being watched is the
                   larger stressor, so the page says what the camera checks and that it never grades or decides. *@
                <div class="camera-promise" role="note">
                    <h3>@T["getReady.camera.title"]</h3>
                    <p>@T["getReady.camera.checks"]</p>
                    <p><strong>@T["getReady.camera.never"]</strong></p>
                </div>
                @* Eye-tracking setup advice and calibration (GAD-T305): filled by js/gaze-quality.js once the camera shows a picture; never blocks Begin exam. *@
                @if (assignment.Integrity != IntegrityLevel.Off)
                {
                    <div class="gaze-quality" data-gaze-quality></div>
                }
            }
        </section>

        <section class="panel wide" aria-labelledby="ready-eyes-title">
            @* The eye-contact rules, warmly (GAD-T506; research note attention-and-gaze 4.1 and 4.2): looking away to think is normal
               and helps; reminders only on a long look away from the screen while answering, from the examiner first, never on the grade. *@
            <h2 id="ready-eyes-title">@T["getReady.eyes.title"]</h2>
            <ul class="ready-rules">
                <li>@Ex("getReady.eyes.look")</li>
                <li><strong>@T["getReady.eyes.thinkingOk"]</strong> @T["getReady.eyes.thinkingWhy"]</li>
                <li>@T["getReady.eyes.reminder"]</li>
                <li>@T["getReady.eyes.neverGrade"]</li>
            </ul>
            @if (assignment.Integrity == IntegrityLevel.Off)
            {
                <p class="hint">@T["getReady.eyes.off"]</p>
            }
        </section>

        <section class="panel wide examiner-preview" data-tour="ready-examiner" aria-labelledby="ready-examiner-title">
            <h2 id="ready-examiner-title">@T["getReady.examiner.title"]</h2>
            @* Choose the examiner (GAD-T595): from the examiner catalog, remembered on this device for the exam room. No choice when
               the exam or organization fixes the examiner (GAD-T504). *@
            @if (examiners.Count > 1)
            {
            <fieldset class="examiner-choices">
                <legend class="visually-hidden">@T["getReady.examiner.choose"]</legend>
                @foreach (var x in examiners)
                {
                    <label class="examiner-choice" aria-disabled="@(x.Available ? null : "true")">
                        <input type="radio" name="examiner" value="@x.Id" checked="@(x.Id == examiner.Id)" disabled="@(!x.Available)"
                               @onchange="() => ChooseExaminerAsync(x)" />
                        @if (x.Available)
                        {
                            <img src="@x.PortraitUrl" alt="" />
                        }
                        <span>@T[x.NameKey]@(x.Available ? "" : " " + T["getReady.examiner.comingSoon"].Value)</span>
                    </label>
                }
            </fieldset>
            }
            <div class="examiner-preview-row">
                @* The portrait shows the student's choices (GAD-T663): the framing, a tint over the clothing, and small skin and hair dots. *@
                <div class="examiner-preview-figure look-@(customization.Look ?? ExaminerCustomization.Looks[0])">
                    <img class="examiner-preview-portrait" src="@examiner.PortraitUrl" alt="@T["getReady.examiner.portraitAlt"]" />
                    @if (customization.Attire is { } attire)
                    {
                        <span class="examiner-attire-band" data-attire="@attire" aria-hidden="true"></span>
                    }
                    @if (customization.SkinTone is not null || customization.Hair is not null)
                    {
                        <span class="examiner-look-dots" aria-hidden="true">
                            @if (customization.SkinTone is { } skin) { <i data-skin="@skin"></i> }
                            @if (customization.Hair is { } hair) { <i data-hair="@hair"></i> }
                        </span>
                    }
                </div>
                <div class="examiner-preview-body">
                    <p>@Ex("getReady.examiner.intro")</p>
                    <p class="examiner-preview-caption" @ref="previewCaption" aria-live="polite">@T["getReady.examiner.line"]</p>
                    <div class="actions">
                        <button type="button" class="secondary" @onclick="PlayPreviewAsync">@Ex("getReady.examiner.play")</button>
                    </div>
                    @if (previewSilent)
                    {
                        <p class="hint" role="status">@Ex("getReady.examiner.noSpeech")</p>
                    }
                    <p class="hint">@Ex("getReady.examiner.voiceNote")</p>
                </div>
            </div>
            @* Make the examiner your own (GAD-T663, GAD-T646): bounded choices only, remembered on this device with the examiner. None
               when the exam or organization fixes the examiner: then it is shown exactly as configured. *@
            @if (!examinerFixed)
            {
                <section class="examiner-customize" aria-labelledby="ready-customize-title">
                    <h3 id="ready-customize-title">@T["examRoom.customize.title"]</h3>
                    <p class="hint">@T["examRoom.customize.hint"]</p>
                    <label class="customize-voice">
                        @T["examRoom.customize.voice"]
                        <select @onchange="ChooseVoiceAsync">
                            <option value="" selected="@(customization.Voice is null)">@T["examRoom.customize.voice.own"]</option>
                            @foreach (var v in VoiceChoices)
                            {
                                <option value="@v" selected="@(v == customization.Voice)">@VoiceName(v)</option>
                            }
                        </select>
                    </label>
                    <p class="hint">@T["examRoom.customize.voice.previewNote"]</p>
                    @Swatches("skin", ExaminerCustomization.SkinTones, customization.SkinTone, v => customization with { SkinTone = v })
                    @Swatches("hair", ExaminerCustomization.HairColours, customization.Hair, v => customization with { Hair = v })
                    @Swatches("attire", ExaminerCustomization.Attires, customization.Attire, v => customization with { Attire = v })
                    <fieldset class="customize-group customize-looks">
                        <legend>@T["examRoom.customize.look"]</legend>
                        <div class="segmented">
                            @foreach (var l in ExaminerCustomization.Looks)
                            {
                                <label>
                                    <input type="radio" name="examiner-look" value="@l" checked="@(l == (customization.Look ?? ExaminerCustomization.Looks[0]))"
                                           @onchange="() => CustomizeAsync(customization with { Look = l })" />
                                    <span>@T[$"examRoom.customize.look.{l}"]</span>
                                </label>
                            }
                        </div>
                    </fieldset>
                    <div class="actions">
                        <button type="button" class="secondary" @onclick="() => CustomizeAsync(ExaminerCustomization.None)" disabled="@customization.IsEmpty">@T["examRoom.customize.reset"]</button>
                    </div>
                </section>
            }
            @* A full practice run with the same examiner (GAD-T560): the best-supported way to feel calm on the day. *@
            <p class="practice-link">@T["getReady.practiceRun.lead"] <a href="my-exams/practice?assignment=@AssignmentId">@T["getReady.practiceRun.link"]</a></p>
        </section>

        <section class="panel wide" aria-labelledby="ready-how-title">
            <h2 id="ready-how-title">@T["getReady.how.title"]</h2>
            <p>@T["getReady.how.intro"]</p>
            <details class="science">
                <summary>@T["getReady.science.summary"]</summary>
                <p>@T["getReady.science.p1"]</p>
                <p><strong>@T["getReady.science.whyTitle"]</strong> @T["getReady.science.why"]</p>
                <p><strong>@T["getReady.science.limitsTitle"]</strong></p>
                <ul>
                    <li>@T["getReady.science.limit1"]</li>
                    <li>@T["getReady.science.limit2"]</li>
                    <li>@T["getReady.science.limit3"]</li>
                    <li>@T["getReady.science.limit4"]</li>
                    <li>@T["getReady.science.limit5"]</li>
                </ul>
                <p class="hint">@T["getReady.science.refs"]</p>
            </details>
            <ul>
                @if (assignment.TypedAnswers)
                {
                    @* Typed-answer accommodation (GAD-T260): granted by an instructor or admin, never chosen here. *@
                    <li>@T["getReady.rules.typed"]</li>
                    <li>@T["getReady.rules.typedOwnWords"]</li>
                }
                else
                {
                    <li>@T["getReady.rules.spoken"]</li>
                }
                <li>@T["getReady.rules.clock"]</li>
                <li>@T["getReady.rules.ownWords"]</li>
                <li>@T["getReady.rules.dontKnow"]</li>
                <li>@T["getReady.rules.reload"]</li>
                <li>@T["getReady.rules.scores"]</li>
            </ul>
            <div class="practice" data-tour="ready-practice">
                <h3>@T["getReady.try.title"]</h3>
                <p class="question">@T["getReady.try.question"]</p>
                @if (practiceFollowUp is null)
                {
                    @if (assignment.TypedAnswers)
                    {
                        @* Typed, like this student's exam (GAD-T260): nothing is recorded or sent. *@
                        <p class="hint">@T["getReady.try.typedHint"]</p>
                        <label>
                            @T["getReady.try.typedLabel"]
                            <textarea rows="3" @bind="practiceText" @bind:event="oninput" placeholder="@T["getReady.try.placeholder"]"></textarea>
                        </label>
                    }
                    else
                    {
                        @* Spoken, like the exam (GAD-T239): nothing is recorded; the button waits until the microphone has heard you. *@
                        <p class="hint">@T["getReady.try.spokenHint"]</p>
                    }
                    <div class="actions">
                        <button type="button" @onclick="PracticeAnswer" disabled="@(assignment.TypedAnswers ? string.IsNullOrWhiteSpace(practiceText) : microphone != "ok")">@(assignment.TypedAnswers ? T["getReady.try.typedDone"] : T["getReady.try.spokenDone"])</button>
                        <button type="button" class="secondary" @onclick="PracticeDontKnow">@T["getReady.try.dontKnow"]</button>
                    </div>
                    @if (microphone != "ok" && !assignment.TypedAnswers)
                    {
                        <p class="hint">@T["getReady.try.waitMic"]</p>
                    }
                }
                else
                {
                    <p class="question">@T[practiceFollowUp]</p>
                    <p class="hint">@T[practiceExplain!]</p>
                    <button type="button" class="link" @onclick="ResetPractice">@T["getReady.try.again"]</button>
                }
            </div>
        </section>

        <section class="panel wide" data-tour="ready-consent" aria-labelledby="ready-consent-title">
            <h2 id="ready-consent-title">@notice!.Title</h2>
            @foreach (var p in notice.Paragraphs)
            {
                <p>@p</p>
            }
            <label class="inline">
                <input type="checkbox" @bind="agreed" />
                @T["getReady.consent.agree"]
            </label>
            @* The optional research question (GAD-T452): separate from the notice above and never needed to begin. *@
            <ResearchConsentPanel @ref="research" AssignmentId="AssignmentId" />
            <button type="button" @onclick="BeginAsync" disabled="@(!agreed || !ChecksPass || starting)">
                @(starting ? T["getReady.begin.starting"] : assignment.ActiveSessionId is null ? T["getReady.begin.begin"] : T["getReady.begin.continue"])
            </button>
            @if (error is not null)
            {
                <p class="error" role="alert">@error</p>
            }
        </section>
    }
}

@code {
    [Parameter] public Guid AssignmentId { get; set; }
    /// <summary>Set on the start-by-exam route (GAD-T669), which redirects to the assignment's own get-ready page.</summary>
    [Parameter] public Guid? ExamId { get; set; }

    private enum CheckStatus { Pass, Warn, Fail, Later }
    private sealed record Check(string Name, CheckStatus Status, string Result, string? Fix = null);

    private sealed class BrowserReport
    {
        public string UserAgent { get; set; } = "";
        public bool WebSocket { get; set; }
        public bool Cookies { get; set; }
        public bool Online { get; set; }
        public bool SecureContext { get; set; }
        public bool SpeechRecognition { get; set; }
        public bool MediaDevices { get; set; }
        public int ScreenWidth { get; set; }
    }

    /// <summary>One browser check's outcome, as keys: rendered in the page's language each time, so a language switch relabels it.</summary>
    private sealed record CheckKeys(string Name, CheckStatus Status, string Result, string? Fix = null, object[]? Args = null);

    private bool loading = true, checking, agreed, starting, mediaStarted, previewSilent;
    private ElementReference preview, meter, previewCaption;
    private DotNetObjectReference<StartExam>? self;
    /// <summary>The microphone and camera as system-check.js reports them: waiting, listening, ok, denied, missing, busy, lost, unsupported or error.</summary>
    private string microphone = "waiting", camera = "waiting";
    private StudentAssignmentView? assignment;
    private ConsentNotice? notice;
    private string? orgName;
    private int retentionDays;
    private ResearchConsentPanel? research;
    private List<CheckKeys>? checks;
    private string? clientInfo, error;
    private IJSObjectReference? module, previewModule;

    /// <summary>The practice exchange's follow-up and explanation, as keys.</summary>
    private string? practiceFollowUp, practiceExplain;

    /// <summary>Every check must pass (a warning is fine): a check still waiting, like a microphone not yet heard, keeps Begin exam off.</summary>
    private bool ChecksPass => checks is not null && AllChecks.All(c => c.Status is CheckStatus.Pass or CheckStatus.Warn);

    /// <summary>The microphone is checked only for spoken answers: a student granted typed answers (GAD-T260) needs only the camera.</summary>
    private IEnumerable<Check> AllChecks => (checks ?? []).Select(Render)
        .Concat(TypedAnswers ? new[] { CameraCheck } : new[] { MicrophoneCheck, CameraCheck });

    private Check Render(CheckKeys k) => new(T[k.Name].Value, k.Status,
        (k.Args is null ? T[k.Result] : T[k.Result, k.Args]).Value, k.Fix is null ? null : (k.Args is null ? T[k.Fix] : T[k.Fix, k.Args]).Value);

    /// <summary>The typed-answer accommodation on this assignment (GAD-T260), granted by an instructor or admin.</summary>
    private bool TypedAnswers => assignment?.TypedAnswers == true;

    /// <summary>The typed practice answer (GAD-T260): never recorded or sent anywhere.</summary>
    private string practiceText = "";

    private Check Device(string device, CheckStatus status, string result, string? fix = null) =>
        new(T[$"getReady.check.{device}"].Value, status, T[$"getReady.check.{result}"].Value, fix is null ? null : T[$"getReady.check.{device}.fix.{fix}"].Value);

    private Check MicrophoneCheck => microphone switch
    {
        "ok" => Device("microphone", CheckStatus.Pass, "micHeard"),
        "listening" => Device("microphone", CheckStatus.Later, "saySomething", "listening"),
        "denied" => Device("microphone", CheckStatus.Fail, "notAllowed", "denied"),
        "missing" => Device("microphone", CheckStatus.Fail, "noneFound", "missing"),
        "busy" => Device("microphone", CheckStatus.Fail, "inUse", "busy"),
        "lost" => Device("microphone", CheckStatus.Fail, "stopped", "lost"),
        "unsupported" => Device("microphone", CheckStatus.Fail, "unsupported", "unsupported"),
        "error" => Device("microphone", CheckStatus.Fail, "couldntOpen", "error"),
        _ => Device("microphone", CheckStatus.Later, "waitingBrowser", "waiting"),
    };

    private Check CameraCheck => camera switch
    {
        "ok" => Device("camera", CheckStatus.Pass, "working"),
        "denied" => Device("camera", CheckStatus.Fail, "notAllowed", "denied"),
        "missing" => Device("camera", CheckStatus.Fail, "noneFound", "missing"),
        "busy" => Device("camera", CheckStatus.Fail, "inUse", "busy"),
        "lost" => Device("camera", CheckStatus.Fail, "stopped", "lost"),
        "unsupported" => Device("camera", CheckStatus.Fail, "unsupported", "unsupported"),
        "error" => Device("camera", CheckStatus.Fail, "noPicture", "error"),
        _ => Device("camera", CheckStatus.Later, "waitingBrowser", "waiting"),
    };

    private bool Done(int step) => step switch
    {
        1 => ChecksPass,
        2 => previewPlayed,
        3 => practiceFollowUp is not null,
        _ => agreed,
    };


@page "/my-exams/{AssignmentId:guid}/start"
@attribute [Authorize(Policy = GadflyPolicies.Student)]
@implements IAsyncDisposable
@using Gadfly.Server.Data
@using Gadfly.Server.Sessions
@using Gadfly.Server.Student
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject TimeProvider Clock
@inject SessionOrchestrator Sessions
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Gadfly.Server.Voice.VoiceSettings VoiceConfig

<HeadContent><link rel="stylesheet" href="student.css" /></HeadContent>
<PageTitle>Get ready · Gadfly Exams</PageTitle>

@if (loading)
{
    <h1>Get ready</h1>
    <p class="hint">Loading…</p>
}
else if (assignment is null)
{
    <h1>Get ready</h1>
    <p class="notice">That exam isn't assigned to you in this organization. <a href="my-exams">Back to my exams</a></p>
}
else
{
    <h1>@assignment.ExamTitle <span>· get ready</span></h1>

    @if (assignment.CanResumeDirectly)
    {
        <p class="notice">You already have this exam in progress. <a class="button" href="exam/@assignment.ActiveSessionId">Resume where you left off</a></p>
    }
    else if (!assignment.CanStart)
    {
        <p class="notice">This exam can't be started right now: @StudentExams.Describe(assignment.Standing).ToLowerInvariant(). <a href="my-exams">Back to my exams</a></p>
    }
    else
    {
        <ol class="steps">
            <li class="@(Done(1) ? "done" : "")">System check</li>
            <li class="@(Done(2) ? "done" : "")">How it works</li>
            <li class="@(Done(3) ? "done" : "")">Notice and consent</li>
        </ol>

        <section class="panel wide">
            <h2>1. System check</h2>
            @if (checks is null)
            {
                <p class="hint">Checking your browser…</p>
            }
            else
            {
                @* Voice and camera are mandatory (GAD-T239): the camera preview and the microphone meter prove both work. *@
                <div class="syscheck-media">
                    <video @ref="preview" class="syscheck-camera" muted playsinline autoplay aria-label="Your camera"></video>
                    <div class="syscheck-level" @ref="meter" aria-hidden="true"><i></i></div>
                </div>
                <ul class="syschecks">
                    @foreach (var c in AllChecks)
                    {
                        <li class="syscheck syscheck-@c.Status.ToString().ToLowerInvariant()">
                            <span class="syscheck-mark" aria-hidden="true">@Mark(c.Status)</span>
                            <div>
                                <strong>@c.Name</strong> — @c.Result
                                @if (c.Fix is not null)
                                {
                                    <div class="hint">@c.Fix</div>
                                }
                            </div>
                        </li>
                    }
                </ul>
                <button type="button" class="secondary" @onclick="RunChecksAsync" disabled="@checking">Check again</button>
                @if (!ChecksPass)
                {
                    <p class="error" role="status">Begin exam stays off until every check above is ✓: fix the items marked ✗ (or finish the ones marked …), then press "Check again" if needed.</p>
                }
                @* Eye-tracking setup advice and calibration (GAD-T305): filled by js/gaze-quality.js once the camera shows a picture; never blocks Begin exam. *@
                @if (assignment.Integrity != IntegrityLevel.Off)
                {
                    <div class="gaze-quality" data-gaze-quality></div>
                }
            }
        </section>

        <section class="panel wide">
            <h2>2. How Socratic questioning works</h2>
            <p>This isn't a multiple-choice test. The examiner asks one question at a time and builds the next question from <em>your own answer</em>: it may ask you to clarify a word you used, give an example, test your idea against a tricky case, or point out when two of your answers seem to disagree.</p>
            <details class="science">
                <summary>Why it works this way (the science behind it)</summary>
                <p>This is the method Socrates used, called the <em>elenchus</em>: he questioned people who were sure they knew something and found that one of them "thinks he knows something when he does not" (Plato, <cite>Apology</cite> 21d). The questions only ever use what you yourself said, and they check whether your answers fit together.</p>
                <p><strong>Why follow-up questions show real understanding.</strong> A single right answer can be remembered or guessed. Explaining <em>why</em> it is true, handling a case that doesn't fit and using the idea in a new situation is much harder without understanding it. Psychologists use the same approach to find out how people think: vary the questions, try a counter-suggestion, and never put the answer in the person's mouth (Piaget, 1929). Being asked to explain also tends to help people learn (Bisra et al., 2018), so the exam can teach you something too.</p>
                <p><strong>Its limits, and what Gadfly does about them.</strong></p>
                <ul>
                    <li>If two of your answers disagree, that shows something isn't settled yet, not which answer is wrong (Vlastos, 1983; Benson, 1995). You can fix either one; your course material and the grading rubric decide what is right.</li>
                    <li>Explaining out loud slows everyone down (Fox, Ericsson &amp; Best, 2011). Pauses, "um"s, an accent and how fast you speak are not graded.</li>
                    <li>Speech recognition can mishear some accents and stuttered speech (Koenecke et al., 2020; Mujtaba et al., 2024). If the next question shows the examiner misheard you, say so and put it again in your own words.</li>
                    <li>One exam can't measure everything, and AI graders make mistakes (van der Vleuten et al., 2010; Zheng et al., 2023). Several AI models score each topic separately, a human examiner grades too, and a person approves your result before you see it.</li>
                    <li>A webcam can't tell reading from thinking (Papoutsaki et al., 2016), and voice measures can't detect stress or lying (Harnsberger et al., 2009). Camera notes and the comparison of your voice with your first answers are shown to a reviewer only as low-confidence notes, never as a verdict and never as part of your grade. The voice comparison can lead the examiner to ask an extra follow-up question.</li>
                </ul>
                <p class="hint">Full references and how each was checked: "The science behind Gadfly" in Gadfly's documentation (docs/SCIENCE.md).</p>
            </details>
            <ul>
                <li>The exam is spoken. The examiner talks to you and you answer out loud; there is no typing. Your microphone and camera must stay on for the whole exam. If either stops working, the exam pauses until you bring it back.</li>
                <li>Your time starts when the examiner asks the first question, not when you press Begin exam.</li>
                <li>Answer in your own words. Short, honest answers are better than long copied ones.</li>
                <li>If you genuinely don't know, say so or press <strong>I don't know</strong>. Admitting it is a real answer, not a failure, and the examiner moves on.</li>
                <li>The clock is kept on the server; if you reload the page, you return to the same question.</li>
                <li>You won't see scores during the exam. Your result is published once it has been graded and approved.</li>
            </ul>
            <div class="practice">
                <h3>Try one (practice, not recorded)</h3>
                <p class="question">@practiceQuestion</p>
                @if (practiceFollowUp is null)
                {
                    @* Spoken, like the exam (GAD-T239): nothing is recorded; the button waits until the microphone has heard you. *@
                    <p class="hint">Answer out loud in a sentence or two, then press the button. Nothing is recorded.</p>
                    <div class="actions">
                        <button type="button" @onclick="PracticeAnswer" disabled="@(microphone != "ok")">I've said my answer</button>
                        <button type="button" class="secondary" @onclick="PracticeDontKnow">I don't know</button>
                    </div>
                    @if (microphone != "ok")
                    {
                        <p class="hint">The button turns on once the system check above has heard your microphone.</p>
                    }
                }
                else
                {
                    <p class="question">@practiceFollowUp</p>
                    <p class="hint">@practiceExplain</p>
                    <button type="button" class="link" @onclick="ResetPractice">Try again</button>
                }
            </div>
        </section>

        <section class="panel wide">
            <h2>3. @notice!.Title</h2>
            @foreach (var p in notice.Paragraphs)
            {
                <p>@p</p>
            }
            <label class="inline">
                <input type="checkbox" @bind="agreed" />
                I have read this notice and agree to take the exam on these terms.
            </label>
            <button type="button" @onclick="BeginAsync" disabled="@(!agreed || !ChecksPass || starting)">
                @(starting ? "Starting…" : assignment.ActiveSessionId is null ? "Begin exam" : "Continue to the exam")
            </button>
            @if (error is not null)
            {
                <p class="error" role="alert">@error</p>
            }
        </section>
    }
}

@code {
    [Parameter] public Guid AssignmentId { get; set; }

    private enum CheckStatus { Pass, Warn, Fail, Later }
    private sealed record Check(string Name, CheckStatus Status, string Result, string? Fix = null);

    private sealed class BrowserReport
    {
        public string UserAgent { get; set; } = "";
        public bool WebSocket { get; set; }
        public bool Cookies { get; set; }
        public bool Online { get; set; }
        public bool SecureContext { get; set; }
        public bool SpeechRecognition { get; set; }
        public bool MediaDevices { get; set; }
        public int ScreenWidth { get; set; }
    }

    private bool loading = true, checking, agreed, starting, mediaStarted;
    private ElementReference preview, meter;
    private DotNetObjectReference<StartExam>? self;
    /// <summary>The microphone and camera as system-check.js reports them: waiting, listening, ok, denied, missing, busy, lost, unsupported or error.</summary>
    private string microphone = "waiting", camera = "waiting";
    private StudentAssignmentView? assignment;
    private ConsentNotice? notice;
    private List<Check>? checks;
    private string? clientInfo, error;
    private IJSObjectReference? module;

    private const string practiceQuestion = "Practice: in your own words, what is a habit?";
    private string? practiceFollowUp, practiceExplain;

    /// <summary>Every check must pass (a warning is fine): a check still waiting, like a microphone not yet heard, keeps Begin exam off.</summary>
    private bool ChecksPass => checks is not null && AllChecks.All(c => c.Status is CheckStatus.Pass or CheckStatus.Warn);

    private IEnumerable<Check> AllChecks => (checks ?? []).Concat([MicrophoneCheck, CameraCheck]);

    private Check MicrophoneCheck => microphone switch
    {
        "ok" => new Check("Microphone", CheckStatus.Pass, "working: we heard you"),
        "listening" => new Check("Microphone", CheckStatus.Later, "say a few words out loud",
            "The meter above should move when you speak. If it doesn't, click anywhere on this page and speak again."),
        "denied" => new Check("Microphone", CheckStatus.Fail, "not allowed",
            "Allow the microphone for this site (the icon in your browser's address bar), then press \"Check again\"."),
        "missing" => new Check("Microphone", CheckStatus.Fail, "none found", "Connect a microphone or headset, then press \"Check again\"."),
        "busy" => new Check("Microphone", CheckStatus.Fail, "in use by another app", "Close other apps that use the microphone, then press \"Check again\"."),
        "lost" => new Check("Microphone", CheckStatus.Fail, "stopped working", "Plug it back in or allow it again, then press \"Check again\"."),
        "unsupported" => new Check("Microphone", CheckStatus.Fail, "this browser can't use it",
            "Use a current Chrome, Edge, Firefox or Safari over a secure (https) connection."),
        "error" => new Check("Microphone", CheckStatus.Fail, "couldn't be opened", "Check your microphone, then press \"Check again\"."),
        _ => new Check("Microphone", CheckStatus.Later, "waiting for your browser", "Allow the microphone when your browser asks."),
    };

    private Check CameraCheck => camera switch
    {
        "ok" => new Check("Camera", CheckStatus.Pass, "working"),
        "denied" => new Check("Camera", CheckStatus.Fail, "not allowed",
            "Allow the camera for this site (the icon in your browser's address bar), then press \"Check again\"."),
        "missing" => new Check("Camera", CheckStatus.Fail, "none found", "Connect a webcam, then press \"Check again\"."),
        "busy" => new Check("Camera", CheckStatus.Fail, "in use by another app", "Close other apps that use the camera, then press \"Check again\"."),
        "lost" => new Check("Camera", CheckStatus.Fail, "stopped working", "Plug it back in or allow it again, then press \"Check again\"."),
        "unsupported" => new Check("Camera", CheckStatus.Fail, "this browser can't use it",
            "Use a current Chrome, Edge, Firefox or Safari over a secure (https) connection."),
        "error" => new Check("Camera", CheckStatus.Fail, "shows no picture", "Check that the camera is uncovered and not used by another app, then press \"Check again\"."),
        _ => new Check("Camera", CheckStatus.Later, "waiting for your browser", "Allow the camera when your browser asks."),
    };
    private bool Done(int step) => step switch
    {
        1 => ChecksPass,
        2 => practiceFollowUp is not null,
        _ => agreed,
    };

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.OrganizationId is { } org && Tenant.UserId is { } user)
        {
            assignment = await StudentExams.FindAsync(Scopes, org, user, AssignmentId, Clock.GetUtcNow());
            if (assignment is not null)
            {
                var (orgName, retention) = await StudentExams.OrganizationAsync(Scopes, org);
                notice = ConsentNotice.For(orgName, assignment.ExamTitle, retention, assignment.Mode, assignment.Integrity);
            }
        }
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && assignment is { CanStart: true, CanResumeDirectly: false })
        {
            await RunChecksAsync();
            StateHasChanged();
            return;
        }
        // The preview and the meter exist once the checks are shown: open the microphone and camera then.
        if (checks is not null && !mediaStarted && module is not null)
        {
            mediaStarted = true;
            await StartMediaAsync();
        }
    }

    private async Task StartMediaAsync()
    {
        try
        {
            self ??= DotNetObjectReference.Create(this);
            await module!.InvokeVoidAsync("startMedia", self, preview, meter);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            microphone = camera = "error";
            StateHasChanged();
        }
    }

    /// <summary>Called by system-check.js when the microphone or the camera changes state (GAD-T239).</summary>
    [JSInvokable]
    public Task OnMedia(string device, string state) => InvokeAsync(() =>
    {
        if (state is not ("waiting" or "listening" or "ok" or "denied" or "missing" or "busy" or "lost" or "unsupported" or "error")) return;
        if (device == "microphone") microphone = state;
        else if (device == "camera") camera = state;
        else return;
        StateHasChanged();
    });

    private async Task RunChecksAsync()
    {
        if (checking) return;
        checking = true;
        var list = new List<Check>();
        try
        {
            var reopen = module is not null && mediaStarted && (microphone != "ok" || camera != "ok");
            // The import can fail or hang when the circuit isn't ready yet (GAD-T288): bound it and retry once.
            if (module is null)
            {
                for (var attempt = 0; module is null; attempt++)
                {
                    try
                    {
                        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
                        module = await JS.InvokeAsync<IJSObjectReference>("import", cts.Token, "./js/system-check.js");
                    }
                    catch (Exception ex) when (attempt == 0 && ex is JSException or TaskCanceledException or InvalidOperationException)
                    {
                        await Task.Delay(500);
                    }
                }
            }
            // "Check again" reopens a microphone or camera that failed (the click also lets the page's audio run).
            if (reopen) await StartMediaAsync();
            var r = await InvokeBoundedAsync<BrowserReport>("check");
            clientInfo = r.UserAgent;

            // Round trip through the live connection the exam uses.
            var sw = System.Diagnostics.Stopwatch.StartNew();
            for (var i = 0; i < 3; i++) await InvokeBoundedAsync<bool>("ping");
            var ms = sw.Elapsed.TotalMilliseconds / 3;

            list.Add(r.WebSocket
                ? new Check("Browser", CheckStatus.Pass, "supported")
                : new Check("Browser", CheckStatus.Fail, "this browser can't keep a live connection",
                    "Use a current version of Chrome, Edge, Firefox or Safari."));
            list.Add(r.Cookies
                ? new Check("Cookies", CheckStatus.Pass, "enabled")
                : new Check("Cookies", CheckStatus.Fail, "blocked", "Allow cookies for this site in your browser settings, then reload."));
            list.Add(r.Online
                ? ms switch
                {
                    < 400 => new Check("Connection", CheckStatus.Pass, $"good ({ms:0} ms round trip)"),
                    < 1500 => new Check("Connection", CheckStatus.Warn, $"slow ({ms:0} ms round trip)",
                        "The examiner may be slow to respond. Move closer to your Wi-Fi router or close other downloads if pages feel sluggish."),
                    _ => new Check("Connection", CheckStatus.Fail, $"too slow ({ms:0} ms round trip)",
                        "Move closer to your Wi-Fi router, use a wired connection, or stop other downloads and streams, then check again."),
                }
                : new Check("Connection", CheckStatus.Fail, "offline", "Reconnect to the internet, then check again."));
            list.Add(r.ScreenWidth is > 0 and < 360
                ? new Check("Screen", CheckStatus.Warn, "very narrow", "A larger window or a tablet or computer shows the examiner and your camera better.")
                : new Check("Screen", CheckStatus.Pass, "fine"));
            list.Add(VoiceConfig.Available
                ? new Check("Spoken examiner", CheckStatus.Pass, "available")
                : new Check("Spoken examiner", CheckStatus.Fail, "not turned on for this site",
                    "Exams are spoken, and the talking examiner is switched off here. Tell your instructor; you can't take the exam until it is on."));
        }
        catch (JSException ex)
        {
            list.Add(new Check("Browser", CheckStatus.Fail, "the check couldn't run",
                $"Reload the page; if it keeps failing, try another browser. ({ex.Message})"));
        }
        catch (JSDisconnectedException)
        {
            list.Add(new Check("Connection", CheckStatus.Fail, "the connection to the server was lost",
                "Reload the page, then check again."));
        }
        catch (Exception ex) when (ex is TaskCanceledException or OperationCanceledException)
        {
            list.Add(new Check("Connection", CheckStatus.Fail, "no response from your browser",
                "Reload the page and check again; if it keeps failing, check your internet connection."));
        }
        catch (Exception ex)
        {
            // Never leave the page on "Checking your browser…": any other failure becomes a visible result with a way to retry.
            list.Add(new Check("Browser", CheckStatus.Fail, "the check couldn't run",
                $"Press \"Check again\"; if it keeps failing, reload the page or try another browser. ({ex.GetType().Name})"));
        }
        checks = list;
        checking = false;
        await InvokeAsync(StateHasChanged);
        _ = PreloadExaminerAsync();
    }

    private bool preloading;

    /// <summary>
    /// Starts loading the talking examiner (scripts and avatar model) in the background while the student is still here (GAD-T303),
    /// so the exam room shows her without a long first load. Best effort: any failure just leaves the loading to the exam room.
    /// </summary>
    private async Task PreloadExaminerAsync()
    {
        if (preloading || !VoiceConfig.Available) return;
        preloading = true;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            await using var preload = await JS.InvokeAsync<IJSObjectReference>("import", cts.Token, "./js/voice-preload.js");
            await preload.InvokeAsync<bool>("preload", cts.Token, new { modelUrl = VoiceConfig.AvatarModelUrl, portraitUrl = VoiceConfig.PortraitUrl });
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or OperationCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            preloading = false;
        }
    }

    private async Task<T> InvokeBoundedAsync<T>(string identifier)
    {
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
        return await module!.InvokeAsync<T>(identifier, cts.Token);
    }

    private static string Mark(CheckStatus s) => s switch
    {
        CheckStatus.Pass => "✓",
        CheckStatus.Warn => "!",
        CheckStatus.Fail => "✗",
        _ => "…",
    };

    private void PracticeAnswer()
    {
        practiceFollowUp = "Can you think of something that fits your description, but that you wouldn't call a habit?";
        practiceExplain = "That's a counterexample move: the examiner tests your definition against a case built from your own words. In the real exam the follow-ups are written live from what you say.";
    }

    private void PracticeDontKnow()
    {
        practiceFollowUp = "That's fine. Let's come at it from another side: can you name one thing you do almost every day without thinking about it?";
        practiceExplain = "\"I don't know\" is an honest answer. The examiner records it and either tries an easier angle or moves on to the next topic.";
    }

    private void ResetPractice()
    {
        practiceFollowUp = practiceExplain = null;
    }

    private async Task BeginAsync()
    {
        // A double click must not start twice: two concurrent CreateOrResume calls both insert attempt 1 and the second dies on the unique index (GAD-T207).
        if (starting || assignment is null || notice is null || Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user) return;
        starting = true;
        error = null;
        try
        {
            // An attempt already in progress is resumed as it is (even if the exam was archived since:
            // archiving blocks only new attempts); otherwise the orchestrator starts the next attempt.
            var sessionId = assignment.ActiveSessionId
                            ?? await Sessions.CreateOrResumeAsync(org, assignment.AssignmentId, user, clientInfo);
            await Sessions.RecordConsentAsync(org, sessionId, user, notice.Sha256);
            // Hand the microphone and camera over to the exam room, which opens them again straight away (GAD-T239).
            await StopMediaAsync();
            Nav.NavigateTo($"exam/{sessionId}");
        }
        catch (SessionRefusedException ex)
        {
            error = ex.Message;
            starting = false;
        }
    }

    private async Task StopMediaAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("stopMedia"); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            await StopMediaAsync();
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        self?.Dispose();
    }
}

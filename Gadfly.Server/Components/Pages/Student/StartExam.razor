    /// <summary>The language answers (GAD-T552): prefilled from the saved profile, saved when the exam begins.</summary>
    private List<string> spoken = [];
    private string primary = "en";

    /// <summary>The languages this exam is offered in, and the one chosen for this attempt (GAD-T546).</summary>
    private IReadOnlyList<string> offered = ["en"];
    private string examLanguage = "en";

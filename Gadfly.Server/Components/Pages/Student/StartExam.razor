    protected override async Task OnInitializedAsync()
    {
        T.Changed += OnLanguageChanged;
        examiners = ExaminerCatalog.For(VoiceConfig, Env.WebRootPath);
        examiner = ExaminerCatalog.Pick(examiners, null);
        if (ExamId is { } examId && Tenant.OrganizationId is { } eorg && Tenant.UserId is { } euser)
        {
            // GAD-T669: start by exam: an exam open to every student gets the student's assignment made on first use, then the
            // ordinary get-ready page for that assignment takes over. Anything else shows "not assigned" below.
            var made = await StudentExams.EnsureOpenAssignmentAsync(Scopes, eorg, euser, examId, Clock.GetUtcNow(),
                createIfMissing: Config.GetValue<bool>(StudentExams.OpenExamsSetting));
            if (made is { } id)
            {
                Nav.NavigateTo($"my-exams/{id}/start", replace: true);
                return;
            }
        }
        else if (Tenant.OrganizationId is { } org && Tenant.UserId is { } user)
        {
            assignment = await StudentExams.FindAsync(Scopes, org, user, AssignmentId, Clock.GetUtcNow(), T.Language);
            if (assignment is not null)
            {
                // An exam's or its organization's examiner (GAD-T504) is the only one offered; otherwise the student chooses.
                var (examAvatar, orgAvatar) = await ExaminerCatalog.AvatarIdsForAssignmentAsync(Scopes, org, AssignmentId);
                if (ExaminerCatalog.Fixed(examiners, examAvatar, orgAvatar) is { } fixedExaminer)
                {
                    (examiners, examiner) = ([fixedExaminer], fixedExaminer);
                    examinerFixed = true;
                }
                (orgName, retentionDays) = await StudentExams.OrganizationAsync(Scopes, org);
                await LoadLanguagesAsync(org, user);
                BuildNotice();
            }
        }
        loading = false;
    }

    /// <summary>The notice in the page's language; its hash records exactly what the student read (GAD-T51).</summary>
    private void BuildNotice()
    {
        if (assignment is null || orgName is null) return;
        notice = ConsentNotice.For(orgName, assignment.ExamTitle, retentionDays, assignment.Mode, assignment.Integrity, assignment.TypedAnswers, T.Language);
    }

    /// <summary>The page's language changed: the notice is rebuilt in it, and the agreement to the old wording is withdrawn.</summary>
    private void OnLanguageChanged() => _ = InvokeAsync(() =>
    {
        var before = notice?.Sha256;
        BuildNotice();
        if (notice?.Sha256 != before) agreed = false;
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && assignment is { CanStart: true, CanResumeDirectly: false })
        {
            if (rememberLanguage) await LanguageSwitch.RememberAsync(JS, T.Language);
            await LoadExaminerChoiceAsync();
            await RunChecksAsync();
            StateHasChanged();
            return;
        }
        // The preview and the meter exist once the checks are shown: open the microphone and camera then.
        if (checks is not null && !mediaStarted && module is not null)
        {
            mediaStarted = true;
            await StartMediaAsync();
        }
    }

    private async Task StartMediaAsync()
    {
        try
        {
            self ??= DotNetObjectReference.Create(this);
            // Typed answers (GAD-T260): the camera only, no microphone.
            await module!.InvokeVoidAsync("startMedia", self, preview, meter, new { microphone = !TypedAnswers });
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            microphone = camera = "error";
            StateHasChanged();
        }
    }

    /// <summary>Called by system-check.js when the microphone or the camera changes state (GAD-T239).</summary>
    [JSInvokable]
    public Task OnMedia(string device, string state) => InvokeAsync(() =>
    {
        if (state is not ("waiting" or "listening" or "ok" or "denied" or "missing" or "busy" or "lost" or "unsupported" or "error")) return;
        if (device == "microphone") microphone = state;
        else if (device == "camera") camera = state;
        else return;
        // Device names appear once the browser has allowed them: list them again (GAD-T593).
        if (state == "ok" || state == "listening") _ = LoadDevicesAsync();
        StateHasChanged();
    });

    private enum DeviceKind { Camera, Microphone }
    private sealed record DeviceOption(string Id, string Label, int Index, bool Selected);
    private sealed class DeviceList
    {
        public List<DeviceOption> Cameras { get; set; } = [];
        public List<DeviceOption> Microphones { get; set; } = [];
    }
    private List<DeviceOption> cameras = [], microphones = [];

    /// <summary>The cameras and microphones the browser lists, the one in use selected (GAD-T593).</summary>
    private async Task LoadDevicesAsync()
    {
        if (module is null) return;
        try
        {
            var list = await InvokeBoundedAsync<DeviceList>("devices");
            cameras = list.Cameras;
            microphones = list.Microphones;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or OperationCanceledException or ObjectDisposedException or InvalidOperationException) { }
    }

    /// <summary>The student picked another device: remember it on this device and reopen the preview and meter on it.</summary>
    private async Task ChooseDeviceAsync(DeviceKind kind, ChangeEventArgs e)
    {
        if (module is null) return;
        try
        {
            await module.InvokeVoidAsync("chooseDevice", kind == DeviceKind.Camera ? "camera" : "microphone", e.Value as string ?? "");
            if (kind == DeviceKind.Camera) camera = "waiting"; else microphone = "waiting";
            await StartMediaAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException) { }
    }

    private async Task RunChecksAsync()
    {
        if (checking) return;
        checking = true;
        var list = new List<CheckKeys>();
        try
        {
            var reopen = module is not null && mediaStarted && ((microphone != "ok" && !TypedAnswers) || camera != "ok");
            // The import can fail or hang when the circuit isn't ready yet (GAD-T288): bound it and retry once.
            if (module is null)
            {
                for (var attempt = 0; module is null; attempt++)
                {
                    try
                    {
                        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
                        module = await JS.InvokeAsync<IJSObjectReference>("import", cts.Token, "./js/system-check.js");
                    }
                    catch (Exception ex) when (attempt == 0 && ex is JSException or TaskCanceledException or InvalidOperationException)
                    {
                        await Task.Delay(500);
                    }
                }
            }
            // "Check again" reopens a microphone or camera that failed (the click also lets the page's audio run).
            if (reopen) await StartMediaAsync();
            var r = await InvokeBoundedAsync<BrowserReport>("check");
            clientInfo = r.UserAgent;

            // Round trip through the live connection the exam uses.
            var sw = System.Diagnostics.Stopwatch.StartNew();
            for (var i = 0; i < 3; i++) await InvokeBoundedAsync<bool>("ping");
            var ms = Math.Round(sw.Elapsed.TotalMilliseconds / 3);

            list.Add(r.WebSocket
                ? new CheckKeys("getReady.check.browser", CheckStatus.Pass, "getReady.check.browser.ok")
                : new CheckKeys("getReady.check.browser", CheckStatus.Fail, "getReady.check.browser.noLive", "getReady.check.browser.fix.noLive"));
            list.Add(r.Cookies
                ? new CheckKeys("getReady.check.cookies", CheckStatus.Pass, "getReady.check.cookies.ok")
                : new CheckKeys("getReady.check.cookies", CheckStatus.Fail, "getReady.check.cookies.blocked", "getReady.check.cookies.fix"));
            list.Add(r.Online
                ? ms switch
                {
                    < 400 => new CheckKeys("getReady.check.connection", CheckStatus.Pass, "getReady.check.connection.good", Args: [ms]),
                    < 1500 => new CheckKeys("getReady.check.connection", CheckStatus.Warn, "getReady.check.connection.slow", "getReady.check.connection.fix.slow", [ms]),
                    _ => new CheckKeys("getReady.check.connection", CheckStatus.Fail, "getReady.check.connection.tooSlow", "getReady.check.connection.fix.tooSlow", [ms]),
                }
                : new CheckKeys("getReady.check.connection", CheckStatus.Fail, "getReady.check.connection.offline", "getReady.check.connection.fix.offline"));
            list.Add(r.ScreenWidth is > 0 and < 360
                ? new CheckKeys("getReady.check.screen", CheckStatus.Warn, "getReady.check.screen.narrow", "getReady.check.screen.fix")
                : new CheckKeys("getReady.check.screen", CheckStatus.Pass, "getReady.check.screen.ok"));
            list.Add(VoiceConfig.Available
                ? new CheckKeys("getReady.check.voice", CheckStatus.Pass, "getReady.check.voice.ok")
                : new CheckKeys("getReady.check.voice", CheckStatus.Fail, "getReady.check.voice.off", "getReady.check.voice.fix"));
        }
        catch (JSException ex)
        {
            list.Add(new CheckKeys("getReady.check.browser", CheckStatus.Fail, "getReady.check.browser.couldntRun", "getReady.check.browser.fix.reload", [ex.Message]));
        }
        catch (JSDisconnectedException)
        {
            list.Add(new CheckKeys("getReady.check.connection", CheckStatus.Fail, "getReady.check.connection.lost", "getReady.check.connection.fix.lost"));
        }
        catch (Exception ex) when (ex is TaskCanceledException or OperationCanceledException)
        {
            list.Add(new CheckKeys("getReady.check.connection", CheckStatus.Fail, "getReady.check.connection.noResponse", "getReady.check.connection.fix.noResponse"));
        }
        catch (Exception ex)
        {
            // Never leave the page on "Checking your browser…": any other failure becomes a visible result with a way to retry.
            list.Add(new CheckKeys("getReady.check.browser", CheckStatus.Fail, "getReady.check.browser.couldntRun", "getReady.check.browser.fix.again", [ex.GetType().Name]));
        }
        checks = list;
        checking = false;
        await InvokeAsync(StateHasChanged);
        _ = PreloadExaminerAsync();
    }

    private bool preloading;

    /// <summary>
    /// Starts loading the talking examiner (scripts and avatar model) in the background while the student is still here (GAD-T303),
    /// so the exam room shows her without a long first load. Best effort: any failure just leaves the loading to the exam room.
    /// </summary>
    private async Task PreloadExaminerAsync()
    {
        if (preloading || !VoiceConfig.Available) return;
        preloading = true;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
            await using var preload = await JS.InvokeAsync<IJSObjectReference>("import", cts.Token, "./js/voice-preload.js");
            await preload.InvokeAsync<bool>("preload", cts.Token, new { modelUrl = examiner.ModelUrl, portraitUrl = examiner.PortraitUrl });
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or OperationCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            preloading = false;
        }
    }

    /// <summary>
    /// The examiner says hello in the page's language (GAD-T506): the browser's own speech reads the line and the caption lights
    /// word by word. Free and local: no voice provider is called before the exam. With no browser speech the line stays as text.
    /// </summary>
    private async Task PlayPreviewAsync()
    {
        previewPlayed = true;
        try
        {
            previewModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/examiner-preview.js");
            var spoke = await previewModule.InvokeAsync<bool>("say", previewCaption, T["getReady.examiner.line"].Value, UiCatalog.CultureFor(T.Language).Name,
                new { variant = VoiceVariant, male = examiner.Id == ExaminerCatalog.Male });
            previewSilent = !spoke;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            previewSilent = true;
        }
    }

    private async Task<TResult> InvokeBoundedAsync<TResult>(string identifier)
    {
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
        return await module!.InvokeAsync<TResult>(identifier, cts.Token);
    }

    private static string Mark(CheckStatus s) => s switch
    {
        CheckStatus.Pass => "✓",
        CheckStatus.Warn => "!",
        CheckStatus.Fail => "✗",
        _ => "…",
    };

    private void PracticeAnswer()
    {
        practiceFollowUp = "getReady.try.followUp";
        practiceExplain = "getReady.try.followUpWhy";
    }

    private void PracticeDontKnow()
    {
        practiceFollowUp = "getReady.try.dontKnowFollowUp";
        practiceExplain = "getReady.try.dontKnowWhy";
    }

    private void ResetPractice()
    {
        practiceFollowUp = practiceExplain = null;
        practiceText = "";
    }

    private async Task BeginAsync()
    {
        // A double click must not start twice: two concurrent CreateOrResume calls both insert attempt 1 and the second dies on the unique index (GAD-T207).
        if (starting || assignment is null || notice is null || Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user) return;
        starting = true;
        error = null;
        try
        {
            // An attempt already in progress is resumed as it is (even if the exam was archived since:
            // archiving blocks only new attempts); otherwise the orchestrator starts the next attempt.
            // The language answers first: the attempt copies the primary language from the profile (GAD-T552).
            await SaveLanguagesAsync(org, user);
            // The exam language is fixed here for the attempt (GAD-T546): a new attempt starts in it; one created but not yet begun
            // (a reload before the first question) takes it too.
            Guid sessionId;
            if (assignment.ActiveSessionId is { } existing)
            {
                sessionId = existing;
                await Sessions.ChooseLanguageAsync(org, sessionId, user, examLanguage);
            }
            else sessionId = await Sessions.CreateOrResumeAsync(org, assignment.AssignmentId, user, clientInfo, examLanguage);
            await Sessions.RecordConsentAsync(org, sessionId, user, notice.Sha256);
            if (research is not null) await research.RecordAsync(sessionId);   // optional; never blocks the exam (GAD-T452)
            // Hand the microphone and camera over to the exam room, which opens them again straight away (GAD-T239).
            await EndCalibrationAsync();
            await StopMediaAsync();
            Nav.NavigateTo($"exam/{sessionId}");
        }
        catch (SessionRefusedException ex)
        {
            error = ex.In(T.For(examLanguage));   // in the exam's language (GAD-T628)
            starting = false;
        }
    }

    private async Task StopMediaAsync()
    {
        if (module is null) return;
        try { await module.InvokeVoidAsync("stopMedia"); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        T.Changed -= OnLanguageChanged;
        await EndCalibrationAsync();
        if (calibrationModule is not null)
        {
            try { await calibrationModule.DisposeAsync(); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        }
        if (module is not null)
        {
            await StopMediaAsync();
            try { await module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (previewModule is not null)
        {
            try { await previewModule.InvokeVoidAsync("stop"); await previewModule.DisposeAsync(); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        }
        if (prefsModule is not null)
        {
            try { await prefsModule.DisposeAsync(); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        }
        self?.Dispose();
    }
}

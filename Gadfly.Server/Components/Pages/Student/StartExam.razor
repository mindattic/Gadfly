    /// <summary>The voices the student may give this examiner in this language, less the examiner's own (offered as the first option).</summary>
    private IReadOnlyList<string> VoiceChoices =>
        ExaminerCustomization.AllowedVoices(examiner.Id, T.Language).Where(v => v != examiner.VoiceIdFor(T.Language)).ToList();

    /// <summary>The browser voice the preview uses for the chosen voice (examiner-preview.js say): 0 for the examiner's own.</summary>
    private int VoiceVariant => customization.Voice is { } v && VoiceChoices.ToList().IndexOf(v) is var i and >= 0 ? i + 1 : 0;

    /// <summary>One customization change (GAD-T663): validated, shown, and remembered; a voice change replays the preview line.</summary>
    private async Task CustomizeAsync(ExaminerCustomization next, bool replay = false)
    {
        customization = next.Validate(examiner.Id);
        await SaveExaminerAsync();
        if (replay) await PlayPreviewAsync();
    }

    private Task ChooseVoiceAsync(ChangeEventArgs e) =>
        CustomizeAsync(customization with { Voice = e.Value as string is { Length: > 0 } v ? v : null }, replay: true);

    /// <summary>A swatch radio group (skin tone, hair colour, clothing) with a Default option first.</summary>
    private RenderFragment Swatches(string group, IReadOnlyList<string> values, string? current, Func<string?, ExaminerCustomization> with) => __builder =>
    {
        <fieldset class="customize-group swatches">
            <legend>@T[$"examRoom.customize.{group}"]</legend>
            <label class="swatch-choice" title="@T["examRoom.customize.default"]">
                <input type="radio" class="visually-hidden" name="examiner-@group" value="" checked="@(current is null)" @onchange="() => CustomizeAsync(with(null))" />
                <span class="swatch swatch-default" aria-hidden="true"></span>
                <span class="visually-hidden">@T["examRoom.customize.default"]</span>
            </label>
            @foreach (var v in values)
            {
                <label class="swatch-choice" title="@T[$"examRoom.customize.{group}.{v}"]">
                    <input type="radio" class="visually-hidden" name="examiner-@group" value="@v" checked="@(v == current)" @onchange="() => CustomizeAsync(with(v))" />
                    <span class="swatch" @attributes="@(new Dictionary<string, object> { [$"data-{group}"] = v })" aria-hidden="true"></span>
                    <span class="visually-hidden">@T[$"examRoom.customize.{group}.{v}"]</span>

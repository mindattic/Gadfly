    /// <summary>Voice calibration (GAD-T594): the languages calibrated already, and the reading in progress.</summary>
    private IReadOnlyCollection<string> calibrated = [];
    private string? calibrating;
    private int calibrationDone;
    private string calibrationStatus = "";
    private Guid? calibrationGrant;
    private IJSObjectReference? calibrationModule;
    private ElementReference calibrationLevel;

    /// <summary>The exam language, and the primary language too when Gadfly can run exams in it.</summary>
    private IEnumerable<string> CalibrationLanguages =>
        new[] { examLanguage }.Concat(Gadfly.Engine.ExamLanguage.IsSupported(primary) ? [Gadfly.Engine.ExamLanguage.Normalize(primary)] : Array.Empty<string>()).Distinct();

    /// <summary>English primary and an English exam: today's experience, so calibration is offered but folded away (owner rule).</summary>
    private bool CalibrationOptional => Gadfly.Engine.ExamLanguage.IsEnglish(examLanguage) && Gadfly.Engine.ExamLanguage.IsEnglish(primary);

    private async Task CalibrateAsync(string language)
    {
        if (calibrating is not null || Tenant.OrganizationId is not { } org || Tenant.UserId is not { } user) return;
        calibrating = language;
        calibrationDone = 0;
        calibrationStatus = "getReady.calibration.opening";
        StateHasChanged();
        var terms = StudentLanguages.CalibrationTerms(language);
        var grant = Guid.NewGuid();
        calibrationGrant = grant;
        // A short recognizer grant for this calibration only: the hub filter allows exactly this language and these words.
        Grants.Arm(user, org, grant);
        Grants.SetVocabulary(user, grant, language, terms);
        var readings = new List<StudentLanguages.CalibrationReading>();
        try
        {
            calibrationModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/voice-calibration.js");
            await Task.Yield();
            if (!await calibrationModule.InvokeAsync<bool>("open", language, terms, calibrationLevel))
            {
                calibrationStatus = "getReady.calibration.couldntStart";
                return;
            }
            var text = StudentLanguages.CalibrationFor(language).Text;
            while (calibrating == language && readings.Count < StudentLanguages.CalibrationReadings)
            {
                calibrationStatus = "getReady.calibration.reading";
                StateHasChanged();
                var r = await calibrationModule.InvokeAsync<StudentLanguages.CalibrationReading>("reading", TimeSpan.FromSeconds(40), text);
                if (calibrating != language) return;
                readings.Add(r);
                calibrationDone = readings.Count;
            }
            var summary = StudentLanguages.Summarize(language, readings, Clock.GetUtcNow());
            if (summary is null) { calibrationStatus = "getReady.calibration.notHeard"; return; }
            await StudentLanguages.SaveCalibrationAsync(Scopes, org, user, new LanguageAnswers(spoken, primary), language, summary, Clock.GetUtcNow());
            calibrated = calibrated.Append(language).Distinct().ToList();
            calibrationStatus = "getReady.calibration.done";
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException or Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            calibrationStatus = "getReady.calibration.couldntStart";
        }
        finally
        {
            if (calibrationGrant == grant) await EndCalibrationAsync();
            StateHasChanged();
        }
    }

    /// <summary>The student stopped the calibration: nothing from this round is kept.</summary>
    private async Task StopCalibrationAsync()
    {
        calibrationStatus = "getReady.calibration.skipped";
        await EndCalibrationAsync();
    }

    private async Task EndCalibrationAsync()
    {
        calibrating = null;
        if (calibrationModule is not null)
        {
            try { await calibrationModule.InvokeVoidAsync("close"); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        }
        if (calibrationGrant is { } g && Tenant.UserId is { } user) Grants.Disarm(user, g);
        calibrationGrant = null;
    }

    private void ToggleSpoken(string tag, ChangeEventArgs e)
    {
        if (e.Value is true) { if (!spoken.Contains(tag)) spoken.Add(tag); }
        else spoken.Remove(tag);
        if (spoken.Count > 0 && !spoken.Contains(primary)) primary = spoken[0];
    }

    private void OnPrimaryChanged()
    {
        if (!spoken.Contains(primary)) spoken.Add(primary);
    }

    /// <summary>Loads the saved answers; a student who hasn't answered yet starts with the page's language ticked.</summary>
    private async Task LoadLanguagesAsync(Guid org, Guid user)
    {
        var saved = await StudentLanguages.LoadAsync(Scopes, org, user);
        offered = await StudentLanguages.OfferedAsync(Scopes, org, AssignmentId);
        calibrated = await StudentLanguages.CalibratedAsync(Scopes, org, user);
        examLanguage = StudentLanguages.DefaultExamLanguage(offered, saved?.Primary, T.Language);
        // The page speaks the exam language from the start, so what the student reads is what the exam will be in.
        if (examLanguage != T.Language && UiCatalog.Languages.Contains(examLanguage))
        {
            T.Use(examLanguage);
            rememberLanguage = true;
        }
        if (saved is not null)
        {
            spoken = saved.Spoken.ToList();
            primary = saved.Primary;
        }
        else
        {
            primary = T.Language;
            spoken = [primary];
        }
    }

    /// <summary>Saves the language answers; best effort, never stops the exam.</summary>
    private async Task SaveLanguagesAsync(Guid org, Guid user)
    {
        try { await StudentLanguages.SaveAsync(Scopes, org, user, new LanguageAnswers(spoken, primary), Clock.GetUtcNow()); }
        catch (Exception ex) when (ex is not OperationCanceledException) { }
    }

    /// <summary>The examiners on offer and the one chosen (GAD-T595); the remembered choice is read once the page is live.</summary>
    private IReadOnlyList<ExaminerOption> examiners = [];
    private ExaminerOption examiner = null!;
    private IJSObjectReference? prefsModule;

    private sealed record RememberedExaminer(string? Id, string? ModelUrl, string? PortraitUrl, ExaminerCustomization? Customization);

    /// <summary>The student's customization of the examiner as remembered on this device (GAD-T646), validated for the one shown;
    /// kept when the choice is saved again. None while the exam or organization fixes the examiner.</summary>
    private ExaminerCustomization customization = ExaminerCustomization.None;

    /// <summary>A sentence about the examiner, its pronouns following the one chosen (GAD-T606: "her", or "him" for the male examiner).</summary>
    private string Ex(string key) => new ExamRoomText(T, examiner is { Id: ExaminerCatalog.Male })[key];

    /// <summary>Shows the examiner the student chose last time on this device, if still offered.</summary>
    private async Task LoadExaminerChoiceAsync()
    {
        try
        {
            prefsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/device-prefs.js");
            var remembered = await prefsModule.InvokeAsync<RememberedExaminer?>("getExaminer");
            var pick = ExaminerCatalog.Pick(examiners, remembered?.Id);
            if (!examinerFixed) customization = remembered?.Customization?.Validate(pick.Id) ?? ExaminerCustomization.None;
            if (pick.Id != examiner.Id) { examiner = pick; StateHasChanged(); }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException) { }
    }

    /// <summary>The student picked an examiner: shown at once, remembered for the exam room, and her preview stops mid-line.</summary>
    private async Task ChooseExaminerAsync(ExaminerOption choice)
    {
        if (!choice.Available) return;
        examiner = choice;
        customization = customization.Validate(choice.Id);
        await SaveExaminerAsync();
        try
        {
            if (previewModule is not null) await previewModule.InvokeVoidAsync("stop");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException) { }
        preloading = false;
        _ = PreloadExaminerAsync();
    }

    /// <summary>Remembers the examiner shown and its customization on this device for the exam room (device-prefs.js setExaminer).</summary>
    private async Task SaveExaminerAsync()
    {
        try
        {
            prefsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/device-prefs.js");
            await prefsModule.InvokeVoidAsync("setExaminer", new
            {
                id = examiner.Id, modelUrl = examiner.ModelUrl, portraitUrl = examiner.PortraitUrl,
                customization = customization.IsEmpty ? null : customization,
            });
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException) { }
    }

    /// <summary>True when the exam or organization fixes the examiner (GAD-T504): no choice and no customization then.</summary>
    private bool examinerFixed;

    /// <summary>The ElevenLabs premade voices' names, in the order of ExaminerCustomization's lists.</summary>
    private static readonly IReadOnlyDictionary<string, string> VoiceNames =
        ExaminerCustomization.FemaleVoices.Zip(["Rachel", "Sarah", "Charlotte", "Alice", "Matilda", "Lily"])
            .Concat(ExaminerCustomization.MaleVoices.Zip(["Brian", "Daniel", "George", "Chris", "Eric", "Liam"]))
            .ToDictionary(p => p.First, p => p.Second);


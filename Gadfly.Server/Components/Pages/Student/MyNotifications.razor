@page "/my-notifications"
@attribute [Authorize(Policy = GadflyPolicies.Student)]
@using Gadfly.Server.Data
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject TimeProvider Clock
@inject Gadfly.Server.Localization.UiText T

@* A student's own notification choice (GAD-T310/GAD-T375): opting out of exam-due reminders only. *@

<PageTitle>@T["notifications.pageTitle"]</PageTitle>
<h1>@T["myExams.emailPrefs"]</h1>

@if (loaded)
{
    <EditForm Model="this" OnValidSubmit="SaveAsync" FormName="my-notifications" class="panel">
        <label class="check">
            <InputCheckbox @bind-Value="optedOut" />
            @T["notifications.optOut"]
        </label>
        <p class="hint">@T["notifications.explain"]</p>
        <button type="submit" disabled="@busy">@T["notifications.save"]</button>
        @if (message is not null)
        {
            <p role="status" class="@(ok ? "ok" : "error")">@message</p>
        }
    </EditForm>
}
else
{
    <p class="hint">@T["common.loading"]</p>
}

@code {
    private bool optedOut;
    private bool loaded, ok, busy;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } me) return;
        await using var scope = Scopes.CreateAsyncScopeFor(Gadfly.Server.Tenancy.TenantSnapshot.Of(Tenant));
        var db = scope.ServiceProvider.GetRequiredService<GadflyDbContext>();
        optedOut = await db.Set<StudentNotificationPreference>().AsNoTracking()
            .Where(p => p.OrganizationId == org && p.UserId == me).Select(p => (bool?)p.RemindersOptedOut).FirstOrDefaultAsync() ?? false;
        loaded = true;
    }

    private async Task SaveAsync()
    {
        if (Tenant.OrganizationId is not { } org || Tenant.UserId is not { } me || busy) return;
        busy = true;
        message = null;
        try
        {
            await using var scope = Scopes.CreateAsyncScopeFor(Gadfly.Server.Tenancy.TenantSnapshot.Of(Tenant));
            var db = scope.ServiceProvider.GetRequiredService<GadflyDbContext>();
            var row = await db.Set<StudentNotificationPreference>().FirstOrDefaultAsync(p => p.OrganizationId == org && p.UserId == me);
            if (row is null) db.Set<StudentNotificationPreference>().Add(row = new StudentNotificationPreference { OrganizationId = org, UserId = me });
            row.RemindersOptedOut = optedOut;
            row.UpdatedAt = Clock.GetUtcNow();
            await db.SaveChangesAsync();
            ok = true;
            message = T["notifications.saved"];
        }
        catch (Exception ex)
        {
            ok = false;
            message = T["notifications.failed", ex.Message];
        }
        finally { busy = false; }
    }
}

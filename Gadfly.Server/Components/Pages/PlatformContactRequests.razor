@page "/platform/requests"
@attribute [Authorize(Policy = GadflyPolicies.SuperAdmin)]
@using Gadfly.Server.Site
@inject ContactRequestService Requests

@* Demo and contact requests from the public site (GAD-T308), for the platform SuperAdmin: read them, note what was done,
   and mark them handled. Each change is written to the audit log. *@

<PageTitle>Contact requests · Gadfly Exams</PageTitle>
<h1>Contact requests</h1>
<p class="hint">Sent from the public site's <a href="contact">request-a-demo form</a>. Newest first.
    <a href="platform/organizations">Back to organizations</a></p>

<p>
    <label class="inline">
        <input type="checkbox" checked="@includeHandled" @onchange="ToggleHandledAsync" /> Show handled requests too
    </label>
</p>

@if (error is not null)
{
    <p class="error" role="alert">@error</p>
}

@if (rows is null)
{
    <p class="hint" role="status">Loading…</p>
}
else if (rows.Count == 0)
{
    <p class="notice">@(includeHandled ? "No requests yet." : "No open requests. Tick \"Show handled requests too\" to see earlier ones.")</p>
}
else
{
    <div class="table-scroll">
        <table class="grid">
            <caption class="visually-hidden">Contact requests</caption>
            <thead>
                <tr><th scope="col">Received</th><th scope="col">From</th><th scope="col">Asked for</th><th scope="col">Message</th><th scope="col">Status</th></tr>
            </thead>
            <tbody>
                @foreach (var r in rows)
                {
                    <tr>
                        <td>@r.ReceivedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        <td>
                            <strong>@r.Name</strong><br />
                            <a href="mailto:@r.Email">@r.Email</a><br />
                            @r.Institution@(r.Role is null ? "" : $", {r.Role}")
                        </td>
                        <td>@r.Topic@(r.Plan is null ? "" : $" ({r.Plan})")@(r.Students is null ? "" : $"; {r.Students} students")</td>
                        <td class="message">@(r.Message ?? "—")</td>
                        <td>
                            @if (r.HandledAt is { } at)
                            {
                                <span class="ok">Handled @at.ToString("yyyy-MM-dd")</span>
                                @if (!string.IsNullOrEmpty(r.Note)) { <br /><span class="hint">@r.Note</span> }
                                <br /><button type="button" class="link" disabled="@busy" @onclick="() => MarkAsync(r, false)">Reopen</button>
                            }
                            else
                            {
                                <label>Note <small class="hint">(optional)</small>
                                    <input value="@Note(r.Id)" maxlength="1000" @onchange="e => notes[r.Id] = e.Value?.ToString()" aria-label="Note for @r.Name" />
                                </label>
                                <button type="button" disabled="@busy" @onclick="() => MarkAsync(r, true)">Mark handled</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<Gadfly.Server.Data.ContactRequest>? rows;
    private readonly Dictionary<Guid, string?> notes = [];
    private bool includeHandled, busy;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private string? Note(Guid id) => notes.TryGetValue(id, out var n) ? n : null;

    private async Task LoadAsync()
    {
        try { rows = await Requests.ListAsync(includeHandled); error = null; }
        catch (Exception ex) { error = "The requests could not be loaded: " + ex.Message; rows ??= []; }
    }

    private async Task ToggleHandledAsync(ChangeEventArgs e)
    {
        includeHandled = e.Value is true;
        await LoadAsync();
    }

    private async Task MarkAsync(Gadfly.Server.Data.ContactRequest r, bool handled)
    {
        if (busy) return;   // the service shares the circuit's DbContext: one operation at a time
        busy = true;
        try
        {
            if (!await Requests.MarkAsync(r.Id, handled, handled ? Note(r.Id) : r.Note))
                error = "That request no longer exists.";
            else
                notes.Remove(r.Id);
            await LoadAsync();
        }
        catch (Exception ex) { error = "The change was not saved: " + ex.Message; }
        finally { busy = false; }
    }
}

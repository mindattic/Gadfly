@page "/org/lti"
@attribute [Authorize(Policy = GadflyPolicies.OrgAdmin)]
@using Gadfly.Server.Lti
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject NavigationManager Nav
@inject IJSRuntime JS

@* LMS connection (GAD-T312/GAD-T384): LTI 1.3 set-up for this organization, with a step-by-step guide per LMS. *@

<PageTitle>LMS connection · Gadfly Exams</PageTitle>
<h1>LMS connection (LTI 1.3) <HelpLink Topic="lti-setup" /></h1>
<AdminNav />

<style>
    .lti-urls { display: grid; grid-template-columns: max-content 1fr max-content; gap: .4rem .75rem; align-items: center; max-width: 900px; }
    .lti-urls code { overflow-wrap: anywhere; }
    .lti-tabs { display: flex; flex-wrap: wrap; gap: .4rem; margin: .5rem 0 1rem; }
    .lti-tabs button[aria-pressed="true"] { outline: 2px solid var(--accent); }
    .lti-steps { max-width: 900px; }
    .lti-steps li { margin-bottom: .55rem; }
    .lti-steps code { overflow-wrap: anywhere; }
    .lti-wide { max-width: 900px; }
    @@media (max-width: 700px) { .lti-urls { grid-template-columns: 1fr; } }
</style>

<p class="hint lti-wide">
    Connect Canvas, Moodle, Blackboard or Brightspace so instructors add a Gadfly exam to a course from the LMS, students open it
    straight from their course (no separate password), and each released grade goes back to the LMS gradebook.
    Set-up takes two halves: register Gadfly in your LMS (step 1), then tell Gadfly about your LMS (step 2).
</p>

<h2 class="section">Step 1: Gadfly's addresses, to enter in your LMS</h2>
<div class="lti-urls" role="list">
    @foreach (var (label, value) in ToolRows)
    {
        <span role="listitem"><strong>@label</strong></span>
        <code>@value</code>
        <button type="button" class="link" @onclick="() => CopyAsync(value)">@(copiedValue == value ? "Copied" : "Copy")</button>
    }
</div>
<p class="hint lti-wide">Signing: RS256 with a public key set (JWKS) URL. Gadfly never needs a shared secret.</p>

<h2 class="section">How to set it up in your LMS</h2>
<div class="lti-tabs" role="group" aria-label="Choose your LMS">
    @foreach (var kind in Enum.GetValues<LtiPlatformKind>())
    {
        <button type="button" class="link" aria-pressed="@(guide == kind ? "true" : "false")" @onclick="() => guide = kind">@LtiPlatformGuide.Label(kind)</button>
    }
</div>
<div class="lti-steps">
    @switch (guide)
    {
        case LtiPlatformKind.Canvas:
            <ol>
                <li>In Canvas, as an account admin: <strong>Admin → (your account) → Developer Keys → + Developer Key → + LTI Key</strong>. Choose <em>Manual Entry</em>.</li>
                <li>Key name: <em>Gadfly Exams</em>. <strong>Redirect URIs</strong>: <code>@urls.Launch</code>. <strong>Title</strong>: Gadfly Exams.
                    <strong>Target Link URI</strong>: <code>@urls.Launch</code>. <strong>OpenID Connect Initiation Url</strong>: <code>@urls.Login</code>.
                    <strong>JWK Method</strong>: Public JWK URL, <code>@urls.Jwks</code>.</li>
                <li><strong>LTI Advantage Services</strong>: turn on "Can create and view assignment data in the gradebook associated with the tool",
                    "Can create and update submission results for assignments associated with the tool" and
                    "Can retrieve user data associated with the context the tool is installed in".</li>
                <li><strong>Placements</strong>: add <em>Assignment Selection</em> and <em>Link Selection</em>. For each, set Message Type to
                    <em>LtiDeepLinkingRequest</em> and Target Link URI to <code>@urls.Launch</code>.</li>
                <li><strong>Privacy level</strong> (under Additional Settings): <em>Public</em>, so Gadfly receives each person's name and email. Save.</li>
                <li>Switch the new key <strong>ON</strong> and copy its <strong>Client ID</strong> (the number in the Details column).</li>
                <li>Install it: <strong>Admin → Settings → Apps → View App Configurations → + App</strong>, Configuration Type <em>By Client ID</em>, paste the Client ID, Install.</li>
                <li>On the installed app's gear menu choose <strong>Deployment Id</strong> and copy it.</li>
                <li>In step 2 below, press <em>Fill in for Canvas</em>, then paste the Client ID and Deployment ID. (Canvas test and beta environments use the issuer
                    <code>https://canvas.test.instructure.com</code> or <code>https://canvas.beta.instructure.com</code> instead; a self-hosted Canvas uses its own values.)</li>
                <li>Instructors then create an assignment with Submission type <em>External Tool</em>, press Find, choose Gadfly Exams and pick the exam.
                    Tick <em>Load This Tool In A New Tab</em>: the exam needs the camera and microphone, which work best in their own window.</li>
            </ol>
            break;
        case LtiPlatformKind.Moodle:
            <ol>
                <li>In Moodle (4.x), as a site administrator: <strong>Site administration → Plugins → Activity modules → External tool → Manage tools → configure a tool manually</strong>.</li>
                <li><strong>Tool name</strong>: Gadfly Exams. <strong>Tool URL</strong>: <code>@urls.Launch</code>. <strong>LTI version</strong>: LTI 1.3.</li>
                <li><strong>Public key type</strong>: Keyset URL. <strong>Public keyset</strong>: <code>@urls.Jwks</code>.
                    <strong>Initiate login URL</strong>: <code>@urls.Login</code>. <strong>Redirection URI(s)</strong>: <code>@urls.Launch</code>.</li>
                <li><strong>Tool configuration usage</strong>: Show in activity chooser and as a preconfigured tool. <strong>Default launch container</strong>: New window.</li>
                <li>Tick <strong>Supports Deep Linking (Content-Item Message)</strong>, and set <strong>Content Selection URL</strong> to <code>@urls.Launch</code>.</li>
                <li><strong>Services</strong>: IMS LTI Assignment and Grade Services, "Use this service for grade sync and column management";
                    IMS LTI Names and Role Provisioning, "Use this service to retrieve members' information as per privacy settings".</li>
                <li><strong>Privacy</strong>: share the launcher's name with the tool, Always; share the launcher's email, Always; accept grades from the tool, Always. Save changes.</li>
                <li>On the tool's card press the <strong>View configuration details</strong> icon. It shows the Platform ID, Client ID and Deployment ID.</li>
                <li>In step 2 below, type your Moodle address, press <em>Fill in for Moodle</em>, then paste the Client ID and Deployment ID
                    (the Platform ID should equal the issuer Gadfly filled in).</li>
                <li>Teachers then add an activity: <em>External tool</em>, choose Gadfly Exams, press <em>Select content</em> and pick the exam.</li>
            </ol>
            break;
        case LtiPlatformKind.Blackboard:
            <ol>
                <li>Register Gadfly on the <strong>Anthology (Blackboard) Developer Portal</strong>, developer.blackboard.com: <strong>My Apps → + → Manually register your application</strong>.</li>
                <li><strong>Application name</strong>: Gadfly Exams. <strong>Domain(s)</strong>: <code>@urls.Domain</code>.
                    <strong>Login Initiation URL</strong>: <code>@urls.Login</code>. <strong>Tool Redirect URL(s)</strong>: <code>@urls.Launch</code>.
                    <strong>Tool JWKS URL</strong>: <code>@urls.Jwks</code>. <strong>Signing algorithm</strong>: RS256. Register.</li>
                <li>Copy the <strong>Application ID</strong>: it is the client ID. The portal also lists the issuer, key set, token and OIDC addresses that step 2 fills in.</li>
                <li>In Blackboard Learn, as an administrator: <strong>Administrator Panel → Integrations → LTI Tool Providers → Register LTI 1.3/Advantage Tool</strong>, paste the client ID, Submit.
                    Copy the <strong>Deployment ID</strong> it shows.</li>
                <li>On the same page set <strong>Tool Status</strong>: Approved. <strong>Institution policies</strong>: send role in course, name and email;
                    allow grade service access, Yes; allow membership service access, Yes. Submit.</li>
                <li>From the tool's menu choose <strong>Manage Placements → Create Placement</strong>: label Gadfly Exams, type <em>Deep Linking content tool</em>,
                    Target Link URI <code>@urls.Launch</code>, and tick <em>Launch in new window</em>.</li>
                <li>In step 2 below, paste the client ID, press <em>Fill in for Blackboard Learn</em>, then paste the Deployment ID.</li>
                <li>Instructors then add content from <em>Content Market</em> (Ultra) or <em>Build Content</em> (Original), choose Gadfly Exams and pick the exam.</li>
            </ol>
            break;
        case LtiPlatformKind.Brightspace:
            <ol>
                <li>In Brightspace, as an administrator: <strong>Admin Tools → Manage Extensibility → LTI Advantage → Register Tool</strong>, registration type <em>Standard</em>.</li>
                <li><strong>Name</strong>: Gadfly Exams. <strong>Domain</strong>: <code>https://@urls.Domain</code>. <strong>Redirect URLs</strong>: <code>@urls.Launch</code>.
                    <strong>OpenID Connect Login URL</strong>: <code>@urls.Login</code>. <strong>Target Link URI</strong>: <code>@urls.Launch</code>.
                    <strong>Keyset URL</strong>: <code>@urls.Jwks</code>.</li>
                <li><strong>Extensions</strong>: tick Assignment and Grade Services, Deep Linking, and Names and Role Provisioning Services. Register.</li>
                <li>The confirmation lists the <strong>Client Id</strong>, the issuer, the OpenID Connect authentication endpoint, the key set, the token URL and the token audience. Copy the Client Id.</li>
                <li><strong>View Deployments → New Deployment</strong>: choose Gadfly Exams, tick the same three extensions, and under Security Settings send the org unit and
                    user information (name, email) and the classlist. Choose which org units may use it. Create, and copy the <strong>Deployment Id</strong>.</li>
                <li>On the deployment choose <strong>View Links → New Link</strong>: type <em>Deep Linking Quicklink</em>, URL <code>@urls.Launch</code>.</li>
                <li>In step 2 below, type your Brightspace address, press <em>Fill in for D2L Brightspace</em>, then paste the Client Id and Deployment Id.
                    Check the filled-in issuer matches the one Brightspace showed.</li>
                <li>Instructors then use <em>Existing Activities → Gadfly Exams</em> in a course's content, pick the exam, and set it to <em>Open as External Resource</em> (a new window).</li>
            </ol>
            break;
    }
</div>

<h2 class="section">Step 2: tell Gadfly about your LMS</h2>
<EditForm Model="form" OnValidSubmit="SaveAsync" FormName="lti-registration" class="panel lti-wide">
    <h2>@(editing is null ? "Add a connection" : "Change the connection")</h2>
    @if (editing is null)
    {
        <div class="row-actions">
            <label>LMS
                <select @bind="presetKind">
                    @foreach (var kind in Enum.GetValues<LtiPlatformKind>())
                    {
                        <option value="@kind">@LtiPlatformGuide.Label(kind)</option>
                    }
                </select>
            </label>
            @if (LtiPlatformGuide.NeedsSiteUrl(presetKind))
            {
                <label>Your @LtiPlatformGuide.Label(presetKind) address <input type="url" @bind="presetSite" placeholder="https://lms.example.edu" maxlength="500" /></label>
            }
            <button type="button" class="link" @onclick="FillPreset">Fill in for @LtiPlatformGuide.Label(presetKind)</button>
        </div>
    }
    <label>Name (for this page) <InputText @bind-Value="form.Name" maxlength="200" placeholder="Canvas - main campus" /></label>
    <label>Issuer (platform ID) <InputText @bind-Value="form.Issuer" maxlength="500" disabled="@(editing is not null)" autocomplete="off" /></label>
    <label>Client ID <InputText @bind-Value="form.ClientId" maxlength="200" disabled="@(editing is not null)" autocomplete="off" /></label>
    <label>Deployment ID <InputText @bind-Value="form.DeploymentId" maxlength="200" disabled="@(editing is not null)" autocomplete="off" /></label>
    <label>OIDC login (authentication request) URL <InputText @bind-Value="form.AuthLoginUrl" type="url" maxlength="1000" autocomplete="off" /></label>
    <label>Access token URL <InputText @bind-Value="form.AuthTokenUrl" type="url" maxlength="1000" autocomplete="off" /></label>
    <label>Public key set (JWKS) URL <InputText @bind-Value="form.KeySetUrl" type="url" maxlength="1000" autocomplete="off" /></label>
    <label>Token audience <span class="hint">(only if your LMS names one; Brightspace does)</span> <InputText @bind-Value="form.TokenAudience" maxlength="1000" autocomplete="off" /></label>
    @if (editing is not null)
    {
        <p class="hint">The issuer, client ID and deployment ID identify the connection and can't be changed. For a new registration, add a new connection.</p>
    }
    <div class="row-actions">
        <button type="submit" disabled="@busy">@(editing is null ? "Add connection" : "Save changes")</button>
        @if (editing is not null)
        {
            <button type="button" class="link" @onclick="CancelEdit">Cancel</button>
        }
    </div>
    @if (message is not null)
    {
        <p role="status" class="@(ok ? "ok" : "error")">@message</p>
    }
</EditForm>

<h2 class="section">Connections</h2>
@if (tableMessage is not null)
{
    <p role="status" class="@(tableOk ? "ok" : "error")">@tableMessage</p>
}
@if (loadError is not null)
{
    <p class="error" role="alert">@loadError</p>
}
else if (regs is null)
{
    <p class="hint" role="status">Loading…</p>
}
else if (regs.Count == 0)
{
    <p class="notice">No LMS is connected yet. Follow the two steps above.</p>
}
else
{
    <table class="grid">
        <thead><tr><th>Name</th><th>Issuer</th><th>Client ID</th><th>Deployment ID</th><th class="num">Placements</th><th class="num">People</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in regs)
            {
                <tr>
                    <td>@r.Name</td>
                    <td><code>@r.Issuer</code></td>
                    <td><code>@r.ClientId</code></td>
                    <td><code>@r.DeploymentId</code></td>
                    <td class="num">@r.Placements</td>
                    <td class="num">@r.People</td>
                    <td>@if (r.Enabled) { <span class="ok">on</span> } else { <span class="muted">off</span> }</td>
                    <td>
                        @if (confirming == r.Id)
                        {
                            <div class="row-actions">
                                <span>Remove @r.Name?</span>
                                <button type="button" class="danger" @onclick="() => DeleteAsync(r.Id)">Remove</button>
                                <button type="button" class="link" @onclick="() => confirming = null">Cancel</button>
                            </div>
                        }
                        else
                        {
                            <div class="row-actions">
                                <button type="button" class="link" @onclick="() => Edit(r)">Change…</button>
                                <button type="button" class="link" @onclick="() => SetEnabledAsync(r.Id, !r.Enabled)">@(r.Enabled ? "Turn off" : "Turn on")</button>
                                @if (r.Placements == 0 && r.People == 0)
                                {
                                    <button type="button" class="link" @onclick="() => confirming = r.Id">Remove…</button>
                                }
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="section">Placements</h2>
<p class="hint lti-wide">
    A placement is one Gadfly exam added to one LMS course. It appears here the first time someone opens it from the course.
    Released grades go back to the LMS within a few minutes. A roster sync makes everyone in the course a member here, with
    instructors as Instructors and learners as Students, before they ever open the exam.
</p>
@if (placements is null)
{
    @if (loadError is null)
    {
        <p class="hint" role="status">Loading…</p>
    }
}
else if (placements.Count == 0)
{
    <p class="notice">No placements yet. Once an instructor adds a Gadfly exam to a course and it is opened once, it shows here.</p>
}
else
{
    <table class="grid">
        <thead><tr><th>Exam</th><th>Course</th><th>Connection</th><th>Gradebook</th><th class="num">Students</th><th class="num">Grades sent</th><th>Roster</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in placements)
            {
                <tr>
                    <td>@p.ExamTitle</td>
                    <td><code>@p.ContextId</code></td>
                    <td>@p.RegistrationName</td>
                    <td>@(p.HasLineItem ? "linked" : "not offered by the LMS")</td>
                    <td class="num">@p.Students</td>
                    <td class="num">@p.GradesSent</td>
                    <td>@(p.HasRoster ? (p.LastRosterSyncAt is null ? "never synced" : "synced " + AdminDb.When(p.LastRosterSyncAt)) : "not offered by the LMS")</td>
                    <td>
                        @if (p.HasRoster)
                        {
                            <button type="button" class="link" disabled="@(syncing == p.Id)" @onclick="() => SyncAsync(p.Id)">@(syncing == p.Id ? "Syncing…" : "Sync roster")</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private LtiRegistrationInput form = new();
    private Guid? editing;
    private LtiPlatformKind guide = LtiPlatformKind.Canvas;
    private LtiPlatformKind presetKind = LtiPlatformKind.Canvas;
    private string? presetSite;
    private List<LtiRegistrationRow>? regs;
    private List<LtiResourceLinkRow>? placements;
    private Guid? confirming, syncing;
    private string? message, tableMessage, loadError, copiedValue;
    private bool ok, tableOk, busy;
    private LtiToolUrls urls = LtiToolUrls.For("https://localhost");

    private IEnumerable<(string Label, string Value)> ToolRows =>
    [
        ("Redirect / launch URL (also the target link URI and deep-linking URL)", urls.Launch),
        ("OIDC login initiation URL", urls.Login),
        ("Public key set (JWKS) URL", urls.Jwks),
        ("Domain", urls.Domain),
    ];

    protected override async Task OnInitializedAsync()
    {
        urls = LtiToolUrls.For(Nav.BaseUri);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            (regs, placements) = await AdminDb.RunAsync(Scopes, Tenant, async (sp, _) =>
            {
                var svc = sp.GetRequiredService<LtiAdminService>();
                return ((await svc.ListAsync()).ToList(), (await svc.PlacementsAsync()).ToList());
            });
            loadError = null;
        }
        catch (Exception e) when (e is UnauthorizedAccessException or InvalidOperationException)
        {
            loadError = "This page could not be loaded: " + e.Message;
        }
    }

    private void FillPreset()
    {
        var (values, problem) = LtiPlatformGuide.Preset(presetKind, presetSite, form.ClientId);
        if (values is null) { ok = false; message = problem; return; }
        form.Name = string.IsNullOrWhiteSpace(form.Name) ? values.Name : form.Name;
        form.Issuer = values.Issuer;
        form.AuthLoginUrl = values.AuthLoginUrl;
        form.AuthTokenUrl = values.AuthTokenUrl;
        form.KeySetUrl = values.KeySetUrl;
        form.TokenAudience = values.TokenAudience;
        ok = true;
        message = presetKind == LtiPlatformKind.Blackboard && string.IsNullOrWhiteSpace(form.ClientId)
            ? "Filled in. Paste the client ID and press Fill in again to complete the key set URL, then add the deployment ID."
            : "Filled in. Check the values against what your LMS shows, add the client ID and deployment ID, then add the connection.";
    }

    private async Task SaveAsync()
    {
        busy = true;
        message = null;
        try
        {
            var id = editing;
            var input = form;
            var result = await AdminDb.RunAsync(Scopes, Tenant, (sp, _) => id is { } g
                ? sp.GetRequiredService<LtiAdminService>().UpdateAsync(g, input)
                : sp.GetRequiredService<LtiAdminService>().CreateAsync(input));
            ok = result.Ok;
            message = result.Message;
            if (result.Ok) { form = new(); editing = null; await LoadAsync(); }
        }
        catch (Exception e)
        {
            ok = false;
            message = "The connection could not be saved: " + e.Message;
        }
        finally { busy = false; }
    }

    private void Edit(LtiRegistrationRow r)
    {
        editing = r.Id;
        form = new LtiRegistrationInput
        {
            Name = r.Name, Issuer = r.Issuer, ClientId = r.ClientId, DeploymentId = r.DeploymentId,
            AuthLoginUrl = r.AuthLoginUrl, AuthTokenUrl = r.AuthTokenUrl, KeySetUrl = r.KeySetUrl, TokenAudience = r.TokenAudience,
        };
        message = null;
    }

    private void CancelEdit()
    {
        editing = null;
        form = new();
        message = null;
    }

    private async Task SetEnabledAsync(Guid id, bool enabled)
    {
        var result = await AdminDb.RunAsync(Scopes, Tenant, (sp, _) => sp.GetRequiredService<LtiAdminService>().SetEnabledAsync(id, enabled));
        tableOk = result.Ok;
        tableMessage = result.Message;
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        var result = await AdminDb.RunAsync(Scopes, Tenant, (sp, _) => sp.GetRequiredService<LtiAdminService>().DeleteAsync(id));
        confirming = null;
        tableOk = result.Ok;
        tableMessage = result.Message;
        await LoadAsync();
    }

    private async Task SyncAsync(Guid placementId)
    {
        syncing = placementId;
        try
        {
            var result = await AdminDb.RunAsync(Scopes, Tenant, (sp, _) => sp.GetRequiredService<LtiAdminService>().SyncRosterAsync(placementId));
            tableOk = result.Ok;
            tableMessage = result.Message;
        }
        catch (Exception e)
        {
            tableOk = false;
            tableMessage = "The roster could not be synced: " + e.Message;
        }
        finally { syncing = null; }
        await LoadAsync();
    }

    private async Task CopyAsync(string value)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            copiedValue = value;
        }
        catch (JSException)
        {
            tableOk = false;
            tableMessage = "The browser would not copy; select the address and copy it by hand.";
        }
    }
}

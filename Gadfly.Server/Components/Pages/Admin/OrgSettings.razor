@page "/org/settings"
@attribute [Authorize(Policy = GadflyPolicies.OrgAdmin)]
@using System.ComponentModel.DataAnnotations
@using Gadfly.Server.Data
@using Gadfly.Server.Tenancy
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject TimeProvider Clock

@* Organization settings (GAD-T55): retention (GAD-T61, decision D7), cost quota, voice/avatar defaults, EU voice measurements (GAD-T259), single grader (GAD-T285), separate reconciler and approver (GAD-T444). *@

<PageTitle>Settings · Gadfly Exams</PageTitle>
<h1>Organization settings <HelpLink Topic="admin-guide" Anchor="organization-settings" /></h1>
<AdminNav />

@if (form is null)
{
    <p class="hint" role="status">Loading…</p>
}
else
{
    <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="org-settings" class="panel">
        <DataAnnotationsValidator />
        <h2>Data retention</h2>
        <label>Keep what students said for (days)
            <InputNumber @bind-Value="form.RetentionDays" min="7" max="3650" />
        </label>
        <ValidationMessage For="() => form.RetentionDays" class="error" />
        <p class="hint">
            When an ended exam session is older than this, a daily job redacts what the student said: typed and
            spoken answers, word timings, speech metrics, quoted claims, the raw detail of integrity
            events and the saved session transcript. The outcome stays: judgments, concept mastery, the AI report
            and the instructor's grade. Answer audio and video are never stored in the first place. Shortening the
            period applies to existing sessions at the next daily run, and redaction cannot be undone. Allowed: 7
            to 3650 days (default 90).
        </p>

        <h2>Monthly cost quota</h2>
        <label>Provider cost ceiling per month (USD)
            <InputNumber @bind-Value="form.MonthlyCostQuotaUsd" min="0" step="0.01" placeholder="No limit" />
        </label>
        <ValidationMessage For="() => form.MonthlyCostQuotaUsd" class="error" />
        <p class="hint">Leave empty for no limit. Only AI panel (LLM) costs are counted against it today (see Usage); speech-to-text and text-to-speech are not yet metered.</p>

        <h2>Voice exam defaults</h2>
        <label>Default voice id
            <InputText @bind-Value="form.DefaultVoiceId" autocomplete="off" placeholder="Platform default" />
        </label>
        <ValidationMessage For="() => form.DefaultVoiceId" class="error" />
        <label>Default avatar id
            <InputText @bind-Value="form.DefaultAvatarId" autocomplete="off" placeholder="Platform default (examiner-f or examiner-m)" />
        </label>
        <ValidationMessage For="() => form.DefaultAvatarId" class="error" />
        <p class="hint">The voice id is an ElevenLabs voice id (letters and digits, from the voice's page in ElevenLabs). Every exam speaks with it unless the exam sets its own; leave it empty for the platform voice. The avatar id is saved for a later release: today every exam shows the platform's examiner (GAD-T475).</p>
        @* GAD-T415, GAD-T617: the examiner's voice quality/speed tier, with what each tier has measured on live exams. *@
        <label>Examiner voice quality
            <InputSelect @bind-Value="form.VoiceTier">
                <option value="">Platform default (Fast)</option>
                @foreach (var tier in Gadfly.Server.Voice.VoiceTier.All)
                {
                    <option value="@tier.Id">@tier.Label</option>
                }
            </InputSelect>
        </label>
        <ul class="hint">
            @foreach (var tier in Gadfly.Server.Voice.VoiceTier.All)
            {
                var measured = latency?.FirstOrDefault(m => m.Tier == tier);
                <li>
                    <strong>@tier.Label</strong>: @tier.Hint
                    @if (measured is { Count: > 0, MedianMs: { } median })
                    {
                        <text> Measured on live exams in the last @Gadfly.Server.Voice.VoiceTierLatency.Days days: median @median ms to first audio over @measured.Count question@(measured.Count == 1 ? "" : "s").</text>
                    }
                    else
                    {
                        <text> No measurements yet.</text>
                    }
                </li>
            }
        </ul>
        <p class="hint">Every voice exam uses this unless the exam sets its own. A tier whose voice model does not speak an exam's language falls back to the platform's model for that language. Changing it is recorded in the audit log.</p>

        <h2>What instructors see</h2>
        <label class="check">
            <InputCheckbox @bind-Value="form.InstructorsSeeOnlyOwn" />
            Instructors see and manage only what they created
        </label>
        <p class="hint">
            On (the default): an instructor sees only the courses, source collections and assessments they created, and
            the assignments, sessions, review, grading queue and analytics under them. Opening another instructor's item
            by its address is refused and recorded. Owners and admins always see the whole organization. Off: every
            instructor sees everything in the organization. Examiners and second reviewers see the whole organization
            either way, because grading is not assigned to individual examiners. Applies within about 15 seconds.
        </p>

        <h2>Separation of duties in grading</h2>
        <label class="check">
            <InputCheckbox @bind-Value="form.AllowSingleGrader" />
            Allow a single grader (small organization)
        </label>
        <p class="hint">
            Off (the default): whoever entered a grade's human score cannot also reconcile its AI-human disagreements or approve
            it; someone else in the organization (another instructor, an admin, or a second reviewer for reconciliation) must.
            Turn this on only when one person does all the grading, for example a one-person organization or while trying Gadfly
            out alone. Every reconciliation or approval it lets through is recorded in the audit log as a waiver, and turning
            this setting on or off is recorded too.
        </p>
        <label>Separate reconciler and approver
            <InputSelect @bind-Value="form.ApproverSeparation">
                <option value="@ApproverSeparationSetting.Automatic">@Gadfly.Server.Grading.ApproverSeparation.Describe(ApproverSeparationSetting.Automatic)</option>
                <option value="@ApproverSeparationSetting.Always">@Gadfly.Server.Grading.ApproverSeparation.Describe(ApproverSeparationSetting.Always)</option>
                <option value="@ApproverSeparationSetting.Off">@Gadfly.Server.Grading.ApproverSeparation.Describe(ApproverSeparationSetting.Off)</option>
            </InputSelect>
        </label>
        <p class="hint">
            A disagreement between the AI and the human score is reconciled by one person, and the grade is then approved. With
            Automatic (the default), whoever reconciled the grade (or was the second reviewer on it) cannot approve it while
            another active instructor or admin who neither scored nor reconciled it could; in a two-person team, or with "Allow a
            single grader" on, they may, and the audit log records it. Always never allows it, even if no one else can approve.
            Changing this setting is recorded in the audit log.
        </p>

        <h2>Voice measurements and the EU</h2>
        <label class="check">
            <InputCheckbox @bind-Value="form.InEuropeanUnion" />
            This organization is in the EU or EEA, or examines students there
        </label>
        <label>Voice measurements in voice exams
            <InputSelect @bind-Value="form.VoiceMeasures">
                <option value="@VoiceMeasuresSetting.RegionDefault">Default: off in the EU/EEA, on elsewhere</option>
                <option value="@VoiceMeasuresSetting.Off">Off for everyone</option>
                <option value="@VoiceMeasuresSetting.On">On for everyone, EU included</option>
            </InputSelect>
        </label>
        <p class="hint">
            When on, each spoken answer's pitch, jitter, loudness, speech rate and pausing are compared with the student's own
            first answers. Reviewers see the raw differences (never "strain" or "stress"). They never change how hard the
            examiner presses (that comes from what the answer says) and never change a grade. The EU AI Act prohibits emotion recognition in education (Art. 5(1)(f)), and the
            Commission reads voice-based arousal or anxiety detection in exams as that, so by default these measurements are off
            for an EU/EEA organization and for any student marked as living in the EU/EEA when assigned. When off, the voice
            numbers are discarded. Choose "On for everyone" only after counsel
            has confirmed it is lawful for you.
        </p>

        <h2>Email notifications</h2>
        <label class="check">
            <InputCheckbox @bind-Value="form.EmailNotificationsEnabled" />
            Send Gadfly's own notification emails
        </label>
        <p class="hint">
            On (the default): students get emailed when an exam is assigned, before it's due, when a result is released,
            and about their own appeals; staff accommodations like an attempt reset are emailed too. Off: none of these
            send for this organization. A student can separately opt out of reminders only, from their own account;
            result-released emails never stop, since they're operationally important.
        </p>

        <button type="submit" disabled="@busy">Save settings</button>
        @if (message is not null)
        {
            <p role="status" class="@(ok ? "ok" : "error")">@message</p>
        }
        @if (updatedAt is { } u)
        {
            <p class="hint">Last changed @AdminDb.When(u).</p>
        }
    </EditForm>
}

@code {
    private sealed class Form
    {
        [Range(7, 3650, ErrorMessage = "Retention must be between 7 and 3650 days.")]
        public int RetentionDays { get; set; } = 90;

        [Range(typeof(decimal), "0", "1000000000", ErrorMessage = "The quota must be zero or more.")]
        public decimal? MonthlyCostQuotaUsd { get; set; }

        [StringLength(100, ErrorMessage = "At most 100 characters.")]
        [RegularExpression(@"^\s*[A-Za-z0-9]{10,64}\s*$", ErrorMessage = "That doesn't look like an ElevenLabs voice id (letters and digits only).")]
        public string? DefaultVoiceId { get; set; }

        [StringLength(100, ErrorMessage = "At most 100 characters.")]
        public string? DefaultAvatarId { get; set; }

        /// <summary>A <see cref="Gadfly.Server.Voice.VoiceTier"/> id, or empty for the platform default (GAD-T617).</summary>
        public string? VoiceTier { get; set; }

        public bool InstructorsSeeOnlyOwn { get; set; } = true;

        public bool InEuropeanUnion { get; set; }

        public VoiceMeasuresSetting VoiceMeasures { get; set; } = VoiceMeasuresSetting.RegionDefault;

        public bool AllowSingleGrader { get; set; }

        public ApproverSeparationSetting ApproverSeparation { get; set; } = ApproverSeparationSetting.Automatic;

        public bool EmailNotificationsEnabled { get; set; } = true;
    }

    private Form? form;
    private IReadOnlyList<Gadfly.Server.Voice.VoiceTierLatency.Measure>? latency;
    private DateTimeOffset? updatedAt;
    private string? message;
    private bool ok, busy;

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.OrganizationId is not { } org) return;
        var row = await AdminDb.RunAsync(Scopes, Tenant, (_, db) =>
            db.OrganizationSettings.AsNoTracking().FirstOrDefaultAsync(s => s.OrganizationId == org));
        form = new Form
        {
            RetentionDays = row?.RetentionDays ?? 90,
            MonthlyCostQuotaUsd = row?.MonthlyCostQuotaUsd,
            DefaultVoiceId = row?.DefaultVoiceId,
            DefaultAvatarId = row?.DefaultAvatarId,
            VoiceTier = Gadfly.Server.Voice.VoiceTier.Normalize(row?.VoiceTier) ?? "",
            InstructorsSeeOnlyOwn = row?.InstructorsSeeOnlyOwn ?? true,
            InEuropeanUnion = row?.InEuropeanUnion ?? false,
            VoiceMeasures = row?.VoiceMeasures ?? VoiceMeasuresSetting.RegionDefault,
            AllowSingleGrader = row?.AllowSingleGrader ?? false,
            ApproverSeparation = row?.ApproverSeparation ?? ApproverSeparationSetting.Automatic,
            EmailNotificationsEnabled = row?.EmailNotificationsEnabled ?? true,
        };
        updatedAt = row is null || row.UpdatedAt == default ? null : row.UpdatedAt;
        try
        {
            latency = await AdminDb.RunAsync(Scopes, Tenant, (_, db) => Gadfly.Server.Voice.VoiceTierLatency.ForTiersAsync(db, Clock.GetUtcNow()));
        }
        catch (Exception)
        {
            latency = null;   // the measurements are a hint; the settings still load without them
        }
    }

    private async Task SaveAsync()
    {
        if (form is null || Tenant.OrganizationId is not { } org) return;
        busy = true;
        message = null;
        try
        {
            var now = Clock.GetUtcNow();
            await AdminDb.RunAsync(Scopes, Tenant, async (_, db) =>
            {
                var row = await db.OrganizationSettings.FirstOrDefaultAsync(s => s.OrganizationId == org);
                if (row is null) db.OrganizationSettings.Add(row = new OrganizationSettings { OrganizationId = org });
                row.RetentionDays = Math.Clamp(form.RetentionDays, 7, 3650);
                row.MonthlyCostQuotaUsd = form.MonthlyCostQuotaUsd is { } q ? Math.Round(q, 2) : null;
                row.DefaultVoiceId = Clean(form.DefaultVoiceId);
                row.DefaultAvatarId = Clean(form.DefaultAvatarId);
                row.UpdatedAt = now;
                var voiceTier = Gadfly.Server.Voice.VoiceTier.Normalize(form.VoiceTier);
                if (row.VoiceTier != voiceTier)
                {
                    // GAD-T617: the examiner's voice tier trades latency for quality on every voice exam, so who changed it is recorded.
                    db.AuditEvents.Add(new AuditEvent
                    {
                        OrganizationId = org, ActorUserId = Tenant.UserId, ActorRole = Tenant.Role, Action = "settings.voice-tier.changed",
                        EntityType = "OrganizationSettings", EntityId = org.ToString(),
                        BeforeJson = System.Text.Json.JsonSerializer.Serialize(new { voiceTier = row.VoiceTier }),
                        AfterJson = System.Text.Json.JsonSerializer.Serialize(new { voiceTier }),
                        Reason = "GAD-T415: the examiner's voice quality/speed tier for this organization's voice exams.", At = now,
                    });
                    row.VoiceTier = voiceTier;
                }
                if (row.InEuropeanUnion != form.InEuropeanUnion || row.VoiceMeasures != form.VoiceMeasures)
                {
                    // GAD-T259: whether voice measurements run is a privacy decision, so who changed it is recorded.
                    db.AuditEvents.Add(new AuditEvent
                    {
                        OrganizationId = org, ActorUserId = Tenant.UserId, ActorRole = Tenant.Role, Action = "settings.voice-measures.changed",
                        EntityType = "OrganizationSettings", EntityId = org.ToString(),
                        BeforeJson = $"{{\"inEuropeanUnion\":{(row.InEuropeanUnion ? "true" : "false")},\"voiceMeasures\":\"{row.VoiceMeasures}\"}}",
                        AfterJson = $"{{\"inEuropeanUnion\":{(form.InEuropeanUnion ? "true" : "false")},\"voiceMeasures\":\"{form.VoiceMeasures}\"}}",
                        Reason = "GAD-T259: voice measurements, off by default in the EU/EEA.", At = now,
                    });
                    row.InEuropeanUnion = form.InEuropeanUnion;
                    row.VoiceMeasures = Enum.IsDefined(form.VoiceMeasures) ? form.VoiceMeasures : VoiceMeasuresSetting.RegionDefault;
                }
                if (row.InstructorsSeeOnlyOwn != form.InstructorsSeeOnlyOwn)
                {
                    db.AuditEvents.Add(new AuditEvent
                    {
                        OrganizationId = org, ActorUserId = Tenant.UserId, ActorRole = Tenant.Role, Action = "settings.instructor-scope.changed",
                        EntityType = "OrganizationSettings", EntityId = org.ToString(),
                        BeforeJson = $"{{\"instructorsSeeOnlyOwn\":{(row.InstructorsSeeOnlyOwn ? "true" : "false")}}}",
                        AfterJson = $"{{\"instructorsSeeOnlyOwn\":{(form.InstructorsSeeOnlyOwn ? "true" : "false")}}}",
                        Reason = "Decision D18: whether instructors see only what they own.", At = now,
                    });
                    row.InstructorsSeeOnlyOwn = form.InstructorsSeeOnlyOwn;
                }
                if (row.AllowSingleGrader != form.AllowSingleGrader)
                {
                    // GAD-T285: relaxing separation of duties in grading is recorded with who did it.
                    db.AuditEvents.Add(new AuditEvent
                    {
                        OrganizationId = org, ActorUserId = Tenant.UserId, ActorRole = Tenant.Role, Action = "settings.single-grader.changed",
                        EntityType = "OrganizationSettings", EntityId = org.ToString(),
                        BeforeJson = $"{{\"allowSingleGrader\":{(row.AllowSingleGrader ? "true" : "false")}}}",
                        AfterJson = $"{{\"allowSingleGrader\":{(form.AllowSingleGrader ? "true" : "false")}}}",
                        Reason = "GAD-T285: whether the person who scored a grade may also reconcile and approve it (single-grader organization).", At = now,
                    });
                    row.AllowSingleGrader = form.AllowSingleGrader;
                }
                var separation = Enum.IsDefined(form.ApproverSeparation) ? form.ApproverSeparation : ApproverSeparationSetting.Automatic;
                if (row.ApproverSeparation != separation)
                {
                    // GAD-T444: whether the reconciler of a grade may also approve it is recorded with who changed it.
                    db.AuditEvents.Add(new AuditEvent
                    {
                        OrganizationId = org, ActorUserId = Tenant.UserId, ActorRole = Tenant.Role, Action = "settings.approver-separation.changed",
                        EntityType = "OrganizationSettings", EntityId = org.ToString(),
                        BeforeJson = $"{{\"approverSeparation\":\"{row.ApproverSeparation}\"}}",
                        AfterJson = $"{{\"approverSeparation\":\"{separation}\"}}",
                        Reason = "GAD-T444: whether the person who reconciled a grade may also approve it.", At = now,
                    });
                    row.ApproverSeparation = separation;
                }
                if (row.EmailNotificationsEnabled != form.EmailNotificationsEnabled)
                {
                    db.AuditEvents.Add(new AuditEvent
                    {
                        OrganizationId = org, ActorUserId = Tenant.UserId, ActorRole = Tenant.Role, Action = "settings.email-notifications.changed",
                        EntityType = "OrganizationSettings", EntityId = org.ToString(),
                        BeforeJson = $"{{\"emailNotificationsEnabled\":{(row.EmailNotificationsEnabled ? "true" : "false")}}}",
                        AfterJson = $"{{\"emailNotificationsEnabled\":{(form.EmailNotificationsEnabled ? "true" : "false")}}}",
                        Reason = "GAD-T310: whether Gadfly's own notification emails send for this organization.", At = now,
                    });
                    row.EmailNotificationsEnabled = form.EmailNotificationsEnabled;
                }
                var saved = await db.SaveChangesAsync();
                OwnershipPolicy.Invalidate(org);
                return saved;
            });
            updatedAt = now;
            ok = true;
            message = "Settings saved.";
        }
        catch (Exception ex)
        {
            ok = false;
            message = "The settings could not be saved: " + ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static string? Clean(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}

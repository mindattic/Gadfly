@page "/admin/desk"
@attribute [Authorize(Policy = DeskAccess.Policy)]
@implements IDisposable
@using Gadfly.Server.Data
@using Gadfly.Server.Desk
@using Gadfly.Server.Sources
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject IConfiguration Config
@inject AuthenticationStateProvider Auth
@inject IJSRuntime JS

@* The admin desk (GAD-T246): exams, students and the assignments between them on one page, for the owner to set up, test and reset. *@
<PageTitle>Admin desk · Gadfly Exams</PageTitle>
<HeadContent><link rel="stylesheet" href="admin.css" /><link rel="stylesheet" href="admin-desk.css" /></HeadContent>
<Tour Id="@Tours.TourIds.AdminDesk" Float="true" />
<h1>Admin desk <span>exams, students and resets on one page</span> <HelpLink Topic="admin-guide" Anchor="the-admin-desk" /></h1>

<nav class="desk-tabs" data-tour="desk-tabs" aria-label="Admin desk">
    <a href="admin/desk?tab=exams" class="@(CurrentTab == "exams" ? "active" : null)" aria-current="@(CurrentTab == "exams" ? "page" : null)">Exams</a>
    <a href="admin/desk?tab=students" class="@(CurrentTab == "students" ? "active" : null)" aria-current="@(CurrentTab == "students" ? "page" : null)">Students</a>
    <a href="admin/desk?tab=student-exams" class="@(CurrentTab == "student-exams" ? "active" : null)" aria-current="@(CurrentTab == "student-exams" ? "page" : null)">Student exams</a>
</nav>

@if (message is not null)
{
    <p role="status" class="notice @(ok ? "ok" : "error")">@message</p>
}

@if (CurrentTab == "exams")
{
    <details class="panel desk-form" open="@(exams is { Count: 0 })">
        <summary><strong>New exam</strong></summary>
        <div class="desk-row">
            <label>Subject <input @bind="newExam.Subject" placeholder="Biology" maxlength="200" /></label>
            <label>Topic <input @bind="newExam.Topic" placeholder="Photosynthesis" maxlength="200" /></label>
        </div>
        <label>Title <span class="hint">(optional; "Subject: Topic" by default)</span> <input @bind="newExam.Title" maxlength="200" /></label>
        <label>Source notes: paste them here
            <textarea @bind="newExam.Notes" rows="8" placeholder="Paste the notes the examiner should draw on."></textarea>
        </label>
        <label>…or upload notes files (@string.Join(", ", SourceLibraryService.AcceptedExtensions))
            <InputFile OnChange="FilesChosen" multiple accept="@SourceLibraryService.AcceptAttribute" />
        </label>
        @if (files.Count > 0)
        {
            <p class="hint">@files.Count file@(files.Count == 1 ? "" : "s"): @string.Join(", ", files.Select(f => f.Name))</p>
        }
        <div class="desk-row">
            <label>Duration (minutes) <input type="number" min="1" max="240" @bind="newExam.DurationMinutes" /></label>
            <label class="check"><input type="checkbox" @bind="newExam.VoiceOnly" /> Voice exam (the examiner speaks, the student answers aloud)</label>
        </div>
        <label>Instructions for the student <span class="hint">(optional)</span> <textarea @bind="newExam.Instructions" rows="2"></textarea></label>
        <p class="hint">The panel reads the notes and finds their concepts; then "Build objectives &amp; publish" turns them into the exam's objectives.</p>
        <button type="button" @onclick="CreateExamAsync" disabled="@busy">Create exam</button>
    </details>

    @* GAD-T641: one click drafts Korean texts for every published exam; each exam's texts still need an instructor's review and approval. *@
    @if (IsStaff)
    {
        <details class="panel desk-form">
            <summary><strong>Korean for all published exams</strong></summary>
            <p class="hint">Drafts the title, instructions and objective titles in Korean for every published exam that has no approved Korean texts,
                and offers Korean on each exam's Languages list. Live, this calls the model and spends tokens (mock mode calls none).
                Drafts are not shown to students until an instructor reviews and approves each exam's texts.</p>
            <button type="button" @onclick="DraftKoreanAllAsync" disabled="@busy">Draft Korean for all published exams</button>
            @if (draftAll is not null)
            {
                <p role="status" class="notice @(draftAll.Ok ? "ok" : "error")">@draftAll.Message</p>
                <ul class="hint">
                    @foreach (var x in draftAll.Exams)
                    {
                        <li>@x.Title: @x.Outcome.ToString().ToLowerInvariant(), @x.Message</li>
                    }
                </ul>
            }
        </details>
    }

    @* GAD-T656: the organization's exam categories; each exam's category is chosen in its row below. *@
    <details class="panel desk-form">
        <summary><strong>Exam categories</strong>@(categories.Count > 0 ? $" ({categories.Count})" : "")</summary>
        @if (categories.Count > 0)
        {
            <ul class="hint">
                @foreach (var c in categories)
                {
                    <li>@c.Name <span class="hint">(@c.Slug · order @c.SortOrder · @c.Exams exam@(c.Exams == 1 ? "" : "s")@(c.DisplayNames.Count > 0 ? " · " + string.Join(", ", c.DisplayNames.Select(d => $"{d.Key}: {d.Value}")) : ""))</span></li>
                }
            </ul>
        }
        else
        {
            <p class="hint">No categories yet.</p>
        }
        <div class="desk-row">
            <label>Name <input @bind="newCategory.Name" placeholder="Biology" maxlength="@ExamCategory.MaxNameLength" /></label>
            <label>Slug <span class="hint">(optional)</span> <input @bind="newCategory.Slug" placeholder="biology" maxlength="@ExamCategory.MaxSlugLength" /></label>
            <label>Sort order <input type="number" @bind="newCategory.SortOrder" /></label>
        </div>
        <div class="desk-row">
            <label>Korean name <span class="hint">(optional)</span> <input @bind="newCategoryKo" maxlength="@ExamCategory.MaxNameLength" /></label>
            <label>Spanish name <span class="hint">(optional)</span> <input @bind="newCategoryEs" maxlength="@ExamCategory.MaxNameLength" /></label>
        </div>
        <button type="button" @onclick="CreateCategoryAsync" disabled="@busy">Create category</button>
    </details>

    @if (exams is null)
    {
        <p class="hint" role="status">Loading…</p>
    }
    else if (exams.Count == 0)
    {
        <p class="notice">No exams yet.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="grid">
                <caption class="visually-hidden">Exams</caption>
                <thead><tr><th scope="col">Exam</th><th scope="col">Mode</th><th scope="col">Status</th><th scope="col">Notes</th><th scope="col" class="num">Objectives</th><th scope="col" class="num">Assigned</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var e in exams)
                    {
                        <tr>
                            <td><strong>@e.Title</strong><br /><span class="hint">@e.Subject@(e.Topic.Length > 0 ? " · " + e.Topic : "") · @e.DurationMinutes min</span>
                                @if (categories.Count > 0)
                                {
                                    <br /><label class="hint">Category
                                        <select value="@(examCategories.TryGetValue(e.Id, out var cid) ? cid.ToString() : "")" @onchange="ev => SetCategoryAsync(e.Id, ev)" disabled="@busy">
                                            <option value="">(uncategorized)</option>
                                            @foreach (var c in categories)
                                            {
                                                <option value="@c.Id">@c.Name</option>
                                            }
                                        </select>
                                    </label>
                                }
                            </td>
                            <td>@(e.Voice ? "Voice" : "Text")</td>
                            <td>@e.Status</td>
                            <td>@(e.Processing ?? (e.CollectionStatus == ProcessingStatus.Ready ? "Ready" : e.CollectionStatus.ToString()))</td>
                            <td class="num">@e.Objectives</td>
                            <td class="num">@e.Assigned</td>
                            <td>
                                <div class="row-actions">
                                    <button class="link" type="button" @onclick="() => EditAsync(e.Id)" disabled="@busy">Edit</button>
                                    @if (e.CanFinish)
                                    {
                                        <button type="button" @onclick="() => FinishAsync(e.Id)" disabled="@busy">Build objectives &amp; publish</button>
                                    }
                                    @if (e.Status == ExamStatus.Published)
                                    {
                                        <button class="link" type="button" @onclick="() => ArchiveAsync(e)" disabled="@busy">Archive</button>
                                    }
                                    @if (IsStaff)
                                    {
                                        <a href="assessments/@e.Id">Full editor</a>
                                    }
                                </div>
                            </td>
                        </tr>
                        @if (edit is not null && edit.Id == e.Id)
                        {
                            <tr class="desk-edit">
                                <td colspan="7">
                                    <div class="desk-form">
                                        @if (e.Status != ExamStatus.Draft)
                                        {
                                            <p class="hint">This exam is @e.Status.ToString().ToLowerInvariant(): its objectives, rubric and duration are frozen. The wording and voice mode can still change.</p>
                                        }
                                        <label>Title <input @bind="edit.Title" maxlength="200" /></label>
                                        <div class="desk-row">
                                            <label>Subject <input @bind="edit.Subject" maxlength="200" /></label>
                                            <label>Topic <input @bind="edit.Topic" maxlength="200" /></label>
                                            <label>Duration (minutes) <input type="number" min="1" max="240" @bind="edit.DurationMinutes" disabled="@(e.Status != ExamStatus.Draft)" /></label>
                                        </div>
                                        <label class="check"><input type="checkbox" @bind="edit.VoiceOnly" /> Voice exam</label>
                                        <label>Instructions <textarea @bind="edit.Instructions" rows="2"></textarea></label>
                                        <div class="row-actions">
                                            <button type="button" @onclick="SaveEditAsync" disabled="@busy">Save</button>
                                            <button class="link" type="button" @onclick="() => edit = null">Cancel</button>
                                        </div>
                                        @* GAD-T539/T540: the languages the exam is offered in and their texts, saved on their own. *@
                                        <Gadfly.Server.Components.Pages.Assessments.ExamLanguagesPanel ExamId="e.Id" />
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}
else if (CurrentTab == "students")
{
    <details class="panel desk-form" open="@(students is { Count: 0 })">
        <summary><strong>Add a student</strong></summary>
        <div class="desk-row">
            <label>Name <input @bind="newStudent.Name" autocomplete="off" /></label>
            <label>User name <input @bind="newStudent.UserName" autocomplete="off" /></label>
        </div>
        <div class="desk-row">
            <label>Password <input type="password" @bind="newStudent.Password" autocomplete="new-password" /></label>
            <label>Email <span class="hint">(optional)</span> <input type="email" @bind="newStudent.Email" autocomplete="off" /></label>
        </div>
        <label class="check"><input type="checkbox" @bind="newStudent.MustChange" /> Make them choose their own password at first sign-in</label>
        <button type="button" @onclick="AddStudentAsync" disabled="@busy">Add student</button>
    </details>

    @if (students is null)
    {
        <p class="hint" role="status">Loading…</p>
    }
    else if (students.Count == 0)
    {
        <p class="notice">No students yet.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="grid">
                <caption class="visually-hidden">Students</caption>
                <thead><tr><th scope="col">User name</th><th scope="col">Name</th><th scope="col">Email</th><th scope="col" class="num">Exams</th><th scope="col">Last sign-in</th><th scope="col">Password</th></tr></thead>
                <tbody>
                    @foreach (var s in students)
                    {
                        <tr class="@(s.Active ? null : "muted")">
                            <td>@s.UserName@(s.Active ? "" : " (removed)")</td>
                            <td>@s.DisplayName</td>
                            <td>@s.Email</td>
                            <td class="num">@s.Assigned</td>
                            <td>@(s.LastLogin is { } l ? l.ToString("yyyy-MM-dd HH:mm") + " UTC" : "never")</td>
                            <td>
                                @if (resetFor == s.UserId)
                                {
                                    <div class="row-actions">
                                        <input type="password" @bind="resetPassword" placeholder="New password" autocomplete="new-password" aria-label="New password for @s.UserName" />
                                        <label class="check"><input type="checkbox" @bind="resetMustChange" /> must change</label>
                                        <button type="button" @onclick="() => ResetPasswordAsync(s.UserId)" disabled="@busy">Set</button>
                                        <button class="link" type="button" @onclick="() => resetFor = null">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <button class="link" type="button" @onclick="() => StartReset(s.UserId)">Reset password</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <div class="panel desk-form">
        <h2>Assign an exam</h2>
        <div class="desk-row">
            <label>Exam
                <select @bind="assignExam">
                    <option value="">Choose…</option>
                    @foreach (var e in (exams ?? []).Where(x => x.Status == ExamStatus.Published))
                    {
                        <option value="@e.Id">@e.Title@(e.Voice ? " (voice)" : "")</option>
                    }
                </select>
            </label>
            <label>Student
                <select @bind="assignStudent">
                    <option value="">Choose…</option>
                    @foreach (var s in (students ?? []).Where(x => x.Active))
                    {
                        <option value="@s.UserId">@s.UserName@(s.DisplayName is { Length: > 0 } n ? $" ({n})" : "")</option>
                    }
                </select>
            </label>
            <label>Attempts allowed <input type="number" min="1" max="20" @bind="assignAttempts" /></label>
        </div>
        <p class="hint">Only published exams can be assigned. Assigning one that is already assigned changes its attempts allowed.</p>
        <button type="button" @onclick="AssignAsync" disabled="@busy">Assign</button>
    </div>

    @if (assignments is null)
    {
        <p class="hint" role="status">Loading…</p>
    }
    else if (assignments.Count == 0)
    {
        <p class="notice">No exams assigned yet.</p>
    }
    else
    {
        <label class="desk-filter">Show
            <select @bind="filterStudent">
                <option value="">every student</option>
                @foreach (var name in assignments.Select(a => a.StudentName).Distinct().Order(StringComparer.OrdinalIgnoreCase))
                {
                    <option value="@name">@name</option>
                }
            </select>
        </label>
        <div class="table-scroll">
            <table class="grid">
                <caption class="visually-hidden">Student exams</caption>
                <thead><tr><th scope="col">Student</th><th scope="col">Exam</th><th scope="col">Attempts</th><th scope="col">Answers</th><th scope="col">Status</th><th scope="col">Latest score</th><th scope="col">Transcript</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var a in assignments.Where(x => string.IsNullOrEmpty(filterStudent) || x.StudentName == filterStudent))
                    {
                        <tr>
                            <td>@a.StudentName</td>
                            <td>@a.ExamTitle@(a.Voice ? " (voice)" : "")</td>
                            <td>
                                @if (attemptsFor == a.Id)
                                {
                                    <div class="row-actions">
                                        <input type="number" min="1" max="20" @bind="attemptsValue" aria-label="Attempts allowed" />
                                        <button type="button" @onclick="() => SetAttemptsAsync(a.Id)" disabled="@busy">Set</button>
                                        <button class="link" type="button" @onclick="() => attemptsFor = null">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <button class="link" type="button" title="Change attempts allowed" @onclick="() => { attemptsFor = a.Id; attemptsValue = a.AttemptsAllowed; }">@a.AttemptsUsed of @a.AttemptsAllowed used</button>
                                }
                            </td>
                            <td title="GAD-T260: typed answers are an accommodation for one student on one exam (documented speech, hearing or anxiety need); camera, spoken questions and eye-contact check stay. Audited.">
                                @(a.TypedAnswers ? "typed (accommodation)" : "spoken")
                                <button class="link" type="button" disabled="@busy" @onclick="() => TypedAnswersAsync(a, !a.TypedAnswers)">@(a.TypedAnswers ? "Withdraw" : "Grant typed answers")</button>
                            </td>
                            <td>
                                @a.Status
                                @if (a.HeldSessionId is { } held)
                                {
                                    @* GAD-T603: held until a person decides; open the review to see why and clear it. *@
                                    <a class="tag warn" href="review/@held" title="@(a.ReviewReason ?? "Marked for an instructor's review"). The result is held until someone clears the mark or approves with a note.">@Gadfly.Server.Review.InstructorReview.Badge: @Gadfly.Server.Review.InstructorReview.ShortReason(a.ReviewReason, a.HeldLanguage)</a>
                                }
                            </td>
                            <td>@(a.LatestScore ?? "—")</td>
                            <td>
                                @if (a.LatestSessionId is { } sid)
                                {
                                    <div class="row-actions">
                                        <button class="link" type="button" @onclick="() => ToggleTranscriptAsync(sid)">@(transcriptFor == sid ? "Hide" : "Transcript")</button>
                                        @if (IsStaff)
                                        {
                                            <a href="review/@sid">Review</a>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="hint">—</span>
                                }
                            </td>
                            <td>
                                <div class="row-actions">
                                    <button class="danger" type="button" @onclick="() => ResetAsync(a)" disabled="@busy" title="Remove every attempt with its scores and grades; the student starts fresh">Reset</button>
                                    <button class="link" type="button" @onclick="() => ClearScoresAsync(a)" disabled="@busy">Clear scores</button>
                                </div>
                            </td>
                        </tr>
                        @if (a.LatestSessionId is { } open && transcriptFor == open)
                        {
                            <tr class="desk-edit">
                                <td colspan="8">
                                    <p class="hint"><Gadfly.Server.Transcripts.TranscriptLinks SessionId="open" Label="Official transcript, with its verification code:" /></p>
                                    @if (transcript is null || transcript.Count == 0)
                                    {
                                        <p class="hint">No questions asked yet.</p>
                                    }
                                    else
                                    {
                                        <ol class="desk-transcript">
                                            @foreach (var t in transcript)
                                            {
                                                <li>
                                                    <p class="q"><strong>Examiner:</strong> @t.Question</p>
                                                    <p class="a"><strong>Student@(t.AnswerMode is { Length: > 0 } m ? $" ({(m == "text" ? "typed" : m.ToLowerInvariant())})" : ""):</strong> @(t.Answer ?? "(no answer yet)")</p>
                                                </li>
                                            }
                                        </ol>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private string CurrentTab => Tab is "students" or "student-exams" ? Tab : "exams";

    /// <summary>The caller's own role reaches the staff pages (full editor, review); a deprecated listed desk admin (GAD-T459) who is a student does not.</summary>
    private bool IsStaff => Tenant.Role is OrgRoles.Owner or OrgRoles.Admin or OrgRoles.Instructor;

    private sealed class NewStudentForm
    {
        public string Name { get; set; } = "";
        public string UserName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public bool MustChange { get; set; }
    }

    private IReadOnlyList<DeskExam>? exams;
    private IReadOnlyList<DeskStudent>? students;
    private IReadOnlyList<DeskAssignment>? assignments;
    private IReadOnlyList<DeskTurn>? transcript;
    private IReadOnlyList<IBrowserFile> files = [];
    private DeskNewExam newExam = new();
    private DeskExamEdit? edit;
    private NewStudentForm newStudent = new();
    private Guid? resetFor, attemptsFor, transcriptFor;
    private string resetPassword = "";
    private bool resetMustChange;
    private int attemptsValue = 1;
    private string assignExam = "", assignStudent = "", filterStudent = "";
    private int assignAttempts = 3;
    private string? message;
    private bool ok, busy;
    private string? loadedTab;
    private System.Threading.Timer? poll;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedTab == CurrentTab) return;
        loadedTab = CurrentTab;
        message = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await RunAsync(async desk =>
        {
            switch (CurrentTab)
            {
                case "exams":
                    exams = await desk.ExamsAsync();
                    await RunAdminAsync(async admin =>
                    {
                        categories = await admin.CategoriesAsync();
                        examCategories = await admin.ExamCategoryIdsAsync();
                    });
                    break;
                case "students":
                    students = await desk.StudentsAsync();
                    break;
                default:
                    exams = await desk.ExamsAsync();
                    students = await desk.StudentsAsync();
                    assignments = await desk.AssignmentsAsync();
                    break;
            }
        });
        // While the panel is reading someone's notes, refresh the exam list every few seconds.
        var processing = CurrentTab == "exams" && exams?.Any(e => e.Processing is not null) == true;
        if (processing && poll is null) poll = new System.Threading.Timer(_ => _ = InvokeAsync(PollAsync), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        else if (!processing && poll is not null) { poll.Dispose(); poll = null; }
    }

    private async Task PollAsync()
    {
        if (busy || CurrentTab != "exams") return;
        await LoadAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Runs one desk operation in its own scope acting as the caller with the Admin role, after checking again that the caller may
    /// use the desk. One at a time: a second click while one runs is ignored.
    /// </summary>
    private async Task RunAsync(Func<DeskService, Task> work)
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (!DeskAccess.IsDeskAdmin(user, Tenant, Config))
        {
            ok = false;
            message = "The admin desk is not available to you.";
            return;
        }
        await using var scope = Scopes.CreateAsyncScopeFor(DeskAccess.Elevated(Tenant));
        await work(new DeskService(scope.ServiceProvider));
    }

    /// <summary>Runs one exam-admin operation (GAD-T656: categories) in its own elevated scope, after the same desk check as <see cref="RunAsync"/>.</summary>
    private async Task RunAdminAsync(Func<Gadfly.Server.Admin.ExamAdminService, Task> work)
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (!DeskAccess.IsDeskAdmin(user, Tenant, Config)) return;
        await using var scope = Scopes.CreateAsyncScopeFor(DeskAccess.Elevated(Tenant));
        await work(ActivatorUtilities.CreateInstance<Gadfly.Server.Admin.ExamAdminService>(scope.ServiceProvider));
    }

    // ------------------------------------------------------------------ exam categories (GAD-T656)

    private IReadOnlyList<Gadfly.Server.Admin.ExamCategoryRow> categories = [];
    private IReadOnlyDictionary<Guid, Guid> examCategories = new Dictionary<Guid, Guid>();
    private Gadfly.Server.Admin.ExamCategoryForm newCategory = new();
    private string newCategoryKo = "", newCategoryEs = "";

    private Task CreateCategoryAsync() => ActAsync(async _ =>
    {
        newCategory.DisplayNames["ko"] = newCategoryKo;
        newCategory.DisplayNames["es"] = newCategoryEs;
        DeskResult? r = null;
        await RunAdminAsync(async admin =>
        {
            var res = await admin.CreateCategoryAsync(newCategory);
            r = new DeskResult(res.Ok, res.Message, res.Id);
        });
        if (r is { Ok: true })
        {
            newCategory = new();
            newCategoryKo = newCategoryEs = "";
        }
        return r ?? new DeskResult(false, "The admin desk is not available to you.");
    });

    private Task SetCategoryAsync(Guid examId, ChangeEventArgs e) => ActAsync(async _ =>
    {
        var chosen = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
        DeskResult? r = null;
        await RunAdminAsync(async admin =>
        {
            var res = await admin.SetCategoryAsync(examId, chosen);
            r = new DeskResult(res.Ok, res.Message, res.Id);
        });
        return r ?? new DeskResult(false, "The admin desk is not available to you.");
    });

    private async Task ActAsync(Func<DeskService, Task<DeskResult>> work, bool reload = true)
    {
        if (busy) return;
        busy = true;
        try
        {
            DeskResult? r = null;
            await RunAsync(async desk => r = await work(desk));
            if (r is not null)
            {
                ok = r.Ok;
                message = r.Message;
            }
            if (reload) await LoadAsync();
        }
        catch (Exception ex)
        {
            ok = false;
            message = "That didn't work: " + ex.Message;
        }
        finally { busy = false; }
    }

    // ------------------------------------------------------------------ exams

    private void FilesChosen(InputFileChangeEventArgs e) => files = e.GetMultipleFiles(20);

    private Task CreateExamAsync() => ActAsync(async desk =>
    {
        var uploads = files.Select(f => new DeskUpload(f.Name, f.Size, () => f.OpenReadStream(SourceLibraryService.MaxFileBytes))).ToList();
        var r = await desk.CreateExamAsync(newExam, uploads);
        if (r.Ok)
        {
            newExam = new();
            files = [];
        }
        return r;
    });

    private Task FinishAsync(Guid examId) => ActAsync(desk => desk.FinishExamAsync(examId));

    private async Task ArchiveAsync(DeskExam e)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Archive \"{e.Title}\"? Students can no longer start it; results are kept.")) return;
        await ActAsync(async desk =>
        {
            var r = await desk.ArchiveExamAsync(e.Id);
            return new DeskResult(r.Ok, r.Message, r.Id);
        });
    }

    private Gadfly.Server.Translation.DraftAllResult? draftAll;

    private async Task DraftKoreanAllAsync()
    {
        if (busy) return;
        if (!await JS.InvokeAsync<bool>("confirm",
                "Draft Korean texts for every published exam without approved Korean texts? Live, this calls the model and spends tokens. Instructors must still review and approve each exam's texts.")) return;
        busy = true;
        draftAll = null;
        message = null;
        try
        {
            var notOffered = new List<string>();
            var r = await Gadfly.Server.Translation.LanguageOps.RunAsync(Scopes, Tenant, async s =>
            {
                var res = await s.DraftAllPublishedAsync("ko");
                foreach (var x in res.Exams.Where(x => x.Outcome != Gadfly.Server.Translation.ExamDraftOutcome.Fail))
                {
                    var v = await s.GetAsync(x.ExamId);
                    if (v is null || v.Offered.Contains("ko")) continue;
                    if (v is { CanEdit: false }) { notOffered.Add($"{x.Title}: not allowed to change its languages"); continue; }
                    var o = await s.SetOfferedAsync(x.ExamId, [.. v.Offered, "ko"]);
                    if (!o.Ok) notOffered.Add($"{x.Title}: {o.Message}");
                }
                return res;
            });
            draftAll = r;
            ok = r.Ok && notOffered.Count == 0;
            message = notOffered.Count == 0 ? null : "Korean could not be offered on: " + string.Join("; ", notOffered);
            edit = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ok = false;
            message = "That didn't work: " + ex.Message;
        }
        finally { busy = false; }
    }

    private async Task EditAsync(Guid examId)
    {
        if (busy) return;
        await RunAsync(async desk => edit = await desk.GetEditAsync(examId));
    }

    private Task SaveEditAsync() => edit is null ? Task.CompletedTask : ActAsync(async desk =>
    {
        var r = await desk.EditExamAsync(edit);
        if (r.Ok) edit = null;
        return r;
    });

    // ------------------------------------------------------------------ students

    private Task AddStudentAsync() => ActAsync(async desk =>
    {
        var r = await desk.AddStudentAsync(newStudent.Name, newStudent.UserName, newStudent.Email, newStudent.Password, newStudent.MustChange);
        if (r.Ok) newStudent = new();
        return r;
    });

    private void StartReset(Guid userId)
    {
        resetFor = userId;
        resetPassword = "";
        resetMustChange = false;
    }

    private Task ResetPasswordAsync(Guid userId) => ActAsync(async desk =>
    {
        var r = await desk.ResetPasswordAsync(userId, resetPassword, resetMustChange);
        if (r.Ok)
        {
            resetFor = null;
            resetPassword = "";
        }
        return r;
    });

    // ------------------------------------------------------------------ student exams

    private Task AssignAsync()
    {
        if (!Guid.TryParse(assignExam, out var examId) || !Guid.TryParse(assignStudent, out var studentId))
        {
            ok = false;
            message = "Choose an exam and a student.";
            return Task.CompletedTask;
        }
        return ActAsync(desk => desk.AssignAsync(examId, studentId, assignAttempts));
    }

    private Task SetAttemptsAsync(Guid assignmentId) => ActAsync(async desk =>
    {
        var r = await desk.SetAttemptsAsync(assignmentId, attemptsValue);
        if (r.Ok) attemptsFor = null;
        return r;
    });

    private async Task TypedAnswersAsync(DeskAssignment a, bool on)
    {
        if (on && !await JS.InvokeAsync<bool>("confirm",
                $"Let {a.StudentName} type their answers in \"{a.ExamTitle}\" instead of speaking them? Only for a documented speech, hearing or anxiety need. The camera, the spoken questions and the eye-contact check stay on. This is recorded in the audit log.")) return;
        await ActAsync(desk => desk.SetTypedAnswersAsync(a.Id, on));
    }

    private async Task ResetAsync(DeskAssignment a)
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                $"Reset {a.StudentName}'s \"{a.ExamTitle}\"? Every attempt is removed with its transcript, scores and grades, and the student starts fresh. This can't be undone.")) return;
        transcriptFor = null;
        await ActAsync(desk => desk.ResetAsync(a.Id));
    }

    private async Task ClearScoresAsync(DeskAssignment a)
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                $"Clear the scores of {a.StudentName}'s \"{a.ExamTitle}\"? Grades and reports are removed (a copy is archived in the audit log); the attempts and transcripts stay and still count as used, and the student is told so.")) return;
        await ActAsync(desk => desk.ClearScoresAsync(a.Id));
    }

    private async Task ToggleTranscriptAsync(Guid sessionId)
    {
        if (transcriptFor == sessionId)
        {
            transcriptFor = null;
            transcript = null;
            return;
        }
        transcriptFor = sessionId;
        transcript = null;
        await RunAsync(async desk => transcript = await desk.TranscriptAsync(sessionId));
    }

    public void Dispose() => poll?.Dispose();
}

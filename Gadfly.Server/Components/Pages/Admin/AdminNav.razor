@* The one admin navigation (GAD-T300, replacing the organization console's own, GAD-T55). MainLayout renders it once, above
   every admin page (see AdminArea), so a page never has to. Each entry is shown only to the roles that may open it.
   A page that still writes <AdminNav /> itself gets the stylesheet and no second copy of the links. *@
@using Gadfly.Server.Admin
@using Gadfly.Server.Desk
@inject ITenantContext Tenant
@inject IConfiguration Config

@if (!FromLayout)
{
    <HeadContent><link rel="stylesheet" href="admin.css" /></HeadContent>
}
else if (groups.Count > 0)
{
    @* In the body on purpose: a second HeadContent would replace the page's own. *@
    <link rel="stylesheet" href="admin.css" />
    <nav class="admin-nav" aria-label="Administration">@Groups</nav>
    @* Phones get the same links folded behind one disclosure, so the menu doesn't fill the first screen. *@
    <details class="admin-nav-compact">
        <summary>Admin menu</summary>
        <nav class="admin-nav-list" aria-label="Administration">@Groups</nav>
    </details>
}

@code {
    /// <summary>Set by MainLayout only. Anywhere else the component adds the admin stylesheet and nothing visible.</summary>
    [Parameter] public bool FromLayout { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<AdminArea.Group> groups = [];

    private RenderFragment Groups => __builder =>
    {
        @foreach (var g in groups)
        {
            <div class="admin-nav-group" role="group" aria-label="@g.Name">
                <span class="admin-nav-label" aria-hidden="true">@g.Name</span>
                @foreach (var l in g.Links)
                {
                    <NavLink href="@l.Href" Match="@(l.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)">@l.Label</NavLink>
                }
            </div>
        }
    };

    protected override async Task OnParametersSetAsync()
    {
        if (!FromLayout) return;
        var user = AuthState is null ? null : (await AuthState).User;
        groups = AdminArea.GroupsFor(Tenant.Role, Tenant.IsSuperAdmin, DeskAccess.IsDeskAdmin(user, Tenant, Config));
    }
}

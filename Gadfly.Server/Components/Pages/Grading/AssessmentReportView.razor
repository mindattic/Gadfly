@using Gadfly.Server.Grading
@inject Gadfly.Server.Localization.UiText Ui
@* The assessment report body (Feature 10), shared by the reviewer and student pages. *@

<div class="gr-report">
    @if (Report.IsMock)
    {
        <p class="gr-banner mock"><span class="gr-mock">MOCK</span> @T["report.mock"]</p>
    }
    @if (Report.IsFormative)
    {
        <p class="gr-banner warn">@T["report.formative"] @Report.ScoreUseReason</p>
    }
    @if (!Report.IsApproved)
    {
        <p class="gr-banner warn">@T["report.preliminary"]</p>
    }
    <div class="gr-summary">
        <div><span class="hint">@T["report.exam"]</span>@Report.ExamTitle</div>
        <div><span class="hint">@T["report.student"]</span>@Report.StudentName</div>
        <div><span class="hint">@T["report.attempt"]</span>@Report.Attempt@(Report.EndedAt is { } ended ? " · " + ended.UtcDateTime.ToString("yyyy-MM-dd") : "")</div>
        <div><span class="hint">@T["report.status"]</span>@Report.Status</div>
        <div><span class="hint">@T["report.finalGrade"]</span><strong>@(Report.FinalPercent is { } f ? AssessmentReport.Pct(f) : T["report.notAvailable"])</strong>@(Report.Label is { } l ? " (" + l + ")" : "")</div>
    </div>
    <p class="hint">@T["report.policy"] @Report.Policy</p>

    <h2 class="gr-section">@T["report.objectives"]</h2>
    <div class="gr-table-wrap">
        <table class="grid">
            <thead><tr><th scope="col">@T["report.objective"]</th><th scope="col">@T["report.max"]</th><th scope="col">@T["report.weight"]</th><th scope="col">@T["report.aiScore"]</th><th scope="col">@T["report.humanScore"]</th><th scope="col">@T["report.combined"]</th>@if (ShowFollowUps) { <th scope="col">Follow-ups</th> }</tr></thead>
            <tbody>
                @foreach (var o in Report.Objectives)
                {
                    <tr>
                        <td>@o.Title</td>
                        <td>@o.MaxScore.ToString("0.##")</td>
                        <td>@o.Weight.ToString("0.##")</td>
                        <td>@(o.AiExcluded ? T["report.insufficient"] : o.AiScore?.ToString("0.##") ?? "—")@if (o.AiIsMock) { <text> </text><span class="gr-mock">MOCK</span> }</td>
                        <td>@(o.HumanScore?.ToString("0.##") ?? "—")</td>
                        <td>@(o.Combined?.ToString("0.##") ?? "—")</td>
                        @if (ShowFollowUps) { <td>@Report.FollowUps.GetValueOrDefault(o.Key)</td> }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @foreach (var o in Report.Objectives)
    {
        <div class="gr-objective">
            <h3>@o.Title</h3>
            @if (o.HumanLevel is not null) { <p><strong>@T["report.grader"]</strong> @o.HumanLevel@(o.HumanComment is { } c ? ". " + c : "")</p> }
            @if (o.AiLevel is not null) { <p><strong>@T["report.ai"]</strong> @T["report.aiLevel", o.AiLevel ?? "", o.AiConfidence ?? ""] @o.AiExplanation</p> }
            @if (o.Reconciliation is not null) { <p><strong>@T["report.reconciliation"]</strong> @o.Reconciliation</p> }
            @if (Report.ChangeLine(o) is { } change) { <p class="hint">@change</p> }
            @if (!Report.ForStudent && Report.Paths.GetValueOrDefault(o.Key) is { } path) { <ObjectivePathNote Path="path" /> }
            @if (o.WhatWasMissing.Count > 0)
            {
                <p><strong>@T["report.missing"]</strong></p>
                <ul>@foreach (var m in o.WhatWasMissing) { <li>@m</li> }</ul>
            }
            else if (o.Combined is { } full && full >= o.MaxScore)
            {
                <p><strong>@T["report.missingNone"]</strong> @T["report.missingNoneMore"]</p>
            }
            @if (o.Evidence.Count > 0)
            {
                <p><strong>@T["report.evidence"]</strong> <span class="hint">@T["report.evidenceHint"]</span></p>
                @foreach (var ev in o.Evidence)
                {
                    <p class="hint">@T["report.response", ev.Sequence, ev.Question]</p>
                    <blockquote>@ev.VerifiedText</blockquote>
                }
            }
        </div>
    }

    @* GAD-T821: the student's own elenctic record; staff reports carry neither section. *@
    @if (Report.ForStudent && Report.Contradictions.Count > 0)
    {
        <h2 class="gr-section">@T["report.contradictions"]</h2>
        <p class="hint">@T["report.contradictionsIntro"]</p>
        @foreach (var c in Report.Contradictions)
        {
            <div class="gr-objective">
                <p class="hint">@T["report.contradictionFirst"]@if (c.FirstWithdrawn) { <text> </text>@T["report.withdrawn"] }</p>
                <blockquote>@c.FirstQuote</blockquote>
                <p class="hint">@T["report.contradictionSecond"]@if (c.SecondWithdrawn) { <text> </text>@T["report.withdrawn"] }</p>
                <blockquote>@c.SecondQuote</blockquote>
                <p><strong>@T["report.contradictionQuestion"]</strong> @c.Question</p>
                <p class="hint">@T["report.contradictionAnswer"]</p>
                <blockquote>@c.Answer</blockquote>
            </div>
        }
    }
    @if (Report.ForStudent && Report.Reflection is not null)
    {
        <h2 class="gr-section">@T["report.reflection"]</h2>
        @if (Report.ReflectionQuestion is not null) { <p class="hint">@Report.ReflectionQuestion</p> }
        <blockquote>@Report.Reflection</blockquote>
    }

    <h2 class="gr-section">@T["report.gaps"]</h2>
    @if (Report.KnowledgeGaps.Count == 0)
    {
        <p>@T["report.gapsNone"]</p>
    }
    else
    {
        <ul>@foreach (var g in Report.KnowledgeGaps) { <li>@g</li> }</ul>
    }

    <h2 class="gr-section">@T["report.approval"]</h2>
    @if (Report.Approvals.Count == 0)
    {
        <p>@T["report.notApproved"]</p>
    }
    else
    {
        <ul>@foreach (var a in Report.Approvals) { <li>@a</li> }</ul>
    }
    @if (Report.Appeals.Count > 0)
    {
        <h2 class="gr-section">@T["report.appeals"]</h2>
        <ul>@foreach (var a in Report.Appeals) { <li>@a</li> }</ul>
    }
</div>

@code {
    [Parameter, EditorRequired] public AssessmentReport Report { get; set; } = default!;

    /// <summary>The student's own report is in their language (GAD-T606); staff pages stay in English (docs/LOCALIZATION.md).</summary>
    private Gadfly.Server.Localization.UiText T => Report.ForStudent ? Ui : Ui.For("en");

    /// <summary>Reviewers see how many follow-ups each objective got (GAD-T267); students do not.</summary>
    private bool ShowFollowUps => !Report.ForStudent && Report.FollowUps.Count > 0;
}

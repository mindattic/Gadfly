@page "/my-results/{SessionId:guid}"
@attribute [Authorize(Policy = GadflyPolicies.Student)]
@using Gadfly.Assessment
@using Gadfly.Server.Grading
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant
@inject Gadfly.Server.Localization.UiText T

<PageTitle>@T["result.pageTitle"]</PageTitle>
<HeadContent><link rel="stylesheet" href="grading.css" /></HeadContent>
<p class="hint no-print"><a href="my-exams">← @T["layout.myExams"]</a></p>

@if (loading)
{
    <p class="hint" role="status">@T["common.loading"]</p>
}
else if (report is null || w is null)
{
    <h1>@T["result.unavailable"]</h1>
    <p class="notice">@T["result.notPublished"]</p>
}
else
{
    <h1>@T["myExams.result"] <span>· @report.ExamTitle</span> <HelpLink Topic="grading-and-results" /></h1>
    <p class="hint no-print">
        <a href="@GradingSetup.StudentReportMarkdownPath(SessionId)" download data-enhance-nav="false">@T["result.downloadMarkdown"]</a> ·
        <a href="@GradingSetup.StudentReportPdfPath(SessionId)" download data-enhance-nav="false">@T["result.downloadPdf"]</a>
    </p>
    <p class="hint no-print">
        <a href="@($"certificates/{SessionId:D}/pdf")" download data-enhance-nav="false">@T["result.certificate"]</a>@T["result.certificateCode"] · <a href="transcripts/verify" target="_blank" rel="noopener" data-enhance-nav="false">@T["result.checkCopy"]</a>
    </p>
    <p class="hint no-print"><Gadfly.Server.Transcripts.TranscriptLinks SessionId="SessionId" Label="@T["result.transcript"]" ShowVerify="true" /></p>
    <AssessmentReportView Report="report" />

    @* GAD-T450: the integrity notes recorded on this attempt, with the same plain explanations a reviewer reads. Shown only once
       the result is published to the student (StudentIntegrityRecord checks), never a verdict and never part of the grade. *@
    <section class="student-integrity" aria-labelledby="integrity-heading">
        <h2 class="gr-section" id="integrity-heading">@T["result.integrity.title"]</h2>
        @if (integrity is null || integrity.IsEmpty)
        {
            <p class="hint">@T["result.integrity.none"]</p>
        }
        else
        {
            <p class="hint">@T["result.integrity.intro"]</p>
            @if (integrity.Notes.Count > 0)
            {
                <ul class="student-integrity-notes">
                    @foreach (var n in integrity.Notes)
                    {
                        <li>
                            <strong>@n.Label</strong>
                            <span class="hint"> · @n.When@(n.Question is { } q ? T["result.integrity.duringQuestion", q].Value : "")</span>
                            <div>@n.Explanation</div>
                            @if (!string.IsNullOrWhiteSpace(n.Summary) && n.Summary != n.Explanation)
                            {
                                <div class="hint">@n.Summary</div>
                            }
                        </li>
                    }
                </ul>
            }
            @if (integrity.Ordinary.Count > 0)
            {
                <p class="hint">@T["result.integrity.ordinary"] @string.Join("; ", integrity.Ordinary.Select(o => $"{o.Label} ({o.Count}×)")).</p>
            }
        }
    </section>

    <div class="no-print">
        <h2 class="gr-section">@T["result.appeal.title"]</h2>
        @if (w.OpenAppeal is { } open)
        {
            <p>@T["result.appeal.open", T.Date(open.OpenedAt)]</p>
        }
        else if (w.Status is GradeStatus.Published or GradeStatus.Amended)
        {
            <p class="hint">@T["result.appeal.how"]</p>
            <label class="gr-wide">@T["result.appeal.reason"] <textarea rows="4" @bind="reason" maxlength="4000"></textarea></label>
            @if (integrity is { Notes.Count: > 0 })
            {
                <label class="gr-wide">@T["result.appeal.response"] <textarea rows="3" @bind="integrityResponse" maxlength="3000"></textarea></label>
                <p class="hint">@T["result.appeal.responseHint"]</p>
            }
            <button type="button" disabled="@busy" @onclick="AppealAsync">@T["result.appeal.submit"]</button>
        }
        @if (message is not null)
        {
            <p role="status" class="@(ok ? "ok" : "error")">@message</p>
        }
    </div>
}

@code {
    [Parameter] public Guid SessionId { get; set; }
    private GradingWorkspace? w;
    private AssessmentReport? report;
    private bool loading = true, busy, ok;
    private string reason = "", integrityResponse = "";
    private string? message;
    private Gadfly.Server.Integrity.StudentIntegrityView? integrity;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync()
    {
        w = await GradingDb.RunAsync(Scopes, Tenant, g => g.StudentWorkspaceAsync(SessionId));
        report = w is null ? null : AssessmentReport.Build(w, forStudent: true);
        // GAD-T630: the exam and objective titles in the attempt's language (approved texts only), else the English.
        if (report is not null && Tenant.OrganizationId is { } org)
            report = await Gadfly.Server.Student.StudentExamTexts.LocalizeAsync(Scopes, org, w!.Session.ExamId, w.Session.Language, report);
        // Read only when the student's own published result loaded; the loader re-checks ownership and publication itself.
        integrity = w is null ? null : await Gadfly.Server.Integrity.StudentIntegrityRecord.LoadForCallerAsync(Scopes, Tenant, SessionId, text: T);
    }

    private async Task AppealAsync()
    {
        if (busy) return;
        var text = Gadfly.Server.Integrity.StudentIntegrityRecord.AppealText(reason, integrity is { Notes.Count: > 0 } ? integrityResponse : null);
        if (text.Length > 4000)
        {
            ok = false;
            message = T["result.appeal.tooLong", text.Length].Value;
            return;
        }
        busy = true;
        try
        {
            var r = await GradingDb.RunAsync(Scopes, Tenant, g => g.AppealAsync(SessionId, text));
            ok = r.Ok;
            message = r.Message;
            if (r.Ok) { reason = ""; integrityResponse = ""; await LoadAsync(); }
        }
        finally { busy = false; }
    }
}

@page "/grading/bias/{ExamId:guid}/human/{RunId:guid}"
@attribute [Authorize(Policy = GadflyPolicies.Member)]
@using Gadfly.Server.Grading
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant

<PageTitle>Marking probe · Gadfly Exams</PageTitle>
<HeadContent><link rel="stylesheet" href="grading.css" /></HeadContent>
<h1>Marking probe <span>Grade each answer against its rubric</span> <HelpLink Topic="grading-guide" /></h1>
<p><a href="grading/bias/@ExamId">← Bias probes</a></p>

@if (items is null)
{
    <p class="@(refusal is null ? "hint" : "notice")" role="status">@(refusal ?? "Loading…")</p>
}
else if (items.Count == 0)
{
    <p class="notice">This probe has no answers left to mark (they may have been removed under the retention policy).</p>
}
else
{
    <p class="gr-banner">These are answers from this exam, shown without names or grades. Mark each one as you would in an examination. Your marks are used only to check how marking responds to the way answers are worded; they change no student's grade.</p>
    @if (message is not null)
    {
        <p role="status" class="@(ok ? "ok" : "error")">@message</p>
    }
    @foreach (var i in items)
    {
        <section class="gr-objective">
            <h3>Answer @(i.Item + 1): @i.Objective</h3>
            @if (!string.IsNullOrWhiteSpace(i.Description)) { <p class="hint">@i.Description</p> }
            <details>
                <summary>Rubric</summary>
                @foreach (var c in i.Criteria)
                {
                    <p><strong>@c.Name</strong>@(string.IsNullOrWhiteSpace(c.Description) ? "" : ": " + c.Description)</p>
                    <ul>@foreach (var l in c.Levels) { <li>@l.Level @l.Label: @l.Descriptor</li> }</ul>
                }
            </details>
            @foreach (var e in i.Evidence)
            {
                <div class="gr-response"><p class="q">@e.Question</p><blockquote>@e.Answer</blockquote></div>
            }
            <div class="gr-form-row">
                <label>Level
                    <select value="@(i.MyLevel ?? -1)" @onchange="e => MarkAsync(i.Item, e.Value?.ToString())" disabled="@busy">
                        <option value="-1">Choose…</option>
                        @for (var l = 0; l <= 5; l++)
                        {
                            var level = l;
                            <option value="@level">@level @Gadfly.Assessment.MasteryLevels.Label((Gadfly.Assessment.MasteryLevel)level)</option>
                        }
                    </select>
                </label>
                @if (i.MyLevel is not null) { <span class="hint">recorded</span> }
            </div>
        </section>
    }
}

@code {
    [Parameter] public Guid ExamId { get; set; }
    [Parameter] public Guid RunId { get; set; }
    private IReadOnlyList<HumanProbeSheetItem>? items;
    private string? refusal, message;
    private bool busy, ok;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync() =>
        (items, refusal) = await PanelDb.RunAsync(Scopes, Tenant, sp => sp.GetRequiredService<BiasProbeService>().HumanSheetAsync(ExamId, RunId));

    private async Task MarkAsync(int item, string? value)
    {
        if (busy || !int.TryParse(value, out var level) || level < 0) return;
        busy = true;
        try
        {
            var r = await PanelDb.RunAsync(Scopes, Tenant, sp => sp.GetRequiredService<BiasProbeService>().MarkHumanAsync(ExamId, RunId, item, level));
            (ok, message) = (r.Ok, r.Message);
            await LoadAsync();
        }
        finally { busy = false; }
    }
}

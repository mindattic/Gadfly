@page "/grading"
@attribute [Authorize(Policy = GadflyPolicies.Member)]
@using Gadfly.Assessment
@using Gadfly.Server.Grading
@inject IServiceScopeFactory Scopes
@inject ITenantContext Tenant

<PageTitle>Grading · Gadfly Exams</PageTitle>
<HeadContent><link rel="stylesheet" href="grading.css" /></HeadContent>
<Tour Id="@Tours.TourIds.GradingQueue" Float="true" />
<h1>Grading <span>AI preliminary grades, human examination, reconciliation and approval</span> <HelpLink Topic="grading-guide" /></h1>

@if (denied)
{
    <p class="notice">Your role in this organization does not include grading. The attempt was recorded.</p>
}
else
{
    <p><a href="grading/panel">Panel calibration, double marking and bias probes</a></p>
    <div class="gr-filters" data-tour="grading-filters">
        <label>Status
            <select @bind="StatusFilter" @bind:after="ApplyFiltersAsync">
                <option value="">All</option>
                @foreach (var s in Enum.GetValues<GradeStatus>().Where(s => s != GradeStatus.ExaminationInProgress))
                {
                    <option value="@s">@GradeStatusMachine.Label(s)</option>
                }
            </select>
        </label>
        <label class="check"><input type="checkbox" @bind="showUnstarted" @bind:after="ApplyFiltersAsync" /> Include ended sessions not started</label>
        <label class="check"><input type="checkbox" @bind="needsInstructorReview" @bind:after="ApplyFiltersAsync" /> @Gadfly.Server.Review.InstructorReview.Badge</label>
    </div>
    @if (message is not null)
    {
        <p role="status" class="@(ok ? "ok" : "error")">@message</p>
    }
    @if (rows is null)
    {
        <p class="hint" role="status">Loading…</p>
    }
    else if (rows.Count == 0)
    {
        <p class="notice">Nothing to grade with these filters. A session enters the queue when its examination ends.</p>
    }
    else
    {
        <div class="gr-table-wrap" data-tour="grading-table">
            <table class="grid">
                <thead><tr><th scope="col">Student</th><th scope="col">Exam</th><th scope="col">Attempt</th><th scope="col">Ended</th><th scope="col">Status</th><th scope="col">Final</th><th scope="col">Attention</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var r in PagedRows)
                    {
                        <tr>
                            <td>@r.StudentName</td>
                            <td>@r.ExamTitle</td>
                            <td>@r.Attempt</td>
                            <td>@(r.EndedAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td>
                                @if (r.Status is { } st)
                                {
                                    <span class="gr-status s-@st">@GradeStatusMachine.Label(st)</span>
                                }
                                else
                                {
                                    <span class="hint">Not started</span>
                                }
                                @if (r.IsMock) { <text> </text><span class="gr-mock">MOCK</span> }
                            </td>
                            <td>@(r.FinalPercent is { } f && r.Status is not (GradeStatus.HumanReviewPending or GradeStatus.AiGradingPending) ? AssessmentReport.Pct(f) : "—")</td>
                            <td>
                                @if (r.OpenDisagreements > 0) { <span class="gr-band-MandatoryReconciliation">@r.OpenDisagreements to reconcile</span> }
                                @if (r.OpenAppeal) { <span class="gr-band-MandatoryReconciliation">appeal open</span> }
                                @if (r.NeedsInstructorReview)
                                {
                                    @* GAD-T603: held; publishing waits for a person's decision. *@
                                    <span class="gr-band-MandatoryReconciliation" title="@(r.ReviewReason ?? "Marked for an instructor's review"). The result is held until you clear the mark or approve with a note.">@Gadfly.Server.Review.InstructorReview.Badge: @Gadfly.Server.Review.InstructorReview.ShortReason(r.ReviewReason, r.Language)</span>
                                }
                                @if (r.JobState is "Failed") { <span class="error" title="@r.JobError">AI grading failed</span> }
                                else if (r.JobState is "Queued" or "Running") { <span class="hint">AI grading @r.JobState.ToLowerInvariant()</span> }
                            </td>
                            <td>
                                @if (r.Status is null || r.JobState == "Failed")
                                {
                                    <button type="button" class="link" disabled="@busy" @onclick="() => StartAsync(r.SessionId)">@(r.Status is null ? "Start grading" : "Retry AI grading")</button>
                                }
                                @if (r.Status is not null)
                                {
                                    <a href="grading/@r.SessionId">Open</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (TotalPages > 1)
        {
            <nav class="pager" aria-label="Pages">
                <button type="button" class="link" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(currentPage - 1)">← Previous</button>
                <span>Page @currentPage of @TotalPages</span>
                <button type="button" class="link" disabled="@(currentPage >= TotalPages)" @onclick="() => GoToPage(currentPage + 1)">Next →</button>
            </nav>
        }
        <p class="hint">@rows.Count session@(rows.Count == 1 ? "" : "s"). AI grades are preliminary; nothing reaches a student until a final grade is approved and published.</p>
    }
}

@code {
    /// <summary>Rows per page (GAD-T390): the queue can otherwise render hundreds of rows in one table.</summary>
    private const int RowsPerPage = 50;

    private IReadOnlyList<GradingQueueRow>? rows;
    private string StatusFilter { get; set; } = "";
    private bool showUnstarted = true, needsInstructorReview, denied, busy, ok;
    private string? message;
    // Not named with a "page" prefix: a bare "@page..." reference in the markup above is parsed as the @page directive.
    private int currentPage = 1;

    private int TotalPages => rows is null or { Count: 0 } ? 1 : (rows.Count + RowsPerPage - 1) / RowsPerPage;
    private IReadOnlyList<GradingQueueRow> PagedRows => rows is null ? [] : rows.Skip((currentPage - 1) * RowsPerPage).Take(RowsPerPage).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>A filter changed: back to page 1, since the rows it used to show may no longer match.</summary>
    private Task ApplyFiltersAsync()
    {
        currentPage = 1;
        return LoadAsync();
    }

    private void GoToPage(int n) => currentPage = Math.Clamp(n, 1, TotalPages);

    private async Task LoadAsync()
    {
        GradeStatus? status = Enum.TryParse<GradeStatus>(StatusFilter, out var s) ? s : null;
        rows = await GradingDb.RunAsync(Scopes, Tenant, g => g.QueueAsync(status, showUnstarted, needsInstructorReview));
        denied = rows is null;
        currentPage = Math.Clamp(currentPage, 1, TotalPages);
    }

    private async Task StartAsync(Guid sessionId)
    {
        if (busy) return;
        busy = true;
        try
        {
            var r = await GradingDb.RunAsync(Scopes, Tenant, g => g.StartAiGradingAsync(sessionId));
            ok = r.Ok;
            message = r.Message;
            await LoadAsync();
        }
        finally { busy = false; }
    }
}

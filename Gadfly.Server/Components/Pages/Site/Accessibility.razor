   docs/ACCESSIBILITY.md, and update it again when that testing happens or a further pass lands. *@
@page "/accessibility"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@inherits SitePage

<SiteMeta Title="@T["site.access.metaTitle"]" Path="/accessibility" Description="@T["site.access.metaDescription"]" />

<header class="page-head">
    <div class="wrap">
        <h1>@T["site.access.title"]</h1>
        <p>@T["site.access.lede"]</p>
    </div>
</header>

<div class="wrap prose">
    <p class="updated">@T["site.access.updated"]</p>

    <h2 id="aim">@T["site.access.aim.title"]</h2>
    <p>@T["site.access.aim.body"]</p>

    <h2 id="status">@T["site.access.status.title"]</h2>
    <p>@T["site.access.status.intro"]</p>
    <ul>
        @foreach (var key in Checked)
        {
            <li><strong>@T[$"site.access.status.{key}.title"]</strong> @T[$"site.access.status.{key}.body"]</li>
        }
    </ul>
    <p>@H("site.access.status.notDone")</p>

    <h2 id="support">@T["site.access.support.title"]</h2>
    <ul>
        @foreach (var key in Support)
        {
            <li><strong>@T[$"site.access.support.{key}.title"]</strong> @T[$"site.access.support.{key}.body"]</li>
        }
    </ul>

    <h2 id="limits">@T["site.access.limits.title"]</h2>
    <ul>
        @foreach (var key in Limits)
        {
            <li><strong>@T[$"site.access.limits.{key}.title"]</strong> @T[$"site.access.limits.{key}.body"]</li>
        }
    </ul>

    <h2 id="report">@T["site.access.report.title"]</h2>
    <p>@H("site.access.report.body")</p>
</div>

@code {
    private static readonly string[] Checked = ["keyboard", "examRoom", "contrast", "motion", "layouts", "axe", "states", "language", "examiner"];
    private static readonly string[] Support = ["captions", "transcript", "rephrase", "pause", "motion", "speech", "secondLanguage", "gaze", "selfView", "clock", "accommodations"];
    private static readonly string[] Limits = ["spoken", "recognition", "staff", "avatar", "korean", "noAt"];
}

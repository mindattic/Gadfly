@page "/about"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@inherits SitePage
@* The public landing page (GAD-T308), at /about since "/" opens on the sign-in page (GAD-T843). Every claim here comes from
   README.md, docs/SCIENCE.md, docs/PRIVACY.md, docs/VOICE.md, docs/LOCALIZATION.md or docs/research/attention-and-gaze.md;
   keep it that way when editing. Text in Localization/Strings/site.<lang>.json (GAD-T592). *@

<SiteMeta Title="@T["site.landing.metaTitle"]" Path="/about" Description="@T["site.landing.metaDescription"]" />

<section class="hero" aria-labelledby="hero-heading">
    <div class="wrap">
        <div>
            <h1 id="hero-heading">@T["site.landing.hero.title"]</h1>
            <p class="lede">@T["site.landing.hero.lede"]</p>
            <div class="actions">
                <a class="btn" href="contact">@T["site.nav.demo"]</a>
                <a href="how-it-works">@T["site.landing.hero.how"]</a>
            </div>
        </div>
        <figure class="plate" aria-labelledby="plate-caption">
            <div class="plate-examiner">
                <div class="live-examiner" role="img" aria-label="@T["site.landing.plate.alt"]"><ExaminerPresence /></div>
            </div>
            <div class="exchange">
                <p class="turn examiner"><span class="who">@T["site.landing.plate.examiner"]</span>@T["site.landing.plate.q1"]</p>
                <p class="turn student"><span class="who">@T["site.landing.plate.student"]</span>@H("site.landing.plate.a1")</p>
                <p class="turn examiner"><span class="who">@T["site.landing.plate.examiner"]</span>@H("site.landing.plate.q2")</p>
                <p class="turn student"><span class="who">@T["site.landing.plate.student"]</span>@T["site.landing.plate.a2"]</p>
                <p class="turn examiner"><span class="who">@T["site.landing.plate.examiner"]</span>@T["site.landing.plate.q3"]</p>
            </div>
            <figcaption id="plate-caption">@T["site.landing.plate.caption"]</figcaption>
        </figure>
    </div>
</section>

<section class="band" aria-labelledby="why-heading">
    <div class="wrap split">
        <div>
            <h2 id="why-heading">@T["site.landing.why.title"]</h2>
            <p>@T["site.landing.why.intro"]</p>
        </div>
        <div>
            <p>@T["site.landing.why.p1"]</p>
            <p>@T["site.landing.why.p2"]</p>
            <p>@T["site.landing.why.p3"]</p>
        </div>
    </div>
</section>

<section class="band" aria-labelledby="feel-heading">
    <div class="wrap split">
        <div>
            <h2 id="feel-heading">@T["site.landing.feel.title"]</h2>
            <p>@T["site.landing.feel.intro"]</p>
        </div>
        <div class="sheet">
            <ul>
                <li><strong>@T["site.landing.feel.talk.title"]</strong>
                    <span>@T["site.landing.feel.talk.body"]</span></li>
                <li><strong>@T["site.landing.feel.languages.title"]</strong>
                    <span>@T["site.landing.feel.languages.body"]</span></li>
                <li><strong>@T["site.landing.feel.esl.title"]</strong>
                    <span>@T["site.landing.feel.esl.body"]</span></li>
                <li><strong>@T["site.landing.feel.ready.title"]</strong>
                    <span>@T["site.landing.feel.ready.body"]</span></li>
                <li><strong>@T["site.landing.feel.gaze.title"]</strong>
                    <span>@T["site.landing.feel.gaze.body"]</span></li>
                <li><strong>@T["site.landing.feel.access.title"]</strong>
                    <span>@H("site.landing.feel.access.body")</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="band" aria-labelledby="path-heading">
    <div class="wrap">
        <h2 id="path-heading">@T["site.landing.path.title"]</h2>
        <p>@T["site.landing.path.intro"]</p>
        <ol class="steps">
            <li><h3>@T["site.landing.path.s1.title"]</h3>
                <p>@T["site.landing.path.s1.body"]</p></li>
            <li><h3>@T["site.landing.path.s2.title"]</h3>
                <p>@T["site.landing.path.s2.body"]</p></li>
            <li><h3>@T["site.landing.path.s3.title"]</h3>
                <p>@T["site.landing.path.s3.body"]</p></li>
            <li><h3>@T["site.landing.path.s4.title"]</h3>
                <p>@T["site.landing.path.s4.body"]</p></li>
            <li><h3>@T["site.landing.path.s5.title"]</h3>
                <p>@T["site.landing.path.s5.body"]</p></li>
        </ol>
    </div>
</section>

<section class="band" aria-labelledby="wont-heading">
    <div class="wrap split">
        <div>
            <h2 id="wont-heading">@T["site.landing.wont.title"]</h2>
            <p>@T["site.landing.wont.intro"]</p>
        </div>
        <div class="sheet">
            <ul>
                <li><strong>@T["site.landing.wont.cheat.title"]</strong>
                    <span>@T["site.landing.wont.cheat.body"]</span></li>
                <li><strong>@T["site.landing.wont.cancel.title"]</strong>
                    <span>@T["site.landing.wont.cancel.body"]</span></li>
                <li><strong>@T["site.landing.wont.video.title"]</strong>
                    <span>@T["site.landing.wont.video.body"]</span></li>
                <li><strong>@T["site.landing.wont.accent.title"]</strong>
                    <span>@T["site.landing.wont.accent.body"]</span></li>
                <li><strong>@T["site.landing.wont.guess.title"]</strong>
                    <span>@T["site.landing.wont.guess.body"]</span></li>
                <li><strong>@T["site.landing.wont.detector.title"]</strong>
                    <span>@T["site.landing.wont.detector.body"]</span></li>
                <li><strong>@T["site.landing.wont.claim.title"]</strong>
                    <span>@T["site.landing.wont.claim.body"]</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="band" aria-labelledby="science-heading">
    <div class="wrap split">
        <div>
            <h2 id="science-heading">@T["site.landing.science.title"]</h2>
            <p>@T["site.landing.science.body"]</p>
            <p><a href="science">@T["site.landing.science.link"]</a></p>
        </div>
        <div class="sheet">
            <ul>
                <li><strong>@T["site.landing.science.explain.title"]</strong>
                    <span>@T["site.landing.science.explain.body"]</span></li>
                <li><strong>@T["site.landing.science.followUp.title"]</strong>
                    <span>@T["site.landing.science.followUp.body"]</span></li>
                <li><strong>@T["site.landing.science.coherence.title"]</strong>
                    <span>@T["site.landing.science.coherence.body"]</span></li>
            </ul>
            <p class="science-refs">@T["site.landing.science.refs"]</p>
        </div>
    </div>
</section>

<section class="band closing" aria-labelledby="closing-heading">
    <div class="wrap">
        <div>
            <h2 id="closing-heading">@T["site.landing.closing.title"]</h2>
            <p>@T["site.landing.closing.body"]</p>
            <div class="actions">
                <a class="btn" href="contact">@T["site.nav.demo"]</a>
                <a href="pricing">@T["site.landing.closing.plans"]</a>
            </div>
        </div>
        <img class="fly" src="assets/site/logo.png" alt="" width="136" height="136" loading="lazy" />
    </div>
</section>

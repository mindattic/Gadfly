@* The home page's layout (GAD-T308): a signed-out visitor at "/" gets the public site, a signed-in user the app shell
   and their dashboard, at the same address. *@
@inherits LayoutComponentBase

<LayoutView Layout="@Chosen">@Body</LayoutView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Type Chosen { get; set; } = typeof(PublicLayout);

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        Chosen = user?.Identity?.IsAuthenticated == true ? typeof(MainLayout) : typeof(PublicLayout);
    }
}

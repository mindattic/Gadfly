@* DRAFT: have counsel review before relying on this. Written for GAD-T308 from docs/SECURITY_REVIEW.md, README.md and
   docs/PRIVACY.md. It describes controls that exist in the code today and names the review as internal; do not add
   certifications or audits here until they have happened. Text in Localization/Strings/site.<lang>.json (GAD-T592). *@
@page "/security"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@inherits SitePage

<SiteMeta Title="@T["site.security.metaTitle"]" Path="/security" Description="@T["site.security.metaDescription"]" />

<header class="page-head">
    <div class="wrap">
        <h1>@T["site.security.title"]</h1>
        <p>@T["site.security.lede"]</p>
    </div>
</header>

<div class="wrap prose">
    <p class="updated">@T["site.security.updated"]</p>

    @foreach (var (id, items) in Sections)
    {
        <h2 id="@id">@T[$"site.security.{id}.title"]</h2>
        <ul>
            @foreach (var item in items)
            {
                <li>@H($"site.security.{id}.{item}")</li>
            }
        </ul>
    }

    <h2 id="ai">@T["site.security.ai.title"]</h2>
    <p>@T["site.security.ai.injection"]</p>
    <p>@T["site.security.ai.leak"]</p>

    <h2 id="review">@T["site.security.review.title"]</h2>
    <p>@T["site.security.review.body"]</p>

    <h2 id="report">@T["site.security.report.title"]</h2>
    <p>@H("site.security.report.body")</p>
</div>

@code {
    private static readonly (string Id, string[] Items)[] Sections =
    [
        ("isolation", ["filtered", "signIn", "courses"]),
        ("accounts", ["passwords", "mfa", "removal", "invites"]),
        ("records", ["original", "audit", "preliminary"]),
        ("data", ["azure", "secrets", "video", "language", "selfHosted", "logs", "retention"]),
        ("integrations", ["keys", "webhooks", "lti", "rateLimits", "uploads"]),
    ];
}

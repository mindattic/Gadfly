@page "/{*path:nonfile}"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@* The branded 404 (GAD-T308): a catch-all with the lowest route priority, so every real page and endpoint wins. It must
   never match a path with a file extension (the "nonfile" constraint): routing picks an endpoint before UseStaticFiles
   runs, and static files are only served when no endpoint matched. Static and data-free, for signed-in and signed-out
   visitors alike. It answers 404 through NavigationManager.NotFound(), and Routes.razor renders this same page as the
   Router's NotFoundPage (then with no path, so it does not call NotFound again). *@

<SiteMeta Title="Page not found" Path="/" NoIndex="true" Description="This address doesn't match a page on Gadfly Exams." />

<section class="lost" aria-labelledby="lost-heading">
    <div class="wrap">
        <img class="fly" src="assets/site/logo.png" alt="" width="192" height="192" />
        <div>
            <h1 id="lost-heading">There's no page at this address</h1>
            <p class="lede">The link may be mistyped, or the page may have moved.</p>
            <ul>
                <li>Students: your exams are under <a href="my-exams">My exams</a> once you sign in.</li>
                <li>Staff: start from <a href="/">your dashboard</a>.</li>
                <li>New to Gadfly: read <a href="how-it-works">how it works</a> or <a href="contact">request a demo</a>.</li>
            </ul>
        </div>
    </div>
</section>

@code {
    [Parameter] public string? Path { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = default!;

    protected override void OnInitialized()
    {
        if (Path is not null) Nav.NotFound();
    }
}

@page "/how-it-works"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@inherits SitePage
@* Product walkthrough (GAD-T308). Sources: README.md (Features), docs/VOICE.md, docs/PRIVACY.md, docs/LOCALIZATION.md and
   docs/research/attention-and-gaze.md. Text in Localization/Strings/site.<lang>.json (GAD-T592). *@

<SiteMeta Title="@T["site.how.metaTitle"]" Path="/how-it-works" Description="@T["site.how.metaDescription"]" />

<header class="page-head">
    <div class="wrap">
        <h1>@T["site.how.title"]</h1>
        <p>@T["site.how.lede"]</p>
    </div>
</header>

<div class="wrap prose">
    <div class="phases">
        <section class="phase" aria-labelledby="before">
            <h2 id="before">@T["site.how.before.title"]</h2>
            <ul>
                @foreach (var key in Before)
                {
                    <li><strong>@T[$"site.how.before.{key}.title"]</strong> @T[$"site.how.before.{key}.body"]</li>
                }
            </ul>
        </section>
        <section class="phase" aria-labelledby="during">
            <h2 id="during">@T["site.how.during.title"]</h2>
            <ul>
                @foreach (var key in During)
                {
                    <li><strong>@T[$"site.how.during.{key}.title"]</strong> @T[$"site.how.during.{key}.body"]</li>
                }
            </ul>
        </section>
        <section class="phase" aria-labelledby="after">
            <h2 id="after">@T["site.how.after.title"]</h2>
            <ul>
                @foreach (var key in After)
                {
                    <li><strong>@T[$"site.how.after.{key}.title"]</strong> @T[$"site.how.after.{key}.body"]</li>
                }
            </ul>
        </section>
    </div>

    <h2 id="languages">@T["site.how.languages.title"]</h2>
    <p>@T["site.how.languages.p1"]</p>
    <p>@T["site.how.languages.p2"]</p>

    <h2 id="evidence">@T["site.how.record.title"]</h2>
    <p>@T["site.how.record.body"]</p>

    <h2 id="roles">@T["site.how.roles.title"]</h2>
    <div class="table-scroll">
        <table>
            <thead><tr><th scope="col">@T["site.how.roles.role"]</th><th scope="col">@T["site.how.roles.what"]</th></tr></thead>
            <tbody>
                @foreach (var key in Roles)
                {
                    <tr><th scope="row">@T[$"site.how.roles.{key}.name"]</th><td>@T[$"site.how.roles.{key}.does"]</td></tr>
                }
            </tbody>
        </table>
    </div>

    <h2 id="it">@T["site.how.it.title"]</h2>
    <ul>
        <li>@T["site.how.it.tenant"]</li>
        <li>@T["site.how.it.signIn"]</li>
        <li>@T["site.how.it.api"]</li>
        <li>@H("site.how.it.retention")</li>
    </ul>

    <div class="actions">
        <a class="btn" href="contact">@T["site.nav.demo"]</a>
        <a href="science">@T["site.how.whyLink"]</a>
    </div>
</div>

@code {
    private static readonly string[] Before = ["upload", "concepts", "rubrics", "policy", "languages", "assign"];
    private static readonly string[] During = ["ready", "consent", "examiner", "answer", "pace", "followUps", "rephrase", "gaze", "window", "clock"];
    private static readonly string[] After = ["ai", "blind", "reconcile", "approve", "original", "fairness", "reports"];
    private static readonly string[] Roles = ["owner", "instructor", "examiner", "reviewer", "student"];
}

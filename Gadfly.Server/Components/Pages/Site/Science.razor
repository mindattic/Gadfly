@page "/science"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@inherits SitePage
@* The science page (GAD-T308), condensed from docs/SCIENCE.md (and docs/PRIVACY.md for the current voice-measurement
   rules), with the attention and second-language rows from docs/research/attention-and-gaze.md and
   docs/research/esl-and-korean.md (GAD-T592). Keep every claim and citation within what those documents support; the full
   verification levels are there. Text in Localization/Strings/site.<lang>.json; the references stay as published. *@

<SiteMeta Title="@T["site.science.metaTitle"]" Path="/science" Description="@T["site.science.metaDescription"]" />

<header class="page-head">
    <div class="wrap">
        <h1>@T["site.science.title"]</h1>
        <p>@T["site.science.lede"]</p>
    </div>
</header>

<div class="wrap prose">
    <h2 id="elenchus">@T["site.science.elenchus.title"]</h2>
    <p>@H("site.science.elenchus.body")</p>
    <ul>
        <li>@H("site.science.elenchus.own")</li>
        <li>@H("site.science.elenchus.coherence")</li>
    </ul>

    <h2 id="why">@T["site.science.why.title"]</h2>
    <p>@H("site.science.why.borrowed")</p>
    <p>@H("site.science.why.piaget")</p>
    <p>@H("site.science.why.suggestion")</p>
    <p>@H("site.science.why.learn")</p>

    <h2 id="limits">@T["site.science.limits.title"]</h2>
    <div class="table-scroll">
        <table>
            <thead><tr><th scope="col">@T["site.science.limits.found"]</th><th scope="col">@T["site.science.limits.does"]</th></tr></thead>
            <tbody>
                @foreach (var key in Limits)
                {
                    <tr><td>@T[$"site.science.limits.{key}.found"]</td><td>@T[$"site.science.limits.{key}.does"]</td></tr>
                }
            </tbody>
        </table>
    </div>

    <h2 id="conversation">@T["site.science.conversation.title"]</h2>
    <p>@T["site.science.conversation.p1"]</p>
    <p>@T["site.science.conversation.p2"]</p>

    <h2 id="not-shown">@T["site.science.notShown.title"]</h2>
    <ul>
        <li>@T["site.science.notShown.validity"]</li>
        <li>@T["site.science.notShown.cheating"]</li>
        <li>@T["site.science.notShown.grading"]</li>
        <li>@T["site.science.notShown.signals"]</li>
        <li>@T["site.science.notShown.attention"]</li>
    </ul>

    <h2 id="references">@T["site.science.references"]</h2>
    <ul class="refs" lang="@EnglishOnly">
        <li>Benson, H. H. (1995). The dissolution of the problem of the elenchus. <em>Oxford Studies in Ancient Philosophy, 13</em>, 45-112.</li>
        <li>Bisra, K., Liu, Q., Nesbit, J. C., Salimi, F., &amp; Winne, P. H. (2018). Inducing self-explanation: A meta-analysis. <em>Educational Psychology Review, 30</em>(3), 703-725.</li>
        <li>CNIL. (2023). <em lang="fr">Délibération n° 2023-058 du 8 juin 2023 portant adoption d'une recommandation relative aux dispositifs de surveillance à distance des examens</em>.</li>
        <li>Chi, M. T. H., de Leeuw, N., Chiu, M.-H., &amp; LaVancher, C. (1994). Eliciting self-explanations improves understanding. <em>Cognitive Science, 18</em>(3), 439-477.</li>
        <li>Doherty-Sneddon, G., &amp; Phelps, F. G. (2005). Gaze aversion: A response to cognitive or social difficulty? <em>Memory &amp; Cognition, 33</em>(4), 727-733.</li>
        <li>Doherty-Sneddon, G., Riby, D. M., &amp; Whittle, L. (2012). Gaze aversion as a cognitive load management strategy in autism spectrum disorder and Williams syndrome. <em>Journal of Child Psychology and Psychiatry, 53</em>(4), 420-430.</li>
        <li>Fox, M. C., Ericsson, K. A., &amp; Best, R. (2011). Do procedures for verbal reporting of thinking have to be reactive? <em>Psychological Bulletin, 137</em>(2), 316-344.</li>
        <li>Glenberg, A. M., Schroeder, J. L., &amp; Robertson, D. A. (1998). Averting the gaze disengages the environment and facilitates remembering. <em>Memory &amp; Cognition, 26</em>(4), 651-658.</li>
        <li>Harnsberger, J. D., Hollien, H., Martin, C. A., &amp; Hollien, K. A. (2009). Stress and deception in speech: Evaluating layered voice analysis. <em>Journal of Forensic Sciences, 54</em>(3), 642-650.</li>
        <li>Kahng, J. (2014). Exploring utterance and cognitive fluency of L1 and L2 English speakers: Temporal measures and stimulated recall. <em>Language Learning, 64</em>(4), 809-854.</li>
        <li>Koenecke, A., et al. (2020). Racial disparities in automated speech recognition. <em>PNAS, 117</em>(14), 7684-7689.</li>
        <li>Liang, W., Yuksekgonul, M., Mao, Y., Wu, E., &amp; Zou, J. (2023). GPT detectors are biased against non-native English writers. <em>Patterns, 4</em>(7).</li>
        <li>Lima, L. M., Favarato, M. H., &amp; Tibério, I. F. L. C. (2026). Empowering medical students: Peer-led OSCE reduces anxiety. <em>PLoS ONE, 21</em>(2), e0340407.</li>
        <li>Maslych, M., et al. (2025). Mitigating response delays in free-form conversations with LLM-powered intelligent virtual agents. <em>CUI '25</em>.</li>
        <li>Mujtaba, D., et al. (2024). Lost in transcription: Accuracy biases of automatic speech recognition against disfluent speech. <em>NAACL 2024</em>, 4795-4809.</li>
        <li>National Research Council. (2003). <em>The polygraph and lie detection</em>. The National Academies Press.</li>
        <li>Papoutsaki, A., et al. (2016). WebGazer: Scalable webcam eye tracking using user interactions. <em>Proceedings of IJCAI-16</em>, 3839-3845.</li>
        <li>Piaget, J. (1929). <em>The child's conception of the world</em> (J. Tomlinson &amp; A. Tomlinson, Trans.). Kegan Paul, Trench, Trubner. (Original work published 1926 as <em lang="fr">La représentation du monde chez l'enfant</em>.)</li>
        <li>Plato. <em>Apology</em> (H. N. Fowler, Trans.). In <em>Plato in twelve volumes</em>, Vol. 1 (Loeb Classical Library). Harvard University Press. (Translation first published 1914; cited from the 1966 printing.)</li>
        <li>Rayner, K. (2009). Eye movements in reading: Models and data. <em>Journal of Eye Movement Research, 2</em>(5).</li>
        <li>Regulation (EU) 2024/1689 (Artificial Intelligence Act). <em>Official Journal of the European Union</em>, 12 July 2024.</li>
        <li>Rogers, S. L., Speelman, C. P., Guidetti, O., &amp; Longmuir, M. (2018). Using dual eye tracking to uncover personal gaze patterns during social interaction. <em>Scientific Reports, 8</em>, 4271.</li>
        <li>Rowland, C. A. (2014). The effect of testing versus restudy on retention. <em>Psychological Bulletin, 140</em>(6), 1432-1463.</li>
        <li>Tien, I. S., Imundo, M. N., &amp; Bjork, E. L. (2023). Viewing oneself during synchronous online learning increases appearance anxiety and decreases memory for lecture content. <em>Applied Cognitive Psychology, 37</em>, 443-451.</li>
        <li>van der Vleuten, C. P. M., et al. (2010). The assessment of professional competence: Building blocks for theory development. <em>Best Practice &amp; Research Clinical Obstetrics and Gynaecology, 24</em>(6), 703-719.</li>
        <li>Vlastos, G. (1983). The Socratic elenchus. <em>Oxford Studies in Ancient Philosophy, 1</em>, 27-58.</li>
        <li>Wass, V., Wakeford, R., Neighbour, R., &amp; Van der Vleuten, C. (2003). Achieving acceptable reliability in oral examinations. <em>Medical Education, 37</em>(2), 126-131.</li>
        <li>Weber-Wulff, D., et al. (2023). Testing of detection tools for AI-generated text. <em>International Journal for Educational Integrity, 19</em>, 26.</li>
        <li>Wolfsdorf, D. (2013). Socratic philosophizing. In J. Bussanich &amp; N. D. Smith (Eds.), <em>The Bloomsbury companion to Socrates</em>. Bloomsbury.</li>
        <li>Zheng, L., et al. (2023). Judging LLM-as-a-judge with MT-Bench and Chatbot Arena. <em>NeurIPS 36</em>.</li>
    </ul>
</div>

@code {
    private static readonly string[] Limits =
        ["contradiction", "explaining", "sampling", "aiBias", "recognition", "secondLanguage", "gazeThinking", "gazeCoarse", "selfView", "automated", "waiting", "rehearsal", "voiceStress", "detectors"];
}

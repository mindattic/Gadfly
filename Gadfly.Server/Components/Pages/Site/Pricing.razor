@page "/pricing"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout PublicLayout
@inherits SitePage
@using Gadfly.Server.Site
@* Plans and pricing (GAD-T308). The plan data lives in Site/SitePlans.cs so plan enforcement (GAD-T309) can match it; the
   words shown come from Localization/Strings/site.<lang>.json by plan name (site.pricing.plan.<Name>.*, GAD-T592), so change
   both when a plan changes. *@

<SiteMeta Title="@T["site.pricing.metaTitle"]" Path="/pricing" Description="@T["site.pricing.metaDescription"]" />

<header class="page-head">
    <div class="wrap">
        <h1>@T["site.pricing.title"]</h1>
        <p>@T["site.pricing.lede"]</p>
    </div>
</header>

<div class="wrap prose">
    <div class="plans">
        @foreach (var plan in SitePlans.All)
        {
            var k = $"site.pricing.plan.{plan.Name}";
            <section class="plan @(plan.Name == SitePlans.Featured ? "featured" : null)" aria-labelledby="plan-@plan.Name">
                <h2 id="plan-@plan.Name">@T[$"{k}.name"]</h2>
                <p class="for">@T[$"{k}.for"]</p>
                <dl>
                    <dt>@T["site.pricing.staffSeats"]</dt><dd>@T[$"{k}.staff"]</dd>
                    <dt>@T["site.pricing.studentSeats"]</dt><dd>@T[$"{k}.students"]</dd>
                    <dt>@T["site.pricing.exams"]</dt><dd>@T[$"{k}.exams"]</dd>
                </dl>
                <ul>
                    @for (var i = 0; i < plan.Extras.Count; i++)
                    {
                        <li>@T[$"{k}.extra{i}"]</li>
                    }
                </ul>
                <p class="price">@T["site.pricing.contactForPrice"]</p>
                <a class="btn @(plan.Name == SitePlans.Featured ? null : "quiet")" href="contact?plan=@plan.Name">@T[$"{k}.ask"]</a>
            </section>
        }
    </div>

    <h2 id="included">@T["site.pricing.included.title"]</h2>
    <ul class="included">
        @foreach (var key in Included)
        {
            <li>@T[$"site.pricing.included.{key}"]</li>
        }
    </ul>

    <h2 id="questions">@T["site.pricing.faq.title"]</h2>
    <dl class="faq">
        @foreach (var key in Faq)
        {
            <dt>@T[$"site.pricing.faq.{key}.q"]</dt>
            <dd>@T[$"site.pricing.faq.{key}.a"]</dd>
        }
    </dl>

    <div class="actions">
        <a class="btn" href="contact">@T["site.nav.demo"]</a>
        <a href="security">@T["site.pricing.securityLink"]</a>
    </div>
</div>

@code {
    private static readonly string[] Included =
        ["spoken", "languages", "followUps", "readiness", "materials", "panel", "human", "appeals", "reports", "fairness", "mfa", "retention", "api", "usage", "video"];
    private static readonly string[] Faq = ["prices", "exam", "seat", "trial", "install", "languages", "secondLanguage", "lookAway", "access"];
}

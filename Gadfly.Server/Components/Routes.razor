@* NotFoundPage: the branded 404 (GAD-T308), rendered when a page calls NavigationManager.NotFound(). *@
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Gadfly.Server.Components.Pages.Site.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <p class="notice">You don't have access to this page in the current organization.</p>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

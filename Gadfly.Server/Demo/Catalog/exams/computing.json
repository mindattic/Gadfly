        "objectives": { "os-role": "운영 체제와 커널의 역할 설명하기", "processes-threads": "프로세스와 스레드를 구별하고 경쟁 상태 설명하기", "scheduling": "스케줄링이 여러 프로그램을 동시에 실행하는 것처럼 보이게 하는 방식 설명하기", "virtual-memory": "가상 메모리 설명하기" } },

        "objectives": { "stored-program": "프로그램 내장 방식 설명하기", "fetch-decode-execute": "인출-해독-실행 주기 설명하기", "compile-interpret": "컴파일러와 인터프리터 구별하기", "memory-hierarchy": "메모리 계층 구조와 캐시가 효과적인 이유 설명하기" } },
      "es": { "title": "Cómo ejecuta una computadora un programa",
        "instructions": "El examinador le pedirá que explique qué ocurre dentro de una computadora cuando ejecuta un programa. Explique cómo trabajan juntas sus partes y por qué, y diga \"No lo sé\" si no lo sabe.",
        "objectives": { "stored-program": "Describir el diseño de programa almacenado", "fetch-decode-execute": "Explicar el ciclo de búsqueda, decodificación y ejecución", "compile-interpret": "Distinguir los compiladores de los intérpretes", "memory-hierarchy": "Explicar la jerarquía de memoria y por qué funcionan las cachés" } }

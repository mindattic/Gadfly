        "facts": ["The base case is answered without another recursive call.", "The recursive case works on a smaller instance of the problem.", "Each call must move closer to the base case or the recursion never ends."],
        "misconceptions": ["A recursive function can work without a base case.", "Recursion means a function repeats the same input forever."] },
      { "key": "call-stack", "title": "Describe how the call stack handles recursion", "description": "Explains that pending calls are stacked and return in reverse order, and what a stack overflow is.",
        "concept": "The call stack", "definition": "Each unfinished call keeps its own frame on the call stack until it returns.",
        "facts": ["Each call has its own parameters and local variables.", "Calls return in the reverse order they were made.", "Recursion that never reaches a base case causes a stack overflow."],
        "misconceptions": ["All recursive calls share one copy of the local variables."] },
      { "key": "divide-and-conquer", "title": "Explain divide and conquer using merge sort", "description": "Describes splitting, solving recursively and combining, and why merge sort is O(n log n).",
        "concept": "Divide and conquer", "definition": "Split a problem into smaller subproblems, solve them recursively, and combine their results.",
        "facts": ["Merge sort splits the list in half and sorts each half recursively.", "Two sorted halves are merged into one sorted list.", "There are about log n levels of splitting with O(n) merging work per level."],
        "misconceptions": ["Merge sort is O(n²) because it compares items many times."] },
      { "key": "memoization", "title": "Explain when recursion is wasteful and how memoization helps", "description": "Uses naive Fibonacci to show repeated subproblems and how storing results fixes them.",
        "concept": "Memoization", "definition": "Storing the result of each subproblem so repeated calls look it up instead of recomputing it.",
        "facts": ["Naive recursive Fibonacci recomputes the same values many times.", "Naive recursive Fibonacci takes exponential time.", "Memoization reduces Fibonacci to linear time.", "Any recursion can be rewritten with loops and an explicit stack."],
        "misconceptions": ["Recursion is always faster than a loop.", "Some problems can only be solved with recursion."] }

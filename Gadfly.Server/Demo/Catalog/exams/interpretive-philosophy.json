        "objectives": { "eudaimonia": "행복은 번영과 같은가?", "doctrine-of-mean": "덕은 정말 중용인가?", "habituation": "성품은 훈련될 수 있는가?", "guidance-objection": "덕 윤리는 무엇을 할지 알려 주는가?" } },
      "es": { "title": "La ética de la virtud de Aristóteles",
        "objectives": { "eudaimonia": "¿Es la felicidad lo mismo que el florecimiento?", "doctrine-of-mean": "¿Es la virtud realmente un término medio?", "habituation": "¿Se puede entrenar el carácter?", "guidance-objection": "¿Nos dice la ética de la virtud qué hacer?" } }

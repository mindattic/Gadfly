      "es": { "title": "Orgullo y prejuicio: matrimonio, juicio e ironía",
        "objectives": { "first-impressions": "Explicar el error de juicio de Elizabeth", "pride-prejudice": "Decidir quién es orgulloso y quién prejuicioso", "charlotte": "Juzgar el matrimonio de Charlotte Lucas", "irony-and-society": "Evaluar si la novela cuestiona su sociedad" } }

      { "key": "ph-scale", "title": "Interpret the pH scale", "description": "Explains pH as a logarithmic measure and compares solutions.",
        "concept": "pH", "definition": "pH is the negative logarithm of the hydrogen ion concentration; each unit is a tenfold change.",
        "facts": ["pH equals the negative log of the hydrogen ion concentration.", "At 25 °C, pH 7 is neutral, below is acidic and above is basic.", "One pH unit is a tenfold change in hydrogen ion concentration."],
        "misconceptions": ["pH 4 is twice as acidic as pH 8.", "A higher pH means more hydrogen ions."] },

        "objectives": { "rebellion-or-career": "인상주의자들이 얼마나 반항적이었는지 판단하기", "technique-meaning": "기법을 하나의 주장으로 해석하기", "modern-life": "근대 생활을 찬미했는지 비판했는지 판단하기", "market-independence": "독립성과 미술 시장 평가하기" } },
